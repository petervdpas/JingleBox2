<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JingleBox2.Converters"
             x:Class="JingleBox2.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Border.card">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Surface}" />
            </Setter>
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Border}" />
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <conv:NullToUnsetConverter x:Key="NullToUnset" />
        <conv:IsSelectedColorConverter x:Key="IsSelectedColor" />
        <conv:SelectedSwatchSizeConverter x:Key="SelectedSwatchSize" />
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
        <conv:ModeToColorConverter x:Key="ModeToColorConverter" />
    </Application.Resources>

</Application>