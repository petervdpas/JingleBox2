<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JingleBox2.Converters"
             x:Class="JingleBox2.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <conv:NullToUnsetConverter x:Key="NullToUnset" />
        <conv:IsSelectedColorConverter x:Key="IsSelectedColor" />
        <conv:SelectedSwatchSizeConverter x:Key="SelectedSwatchSize" />
    </Application.Resources>

</Application>