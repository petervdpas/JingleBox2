<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:JingleBox2.Converters"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Machines.Ui;assembly=JingleBox2.Machines.Ui"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Styles>
        <FluentTheme />
        <!-- The brushes are named rather than built here out of a colour. A brush written inside
             a setter is one object shared by every card, and the colour it is built from is
             looked up once against the application, so a card standing on a machine's own panel
             never sees the machine's shades: on a dark theme the two happen to look alike, and
             on a light one the card stays white behind a machine that is teal. Naming the brush
             instead leaves the lookup to each card, where anything painting one in its own
             colours has put the answer. -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- A block inside a card: the page background shows through, so it reads as set into
             the card rather than stacked on it. Works either way round, since the background is
             darker than the surface in the dark themes and greyer than it in the light one. -->
        <Style Selector="Border.inset">
            <Setter Property="Background" Value="{DynamicResource BgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- One set of tab metrics, so every tab breathes the same. -->
        <!-- Top and foot only. Left and right are the window's, so every page lines up with
             the tab names above it and the status bar below it. -->
        <Style Selector="StackPanel.tabRoot">
            <Setter Property="Margin" Value="0,12" />
            <Setter Property="Spacing" Value="12" />
        </Style>
        <!-- A list whose rows are things rather than lines of text: a take, a song, anything
             you pick one of. Every row keeps its own frame whether or not the pointer is over
             it, because a list that draws a box only under the pointer reads as a page of text
             until you touch it. -->
        <Style Selector="ListBox.cards">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.cards > ListBoxItem">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,4" />
        </Style>

        <Style Selector="Border.card.stacked">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="StackPanel.cardBody">
            <Setter Property="Spacing" Value="8" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style Selector="TextBlock.cardHint">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Border.cliplight">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.BorderMuted}" />
            </Setter>
        </Style>
        <Style Selector="Border.cliplight.clipping">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Danger}" />
            </Setter>
        </Style>
        <Style Selector="TextBlock.cliptext">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="TextBlock.cliptext.clipping">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Danger}" />
            </Setter>
        </Style>
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Danger}" />
            </Setter>
        </Style>
        <!-- The stepper buttons inside a NumberField: as small as a glyph allows. -->
        <Style Selector="RepeatButton.stepper">
            <Setter Property="FontSize" Value="6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <!-- A small corner tag, for marking a list item with where something is assigned. -->
        <Style Selector="Border.badge">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.22" />
            </Setter>
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.55" />
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Border.badge > TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.TextPrimary}" />
            </Setter>
        </Style>

        <!-- The same chip said more quietly, for something every row has. A category in the
             accent colour beside a usage badge in the accent colour is two alarms and no
             information. -->
        <Style Selector="Border.badge.filed">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" Opacity="0.14" />
            </Setter>
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" Opacity="0.4" />
            </Setter>
        </Style>
        <Style Selector="Border.badge.filed > TextBlock">
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" />
            </Setter>
        </Style>

        <!-- Compact value fields: no spinner buttons, so the field is only as wide as the
             number it holds. Scroll or arrow to change it. -->

        <!-- Transport glyphs need size and weight of their own: at the default button
             metrics they render as small, low-contrast marks. -->
        <!-- The edge between two panels: a hairline to look at, eight pixels wide to grab.
             The transparent surround is what the pointer catches, so the line itself can stay
             as thin as it reads best. -->
        <Style Selector="GridSplitter.handle">
            <Setter Property="Cursor" Value="SizeWestEast" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center"
                                   VerticalAlignment="Stretch">
                            <Rectangle.Fill>
                                <SolidColorBrush Color="{DynamicResource Color.Border}" Opacity="0.75" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- The same handle laid on its side, for a split between rows. The line has to run
             the other way or a horizontal handle draws a vertical hairline.

             And a grip in the middle of it, which the upright one does not need. A handle
             between two columns lies in the gap between two cards, where the eye is already
             expecting an edge; one between two rows lies against the bottom of a card, where a
             hairline is exactly what a card's own edge looks like and reads as the end of the
             thing above rather than as something to take hold of. -->
        <Style Selector="GridSplitter.handle.rows">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Panel>
                            <Rectangle x:Name="Line" Height="1" VerticalAlignment="Center"
                                       HorizontalAlignment="Stretch">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{DynamicResource Color.Border}" Opacity="0.75" />
                                </Rectangle.Fill>
                            </Rectangle>

                            <Border x:Name="Grip" Width="46" Height="4" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Background>
                                    <SolidColorBrush Color="{DynamicResource Color.TextMuted}" Opacity="0.55" />
                                </Border.Background>
                            </Border>
                        </Panel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.handle.rows:pointerover /template/ Rectangle#Line">
            <Setter Property="Height" Value="2" />
            <Setter Property="Fill">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.55" />
            </Setter>
        </Style>
        <Style Selector="GridSplitter.handle.rows:pointerover /template/ Border#Grip">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
        </Style>
        <Style Selector="GridSplitter.handle.rows:pressed /template/ Rectangle#Line">
            <Setter Property="Height" Value="2" />
            <Setter Property="Fill">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.9" />
            </Setter>
        </Style>
        <Style Selector="GridSplitter.handle.rows:pressed /template/ Border#Grip">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
        </Style>

        <Style Selector="GridSplitter.handle:pointerover /template/ Rectangle#Line">
            <Setter Property="Width" Value="2" />
            <Setter Property="Fill">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.55" />
            </Setter>
        </Style>
        <Style Selector="GridSplitter.handle:pressed /template/ Rectangle#Line">
            <Setter Property="Width" Value="2" />
            <Setter Property="Fill">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.9" />
            </Setter>
        </Style>

        <!-- One step forwards or backwards through a list, beside the list itself. -->
        <Style Selector="Button.step">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- The tracker's page buttons. Not transport: they change what you are looking at
             rather than what the song is doing, so they read as words rather than symbols and
             sit apart from the run of them. -->
        <!-- A title that doubles as the handle folding what is under it away. A toggle that
             must not look like one: no frame and no fill in any state, so it reads as a line
             that opens and closes rather than as something to press. Out here rather than on
             one page because the machine editor's cards and the tracker's automation both fold
             the same way, and two spellings of one gesture would eventually disagree. -->
        <Style Selector="ToggleButton.fold">
          <Setter Property="Padding" Value="0" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="HorizontalAlignment" Value="Stretch" />
          <Setter Property="HorizontalContentAlignment" Value="Left" />
          <Setter Property="Cursor" Value="Hand" />

          <!-- Its own template rather than a setter for every state the theme has an opinion
               about. The fill a toggle gets when it is on is painted inside the template, where
               a setter out here cannot reach it, and a title row lit up in the accent colour is
               the button this is trying not to be. Transparent rather than nothing, so the
               whole row still catches the pointer. -->
          <Setter Property="Template">
            <ControlTemplate>
              <ContentPresenter Background="Transparent"
                                Content="{TemplateBinding Content}" />
            </ControlTemplate>
          </Setter>
        </Style>

        <!-- The two things under the pattern, wearing the one shape: a line with a name on it
             and whatever it folds away underneath. Only the line is here; the room the open
             one gets belongs to the grid it stands in, since only a grid can share it out. -->
        <Style Selector="views|FoldStrip">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid RowDefinitions="Auto,Auto,Auto">
                        <!-- The grip along the strip's own top edge. Its own rather than a
                             splitter between two rows: a splitter shares one length out
                             between the rows it lies between, so a strip's handle would take
                             its room off the strip above rather than off the pattern. -->
                        <Thumb Grid.Row="0" x:Name="Grip" Classes="strip"
                               IsVisible="{TemplateBinding IsOpen}" />

                        <!-- Air on both sides of the name. Without it the word sits against
                             whatever line is above it and reads as that thing's caption rather
                             than as the lid of what is under it. -->
                        <ToggleButton Grid.Row="1" Classes="fold" Margin="0,4"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <!-- A tab rather than a line of text. Folded, the whole of one of
                                 these is two words at the foot of the page, and two words with
                                 nothing round them read as a caption for the thing above rather
                                 than as the way to open the thing below. -->
                            <Border Classes="foldBar">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <TextBlock Classes="chevron" Text="▾" FontSize="12"
                                               Width="14" VerticalAlignment="Center" />
                                    <TextBlock Classes="foldName" VerticalAlignment="Center"
                                               Text="{TemplateBinding Title}" />
                                </StackPanel>
                            </Border>
                        </ToggleButton>

                        <ContentPresenter Grid.Row="2"
                                          Height="{TemplateBinding StripHeight}"
                                          Content="{TemplateBinding Content}"
                                          IsVisible="{TemplateBinding IsOpen}" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- The one control the pointer is offering to a controller. A knob and a fader paint
             their own ring, because they paint everything else about themselves; a control made
             of a template cannot, so it wears this instead. The colour is the panel's own link
             red, which is the part that has to match: plainly not a colour anything on the page
             is wearing for its own reasons. -->
        <Style Selector="ToggleButton.strip.offered /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="#FF2D2D" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="#33FF2D2D" />
        </Style>

        <!-- The strip the mixer is about, which is the track everything pointed at a strip
             follows. Its own edge rather than a fill, so the meters and the fader inside it
             read exactly as they do on every other strip. -->
        <Style Selector="Border.inset.selected">
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.75" />
            </Setter>
        </Style>

        <Style Selector="Border.foldBar">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" Opacity="0.12" />
            </Setter>
        </Style>

        <Style Selector="ToggleButton.fold:pointerover Border.foldBar">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.22" />
            </Setter>
        </Style>

        <Style Selector="Border.foldBar > StackPanel > TextBlock.foldName">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.9" />
        </Style>

        <Style Selector="ToggleButton.fold:pointerover Border.foldBar > StackPanel > TextBlock.foldName">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- The grip itself, drawn the way the handle between two rows is drawn, because it is
             the same gesture: a short bar you take hold of, quiet until the pointer is on it. -->
        <Style Selector="Thumb.strip">
            <Setter Property="Cursor" Value="SizeNorthSouth" />
            <Setter Property="Height" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="Bar" Width="46" Height="4" CornerRadius="2"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" Opacity="0.55" />
                            </Border.Background>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Thumb.strip:pointerover /template/ Border#Bar">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
        </Style>

        <Style Selector="Thumb.strip:pressed /template/ Border#Bar">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
        </Style>

        <!-- The mark beside it: pointing right when there is something folded behind it, down
             when there is not, and turning between the two rather than swapping, because that
             is what says the two states are one thing. -->
        <Style Selector="ToggleButton.fold TextBlock.chevron">
          <Setter Property="FontSize" Value="10" />
          <Setter Property="Width" Value="12" />
          <Setter Property="TextAlignment" Value="Center" />
          <Setter Property="Opacity" Value="0.7" />
          <Setter Property="RenderTransform" Value="rotate(-90deg)" />
          <Setter Property="Transitions">
            <Transitions>
              <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
          </Setter>
        </Style>

        <Style Selector="ToggleButton.fold:checked TextBlock.chevron">
          <Setter Property="RenderTransform" Value="none" />
        </Style>

        <Style Selector="ToggleButton.fold:pointerover TextBlock.chevron">
          <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.page">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.TextMuted}" />
            </Setter>
        </Style>
        <!-- The page you are on wears the accent rather than being written in it.

             It used to be the accent as text against the same background the other two have,
             which is two shades of the same colour a few pixels apart: a difference nobody can
             see without comparing, on the one control on this bar where being certain matters.
             Filled, it reads at a glance and from across the room.

             Inverse rather than a colour of its own, and that is what makes it work in all
             twelve themes without a key being added to any of them. Every palette here puts its
             background at the far end from its accent, dark against a light accent and light
             against a dark one, so swapping the two is contrast by construction. -->
        <Style Selector="Button.page.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Through the template, because a button's background lives on the presenter inside
             it: set on the button itself it is replaced the moment a pointer crosses it, and the
             page you are on would go back to looking like the two you are not. The three states
             say the same thing for that reason. -->
        <Style Selector="Button.page.active /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Background}" />
            </Setter>
        </Style>

        <Style Selector="Button.page.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Background}" />
            </Setter>
        </Style>

        <Style Selector="Button.page.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Accent}" />
            </Setter>
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Background}" />
            </Setter>
        </Style>

        <Style Selector="Button.armed">
            <Setter Property="Background">
                <SolidColorBrush Color="{DynamicResource Color.Danger}" />
            </Setter>
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Danger}" />
            </Setter>
        </Style>

        <!-- The two halves of having unsaved work, coloured rather than starred: a star is a
             character somebody has to know the meaning of and it moves the button's width as it
             comes and goes, where a colour is read without being decoded and from across the
             room.

             Green for the one that keeps the work and warm for the one that throws it away, so
             the pair reads at a glance the way a light does. Both light up on the same fact,
             that there is something on screen which is not on disc, and that is the whole
             reason they are two colours and not one: the moment the safe button starts asking
             to be pressed is the moment the other one starts being able to cost you an
             afternoon. Warm and not red on the second, because cancelling is a decision
             somebody takes on purpose and is asked about first, not a fault. -->
        <!-- No underline under the page you are on. That is what Fluent draws and it reads as
             a web page rather than as a piece of gear; the word itself carries the colour
             instead, which is the three TabItemHeaderForegroundSelected keys in Base.axaml, so
             nothing is lost and a line of pixels is not spent saying what a colour already
             says.

             The line stays on a strip that runs down the side, and that is not an
             inconsistency: down a column the words are a list, the mark is at the head of the
             row rather than under it, and it is what tells a selected row from a hovered one.
             Which way a strip runs is the whole difference, so that is what this asks about
             rather than a class somebody has to remember to put on. -->
        <Style Selector="TabControl[TabStripPlacement=Top] > TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <!-- And in bold, because colour alone was not enough. On a light theme the accent and
             the ordinary lettering are near enough in weight and darkness that the strip read
             as six words with nothing chosen, which is worse than the underline was. Two
             signals rather than one, and the second is the one that still works for somebody
             who cannot tell the two colours apart. -->
        <Style Selector="TabItem:selected">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.save">
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Save}" />
            </Setter>
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Save}" />
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.discard">
            <Setter Property="Foreground">
                <SolidColorBrush Color="{DynamicResource Color.Discard}" />
            </Setter>
            <Setter Property="BorderBrush">
                <SolidColorBrush Color="{DynamicResource Color.Discard}" />
            </Setter>
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>

    <Application.Resources>

        <!-- A number field with its own compact stepper: two buttons stacked in the height of
             the input, rather than the full-size pair a NumericUpDown reserves room for. -->
        <ControlTheme x:Key="{x:Type ui:NumberField}" TargetType="ui:NumberField">
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />

            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Name="PART_TextBox"
                                 Grid.Column="0"
                                 Text="{TemplateBinding Text}"
                                 FontSize="{TemplateBinding FontSize}"
                                 MinWidth="0"
                                 MinHeight="0"
                                 Height="30"
                                 Padding="4,0"
                                 TextAlignment="Center"
                                 VerticalContentAlignment="Center" />

                        <Grid Grid.Column="1" RowDefinitions="*,*" Margin="2,0,0,0" Width="16">
                            <RepeatButton Name="PART_Up"
                                          Grid.Row="0"
                                          Classes="stepper"
                                          Content="▲" />
                            <RepeatButton Name="PART_Down"
                                          Grid.Row="1"
                                          Classes="stepper"
                                          Content="▼" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- One instrument row, shared by the list beside the pattern and the one in the editor. -->
        <DataTemplate x:Key="InstrumentRow" x:DataType="vm:InstrumentSlot">
            <!-- Two lines, as close together as they read well: a song with eight instruments
                 should not need scrolling to see them. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6">
                <Border Grid.Column="0" Grid.RowSpan="3" Width="4" CornerRadius="2"
                        VerticalAlignment="Stretch"
                        Background="{Binding Colour, Converter={StaticResource HexBrush}}" />

                <ui:LevelMeter Grid.Column="1" Grid.RowSpan="3"
                                 Left="{Binding Level}"
                                 Width="10"
                                 Height="42"
                                 IsVisible="{Binding HasTrack}"
                                 ShowPeak="False"
                                 VerticalAlignment="Center" />

                <TextBlock Grid.Column="2" Grid.RowSpan="3"
                           Text="{Binding Number}"
                           FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                           VerticalAlignment="Center"
                           Opacity="0.7" />

                <TextBlock Grid.Column="3" Grid.Row="0"
                           Text="{Binding Name}"
                           LineHeight="16"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Column="3" Grid.Row="2"
                           Classes="cardHint"
                           LineHeight="14"
                           Text="{Binding DetailText}" />

                <Border Grid.Column="4" Grid.Row="0"
                        Classes="badge"
                        IsVisible="{Binding HasTrack}">
                    <TextBlock Text="{Binding TrackBadge}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- A machine on the rack: no cell number to answer to, so just what it is, and the
             colour it is. Every machine of ours has one of its own, so a rack full of boxes is
             read the way a rack is: by which box, not by reading each label. -->
        <DataTemplate x:Key="RackRow" x:DataType="vm:RackMachine">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Border Grid.Column="0" Width="4" CornerRadius="2"
                        VerticalAlignment="Stretch"
                        Background="{Binding Colour, Converter={StaticResource HexBrush}}" />

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="cardHint" Text="{Binding DetailText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <conv:HexBrushConverter x:Key="HexBrush" />
        <conv:NullToUnsetConverter x:Key="NullToUnset" />
        <conv:IsSelectedColorConverter x:Key="IsSelectedColor" />
        <conv:SelectedSwatchSizeConverter x:Key="SelectedSwatchSize" />
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
        <conv:ModeToColorConverter x:Key="ModeToColorConverter" />
    </Application.Resources>

</Application>