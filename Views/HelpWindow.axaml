<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:help="clr-namespace:JingleBox2.Help"
        xmlns:helpr="clr-namespace:JingleBox2.Help.Records"
        xmlns:views="clr-namespace:JingleBox2.Views"
        x:Class="JingleBox2.Views.HelpWindow"
        x:DataType="helpr:HelpTopic"
        Title="Help"
        Width="720"
        Height="460"
        WindowStartupLocation="CenterOwner">

  <!-- Opened on the thing that was asked about, and browsable from there: a list on the left
       so an answer leads to the next question rather than to closing the window.

       The two panes are dragged apart with the same handle the designer uses. A topic's title
       and its summary are two lines of prose in a fixed column, so a list of them is either
       wrapping where it need not or taking room the page it explains would rather have, and
       which of those is true depends on the wording rather than on the window. The spacing is
       two, so the ten pixel handle between the panes leaves the fourteen the columns had. -->
  <Grid Margin="14" ColumnSpacing="2">

    <!-- Both panes have a floor, since a splitter with none can be dragged until one of them
         is not there, and a pane that is gone is one nobody can take hold of to bring back. -->
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" MinWidth="140" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="*" MinWidth="240" />
    </Grid.ColumnDefinitions>

    <DockPanel Grid.Column="0">
      <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Help" Margin="0,0,0,8" />

      <ListBox x:Name="TopicList" SelectionChanged="OnTopicChanged">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="0" />
          </Style>
        </ListBox.Styles>

        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="helpr:HelpTopic">
            <StackPanel>
              <TextBlock Text="{Binding Title}" />
              <TextBlock Classes="cardHint" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns" Width="10"
                  ToolTip.Tip="Drag to give the list or the page more room." />

    <Border Grid.Column="2" Classes="inset">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="{Binding Title}" Margin="0,0,0,10" />

        <Button DockPanel.Dock="Bottom" Content="Close" Click="OnClose"
                HorizontalAlignment="Right" Margin="0,10,0,0" MinWidth="90" />

        <!-- The body is markdown: sections, lists, and the key names in code marks. It is
             drawn rather than shown as it is written, which is what lets a topic have sections
             at all: a TextBlock is one size and one weight, so a heading inside one had to be
             shouty capitals. -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <views:MarkdownView Markdown="{Binding Body}" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</Window>
