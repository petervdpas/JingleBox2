<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JingleBox2.ViewModels"
        xmlns:tracker="clr-namespace:JingleBox2.Tracker"
        xmlns:trackerr="clr-namespace:JingleBox2.Tracker.Records"
        x:Class="JingleBox2.Views.SongDialog"
        x:DataType="vm:TrackerViewModel"
        Title="Open song"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Spacing="16" Margin="20">

    <!-- Always here, whether there are three songs or three hundred. A box that appears once
         the list is long enough is a box nobody knows about until the day it turns up. -->
    <TextBox Name="SearchBox"
             Text="{Binding SongSearch}"
             PlaceholderText="Search by name..." />

    <TextBlock Text="Nothing saved yet."
               IsVisible="{Binding !SavedSongs.Count}"
               Opacity="0.7" />

    <TextBlock Text="No song by that name."
               IsVisible="{Binding NoSongsFound}"
               Opacity="0.7" />

    <!-- Eight rows and then it scrolls, so a shelf of songs does not push the buttons off the
         bottom of the screen. Eight of the usual kind: a row is sixty five pixels with its
         margin, and one whose note runs to a second line is taller, so a list of wordy songs
         shows seven and a list of bare ones shows nine. Double click opens, as a list of files
         does everywhere else. -->
    <ListBox Name="Songs"
             Classes="cards"
             MaxHeight="520"
             IsVisible="{Binding ShownSongs.Count}"
             ItemsSource="{Binding ShownSongs}"
             SelectedItem="{Binding SelectedSongFile}"
             DoubleTapped="Songs_DoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="trackerr:SongFile">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />

              <!-- Only when there is something to say, so a song without a note keeps a one
                   line row rather than a blank second line under its name. -->
              <TextBlock Text="{Binding Description}"
                         IsVisible="{Binding HasDescription}"
                         Opacity="0.7" FontSize="12"
                         TextWrapping="Wrap" MaxLines="2"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- On the row rather than under the list, because it is about that song and not
                 about whatever happens to be picked. The same delete and the same question as
                 the button in the bar. -->
            <Button Grid.Column="1" Content="Delete" Classes="danger"
                    VerticalAlignment="Center"
                    Click="Delete_Click"
                    ToolTip.Tip="Deletes this song from disc. The instruments it used are untouched." />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <Button Grid.Column="1" Name="CancelButton" Content="Cancel" Click="Cancel_Click"
              MinWidth="88" IsCancel="True" />
      <Button Grid.Column="2" Name="OpenButton" Content="Open" Click="Open_Click"
              MinWidth="88" IsDefault="True"
              IsEnabled="{Binding SelectedSongFile, Converter={x:Static ObjectConverters.IsNotNull}}" />
    </Grid>

  </StackPanel>

</Window>
