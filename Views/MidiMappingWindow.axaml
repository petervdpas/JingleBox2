<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JingleBox2.ViewModels"
        xmlns:views="clr-namespace:JingleBox2.Views"
        x:Class="JingleBox2.Views.MidiMappingWindow"
        x:DataType="vm:MidiViewModel"
        Title="Pad Mapping"
        Width="600" Height="640"
        MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="16,0,16,16">
      <Button Content="Close"
              HorizontalAlignment="Right"
              Click="OnClose" />
    </Border>

    <!-- The mapping itself stays a plain view, so it can live anywhere this window does not. -->
    <views:MidiView />
  </DockPanel>
</Window>
