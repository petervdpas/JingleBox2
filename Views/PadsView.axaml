<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             x:Class="JingleBox2.Views.PadsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <Style Selector="Button.colorSwatch">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="CornerRadius" Value="50"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="White"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgBrush}">
    <DockPanel Classes="tabRoot">

      <!-- The profile and the pads it holds, side by side: picking a profile and picking a
           pad out of it are one glance apart, and neither is worth the whole width. Narrow the
           window and they stack, because a profile picker squeezed to nothing helps nobody. -->
      <views:Beside DockPanel.Dock="Top" Gap="12" Least="330" Margin="0,0,0,12">

      <Border Classes="card" VerticalAlignment="Top">
        <Grid ColumnDefinitions="*,Auto"
              ColumnSpacing="10"
              RowDefinitions="Auto,Auto"
              RowSpacing="10">

          <ComboBox Grid.Row="0" Grid.Column="0"
                    ItemsSource="{Binding ProfileNames}"
                    SelectedItem="{Binding SelectedProfileName, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />

          <Button Grid.Row="0" Grid.Column="1"
                  Content="Delete"
                  Classes="danger"
                  Command="{Binding DeleteProfileCommand}" />

          <TextBox Grid.Row="1" Grid.Column="0"
                   PlaceholderText="New profile name"
                   Text="{Binding NewProfileName}" />

          <Button Grid.Row="1" Grid.Column="1"
                  Content="Add"
                  Command="{Binding AddProfileCommand}" />
        </Grid>
      </Border>

      <!-- The pads as they are laid out, and one editor pointed at whichever is picked.
           Before this the page was every pad's settings stacked down a scroll, which is a page
           you hunt through; the grid is the same reach as the one you play on. -->

          <ListBox x:Name="PadGrid"
                   Width="440"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Top"
                   Background="Transparent"
                   BorderThickness="0"
                   Padding="0"
                   ItemsSource="{Binding Pads}"
                   SelectedItem="{Binding SelectedPad}">

            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Background" Value="Transparent" />
              </Style>

              <!-- The one being edited wears the ring, the way a picked pad does everywhere
                   else in the app. -->
              <Style Selector="ListBoxItem:selected Border">
                <Setter Property="BorderBrush">
                  <SolidColorBrush Color="{DynamicResource Color.Accent}" />
                </Setter>
                <Setter Property="BorderThickness" Value="2" />
              </Style>
            </ListBox.Styles>

            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="{Binding PadColumns}" />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:PadViewModel">
                <!-- A pad at a glance: what colour it is, what it is called, and whether it has
                     anything on it. Not a working pad: pressing one here picks it rather than
                     playing it, because this is the page where you set them up. -->
                <Border Margin="4"
                        Height="78"
                        CornerRadius="6"
                        Background="{Binding PadPreviewBrush}">
                  <TextBlock Text="{Binding Title}"
                             Margin="6"
                             FontSize="12"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center" />
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

      </views:Beside>

      <!-- Whatever the grid is pointed at, in full. -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

          <ContentControl Content="{Binding SelectedPad}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="vm:PadViewModel">
            <!-- As tall as what is in it. Inside a scroller a card is stretched to the
                 viewport by default, which left a hand's width of empty surface under the
                 effects slot on every pad. -->
            <Border Classes="card stacked" VerticalAlignment="Top">
              <StackPanel Spacing="12">

                <!-- Two halves. On the left what the pad is: its name, what it plays,
                     its colour, whether it loops. On the right what it sounds like, which
                     is the half you touch while something is on air.

                     Half each, and one under the other on a narrow window: below three hundred
                     a side the name box and the path stop showing enough of themselves to be
                     read, and two cramped halves are worse than two full-width ones. -->
                <views:Beside Gap="16" Least="300" Even="True">

                  <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Grid.Column="0"
                             PlaceholderText="Pad name"
                             Text="{Binding Name}" />

                    <ComboBox Grid.Column="1"
                              Width="124"
                              ItemsSource="{x:Static vm:PadViewModel.SourceKinds}"
                              SelectedItem="{Binding SourceKind}" />
                  </Grid>

                  <!-- Off the shelf rather than off the disc. What a pad plays is still a
                       file underneath, but it is one this app owns and can find again: a jingle
                       pointing into somebody's downloads folder is silence waiting to happen.
                       Anything from elsewhere comes in on the RECORD tab first. -->
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="10"
                        IsVisible="{Binding IsRecording}">
                    <TextBox Grid.Column="0"
                             IsReadOnly="True"
                             PlaceholderText="No recording on this pad yet"
                             Text="{Binding SourceText}"
                             ToolTip.Tip="{Binding FilePath}" />
                    <views:TakePicker Grid.Column="1"
                                      Takes="{Binding $parent[views:PadsView].((vm:MainViewModel)DataContext).Takes}"
                                      Picked="PadTake_Picked"
                                      ToolTip.Tip="Fetches one of your recordings onto this pad: search it by name or narrow it to a category." />
                  </Grid>

                  <TextBox IsVisible="{Binding IsStream}"
                           PlaceholderText="Stream URL (https://...)"
                           Text="{Binding FilePath}" />

                  <Grid ColumnDefinitions="Auto,*">
                    <!-- Left: loop toggle -->
                    <ToggleSwitch Grid.Column="0"
                                  IsChecked="{Binding Loop}"
                                  OnContent="Loop"
                                  OffContent="Loop" />

                    <!-- Right: colour palette + preview + clear -->
                    <WrapPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right">

                      <Button Classes="colorSwatch" Background="#E53935"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#E53935'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#E53935'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#E53935'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#E53935" />
                      <Button Classes="colorSwatch" Background="#FB8C00"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#FB8C00'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#FB8C00'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#FB8C00'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#FB8C00" />
                      <Button Classes="colorSwatch" Background="#FDD835"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#FDD835'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#FDD835'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#FDD835'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#FDD835" />
                      <Button Classes="colorSwatch" Background="#43A047"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#43A047'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#43A047'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#43A047'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#43A047" />
                      <Button Classes="colorSwatch" Background="#00ACC1"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#00ACC1'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#00ACC1'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#00ACC1'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#00ACC1" />
                      <Button Classes="colorSwatch" Background="#1E88E5"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#1E88E5'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#1E88E5'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#1E88E5'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#1E88E5" />
                      <Button Classes="colorSwatch" Background="#8E24AA"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#8E24AA'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#8E24AA'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#8E24AA'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#8E24AA" />
                      <Button Classes="colorSwatch" Background="#F06292"
                              Width="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#F06292'}"
                              Height="{Binding PadColor, Converter={StaticResource SelectedSwatchSize}, ConverterParameter='#F06292'}"
                              BorderThickness="{Binding PadColor, Converter={StaticResource IsSelectedColor}, ConverterParameter='#F06292'}"
                              Command="{Binding SetColorCommand}" CommandParameter="#F06292" />

                      <!-- Clear: styled as a fixed-size "no colour" swatch with centred ✕ -->
                      <Button Classes="colorSwatch"
                              Width="22" Height="22"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              BorderThickness="2"
                              Content="✕"
                              FontSize="11"
                              Foreground="{DynamicResource TextMutedBrush}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              ToolTip.Tip="Clear custom colour"
                              Command="{Binding ClearColorCommand}" />
                    </WrapPanel>
                  </Grid>
                  </StackPanel>

                  <StackPanel Spacing="12" VerticalAlignment="Top">
                  <!-- One framed part, the way a machine's panel frames its amplifier: how
                       the level comes up, how it goes away, and how loud it is are one
                       subject, and three controls loose on a card do not say so. No caption:
                       the three controls say what they are, and a word over them only
                       repeats them. -->
                  <ui:PanelGroup>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">

                      <!-- A grid rather than two rows, so the label column is as wide as the
                           longer of the two words and the fields line up under each other. -->
                      <Grid Grid.Column="0"
                            ColumnDefinitions="Auto,Auto"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="8" RowSpacing="8"
                            VerticalAlignment="Top">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Fade In"
                                   VerticalAlignment="Center" />
                        <ui:NumberField Grid.Row="0" Grid.Column="1"
                                           Value="{Binding FadeIn}" Minimum="0" Maximum="4.9"
                                           SmallStep="0.1" LargeStep="0.5" Format="0.0" Width="76" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Fade Out"
                                   VerticalAlignment="Center" />
                        <ui:NumberField Grid.Row="1" Grid.Column="1"
                                           Value="{Binding FadeOut}" Minimum="0" Maximum="4.9"
                                           SmallStep="0.1" LargeStep="0.5" Format="0.0" Width="76" />
                      </Grid>

                      <!-- The mixer's own fader, on the pad it belongs to: the same scale, the
                           same wheel and arrow keys, the same double click back to unity. It
                           reads and writes its own label and value, so neither is spelled out
                           beside it. Unity is the top of the travel, since a pad plays a file
                           rather than amplifying one. -->
                      <ui:Fader Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   Label="Volume" Unit=" dB" Format="0.0" DefaultValue="0"
                                   Minimum="-60" Maximum="0"
                                   SmallStep="0.5" LargeStep="3"
                                   Ticks="0,-6,-12,-24,-40,-60"
                                   ToolTip.Tip="Drag it, or use the wheel and the arrow keys. Double click for 0 dB."
                                   Value="{Binding VolumeDecibels}" />
                    </Grid>
                  </ui:PanelGroup>

                  <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom">
                      <!-- The same pair as the recordings list: the shape says play and stop
                           without a word, and each is lit only when it is the one to press. -->
                      <Button Content="▶" MinWidth="36" Padding="6,5" FontSize="12"
                              IsEnabled="{Binding !IsPlaying}"
                              Command="{Binding PlayCommand}"
                              ToolTip.Tip="Play this pad" />
                      <Button Content="■" MinWidth="36" Padding="6,5" FontSize="12"
                              IsEnabled="{Binding IsPlaying}"
                              Command="{Binding StopCommand}"
                              ToolTip.Tip="Stop playing" />
                      <Button Content="Clear"
                              Command="{Binding ClearCommand}"
                              Classes="danger" />
                    </StackPanel>
                  </Grid>
                  </StackPanel>
                </views:Beside>

                <!-- The same slot the tracker uses, pointed at this pad. -->
                <views:PluginStrip DataContext="{Binding Effect}" />

              </StackPanel>
            </Border>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>

      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
