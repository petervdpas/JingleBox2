<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Svg.Controls.Avalonia"
        x:Class="JingleBox2.Views.SplashWindow"
        SizeToContent="WidthAndHeight"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        CanResize="False"
        Topmost="True"
        Background="Transparent"
        TransparencyLevelHint="Transparent">

  <!-- Darker than either purple the icon's disc is painted with, which runs #C841FF down to
       #59007E. Below the drawing's own darkest, so the drawing sits on it rather than in it.

       It also settles the one thing that did not read. The artwork's "2" and its pads are
       #d346f8 at a quarter opacity, which against the disc's dark end is not a watermark, it
       is nothing: they are there and cannot be seen. Against this they are faint on purpose and
       actually present, and the yellow title reads better in the same move, so nothing was
       traded for it.

       The rim is the disc's dark end, so the one purple that left the background is still on
       the window. -->
  <Border x:Name="Frame" CornerRadius="10" ClipToBounds="True" BorderThickness="1">
    <Border.Background>
      <SolidColorBrush Color="#2E0042" />
    </Border.Background>

    <Border.BorderBrush>
      <SolidColorBrush Color="#59007E" />
    </Border.BorderBrush>

    <Grid ColumnDefinitions="Auto,*" Margin="18">

      <!-- The artwork without its disc, since the window is the disc.

           The drawing itself rather than a picture of it. A rendered PNG beside the SVG is a
           second copy of the same artwork, and the copy goes stale the moment the drawing is
           edited, without anything saying so. This is also the one window whose size is not
           known in advance, since it is whatever the display is scaled to. -->
      <Image Grid.Column="0"
             Width="290" Height="290"
             VerticalAlignment="Center"
             Source="{svg:SvgImage avares://JingleBox2/Assets/splash.svg}" />

      <!-- The room down the right is the drawing's own, said again on this side.

           The artwork is 290 wide and carries about 14 of transparent margin inside it, so the
           18 this grid leaves comes out as 32 from the window to the horn. Nothing was leaving
           the same on the right: the column is as wide as the widest thing in it, that was the
           status line rather than the title, and the difference showed as 99 from the "x" to the
           edge against 32 on the left, 32 above and 25 below. One side of a frame three times
           the other three reads as a layout that did not finish, which is what the title's own
           note says about the title.

           So the title is what sets the column, and the 14 here is the drawing's own margin
           given back on the other side. Whichever of the two is wider, the gap from the last
           letter to the border is this margin plus the grid's and nothing else. -->
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,14,0" Spacing="2">
        <!-- One word, since that is the name. Set to fill the width it has: a title with a
             third of the window empty beside it reads as a layout that did not finish.

             No number after it. The drawing is already carrying one, twice the size and in a
             colour of its own, and a second one in words beside it reads as a stutter.

             Orange rather than the horn's yellow, a step along the way to the pink the "2" is
             drawn in. The three warm things on here then sit in order, the horn at 51 degrees,
             this at 30 and the "2" at 288, instead of the title being a second copy of the
             horn's colour. Still 8.4:1 on the background, which is well past anything a title
             this size needs. -->
        <TextBlock Text="JingleBox" FontSize="48" FontWeight="Bold"
                   Foreground="#FA9E42" TextWrapping="NoWrap" />

        <TextBlock x:Name="VersionText" Text="" FontSize="15"
                   Foreground="#EBD7FF" Opacity="0.85" Margin="0,10,0,0" />

        <!-- The one line that changes, and it carries the names of the boxes on the rack as
             well as the steps: what is being read is more worth saying than that something is
             being read.

             A width of its own rather than one the words decide. The window sizes itself to
             what is in it, so a long name arriving would move the whole thing sideways while
             somebody is reading it; at a fixed width the layout is settled by the first frame
             and only the words inside it change.

             The number is the title's own width rather than a round one, so that this is never
             the widest thing in the column and the room down the right stays the drawing's
             margin said back. It was 300, which was 74 wider than the title and was the whole
             of why that side of the frame was three times the other three. Under it by a hair
             on a wider face, and the title simply governs instead. -->
        <TextBlock x:Name="DoingText" Text="Starting" FontSize="13" Width="226"
                   TextWrapping="Wrap"
                   Foreground="#EBD7FF" Opacity="0.65" Margin="0,2,0,0" />

        <!-- And the one thing under it: the device being read, or the setting being applied.
             Two lines because they answer two questions, what is going on and which one of them
             this is, and a line doing both would be a sentence rebuilt for every name.

             Always there, empty or not, so the block is the same height throughout and the
             window does not grow the first time something is said under a heading. -->
        <TextBlock x:Name="UnderText" Text="" FontSize="13" Width="214"
                   TextWrapping="Wrap"
                   Foreground="#EBD7FF" Opacity="0.9" Margin="12,1,0,0" />

      </StackPanel>
    </Grid>
  </Border>
</Window>
