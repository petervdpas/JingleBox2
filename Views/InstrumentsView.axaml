<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.InstrumentsView"
             x:DataType="vm:InstrumentLibraryViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A label and its control, kept together on one line of the top row. -->
    <Style Selector="StackPanel.entry">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>

    <!-- One block of the voice: a heading with its knobs or faders under it. -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,24,10" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16">

    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <TextBlock Classes="cardHint" Text="{Binding Status}" />
    </Border>

    <Grid ColumnDefinitions="240,*" ColumnSpacing="12">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Library" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <TextBlock Classes="cardHint" Text="New instrument on a machine:" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding Machines}"
                        SelectedItem="{Binding SelectedMachine}"
                        DisplayMemberBinding="{Binding Name}"
                        HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="+ New" Command="{Binding NewSynthCommand}"
                      ToolTip.Tip="A new instrument on the picked machine. To start from a sound you already have, pick it and press Duplicate." />
            </Grid>

            <TextBlock Classes="cardHint" Text="Or from a plugin:" Margin="0,6,0,0"
                       IsVisible="{Binding HasAvailablePlugins}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasAvailablePlugins}">
              <ComboBox Grid.Column="0" x:Name="PluginPicker"
                        ItemsSource="{Binding AvailablePlugins}"
                        DisplayMemberBinding="{Binding Name}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Pick a plugin..." />
              <Button Grid.Column="1" Content="+ New" Click="NewFromPlugin_Click" />
            </Grid>

            <TextBlock Classes="cardHint" Text="Or from one of your recordings:" Margin="0,6,0,0" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0" x:Name="RecordingPicker"
                        ItemsSource="{Binding AvailableRecordings}"
                        DisplayMemberBinding="{Binding Name}"
                        HorizontalAlignment="Stretch" />
              <Button Grid.Column="1" Content="+ New" Click="NewFromRecording_Click" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,6,0,0">
              <Button Grid.Column="0" Content="Duplicate" HorizontalAlignment="Stretch"
                      IsEnabled="{Binding HasInstruments}"
                      Command="{Binding DuplicateCommand}" />
              <Button Grid.Column="1" Content="Delete" HorizontalAlignment="Stretch" Classes="danger"
                      IsEnabled="{Binding HasInstruments}"
                      Command="{Binding DeleteCommand}" />
            </Grid>
          </StackPanel>

          <ListBox ItemsSource="{Binding Instruments}"
                   SelectedItem="{Binding Selected}"
                   ItemTemplate="{StaticResource LibraryRow}" />
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Classes="card">
        <!-- The designer is its own control, so the same panel serves this tab and the
             window a track opens onto the instrument it plays. -->
        <views:InstrumentEditor />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
