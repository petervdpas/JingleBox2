<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JingleBox2.Views.ConfirmDialog"
        Title="Confirm"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Spacing="14" Margin="20">

    <!-- Shown only for an error, which is what makes one look like an error rather than like a
         sentence the application happened to say. A note and a question have nothing here and
         keep the shape they always had. -->
    <TextBlock Name="HeadingText" TextWrapping="Wrap" FontWeight="Bold" FontSize="15"
               IsVisible="False">
      <TextBlock.Foreground>
        <SolidColorBrush Color="{DynamicResource Color.Danger}" />
      </TextBlock.Foreground>
    </TextBlock>

    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,6,0,0">
      <Button Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="88" IsCancel="True" />
      <Button Name="ConfirmButton" Content="OK" Classes="danger" Click="Confirm_Click" MinWidth="88" />
    </StackPanel>
  </StackPanel>

</Window>
