<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JingleBox2.Views.ConfirmDialog"
        Title="Confirm"
        Width="400"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Spacing="20" Margin="20">
    <TextBlock Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" MinWidth="88" IsCancel="True" />
      <Button Name="ConfirmButton" Content="OK" Classes="danger" Click="Confirm_Click" MinWidth="88" />
    </StackPanel>
  </StackPanel>

</Window>
