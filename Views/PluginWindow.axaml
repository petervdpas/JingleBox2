<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JingleBox2.ViewModels"
        xmlns:views="clr-namespace:JingleBox2.Views"
        x:Class="JingleBox2.Views.PluginWindow"
        x:DataType="vm:PluginWindowViewModel"
        Title="{Binding Name}"
        SizeToContent="WidthAndHeight"
        MinWidth="320"
        MaxWidth="900"
        MaxHeight="720"
        WindowStartupLocation="CenterOwner">

  <!-- Sized to what the plugin actually has: a two-knob effect gets a small window and a
       thirty-knob one gets a wide one, rather than both getting the same half-empty box. -->
  <DockPanel Margin="14">
    <Border DockPanel.Dock="Top" Classes="inset" Padding="8,5" Margin="0,0,0,12">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />

        <ToggleButton Content="Bypass"
                      MinWidth="0" Padding="10,2" FontSize="12"
                      IsVisible="{Binding HasBypass}"
                      IsChecked="{Binding IsBypassed}"
                      ToolTip.Tip="Switch it off without taking it out of the chain" />

        <!-- The plugin's face or the host's knobs. Only offered where the plugin has a face,
             since without one the knobs are all there is. It is not a preference about looks:
             the host's knobs are the only controls here the host drew, so they are the only
             ones a pointer can rest on to point a hardware knob at one. -->
        <ToggleButton Content="Knobs"
                      MinWidth="0" Padding="10,2" FontSize="12"
                      IsVisible="{Binding Panel.CanShowKnobs}"
                      IsChecked="{Binding Panel.ShowsKnobs}"
                      ToolTip.Tip="Show this plugin's controls as the host draws them, which is what Ctrl+Shift+M points a hardware knob at." />
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <views:PluginParameters DataContext="{Binding Panel}" />
    </ScrollViewer>
  </DockPanel>
</Window>
