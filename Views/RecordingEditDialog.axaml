<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JingleBox2.ViewModels"
        x:Class="JingleBox2.Views.RecordingEditDialog"
        x:DataType="vm:RecordViewModel"
        Title="Edit Recording"
        Width="800"
        Height="400"
        WindowStartupLocation="CenterOwner">

  <StackPanel Spacing="12" Margin="16">
    <TextBlock Text="{Binding SelectedRecordingForEdit.Name, StringFormat='Editing: {0}'}" FontWeight="Bold" FontSize="16" />

    <!-- Waveform Editor -->
    <Border Classes="card" Padding="12">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,auto,auto,auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Text="Trim Region" FontWeight="SemiBold" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="🔍-" Click="ZoomOut_Click" Width="40" />
          <Button Grid.Column="2" Content="🔍+" Click="ZoomIn_Click" Width="40" />
          <Button Grid.Column="3" Content="▶ Play" Click="Play_Click" />
        </Grid>
        <Canvas Height="200" Width="760" Background="#1F2937" Name="EditWaveformCanvas" />
        <TextBlock Text="{Binding CurrentWaveform.TotalSamples, StringFormat='Samples: {0}'}" Opacity="0.7" FontSize="12" />
      </StackPanel>
    </Border>

    <!-- Controls -->
    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
      <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click" />
      <Button Grid.Column="1" Content="Apply Trim" Click="ApplyTrim_Click" />
    </Grid>
  </StackPanel>

</Window>
