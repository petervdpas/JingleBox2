<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.PluginStrip"
             x:DataType="vm:PluginChainViewModel">

  <UserControl.Styles>
    <!-- A device reads as a box you can pick up, and the picked one is lit. -->
    <Style Selector="Border.device">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.Border}" />
      </Setter>
    </Style>

    <Style Selector="Border.device.open">
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.Accent}" />
      </Setter>
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Accent}" Opacity="0.18" />
      </Setter>
    </Style>

    <Style Selector="Border.device.off">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <Style Selector="Button.tiny">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <!-- The chain: a row of devices in the order the audio goes through them, a plus to add
       another, and the knobs of whichever one is picked. -->
  <Border Classes="inset">
    <StackPanel Spacing="6">

      <StackPanel Orientation="Horizontal" Spacing="6">
        <Border Classes="badge" VerticalAlignment="Center">
          <TextBlock Text="{Binding Label}" />
        </Border>

        <views:HelpBadge Topic="tracker.effects" />

        <ItemsControl ItemsSource="{Binding Devices}" VerticalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PluginDeviceViewModel">
              <Border Classes="device"
                      Classes.open="{Binding IsOpen}"
                      Classes.off="{Binding IsBypassed}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Classes="tiny" Content="{Binding Name}"
                          Click="OnOpenDevice"
                          Background="Transparent" BorderThickness="0"
                          ToolTip.Tip="Open this one's controls in a window" />

                  <ToggleButton Classes="tiny" Content="⏻"
                                IsChecked="{Binding IsBypassed}"
                                ToolTip.Tip="Switch it off without taking it out" />
                </StackPanel>

                <Border.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open controls" Click="OnOpenDevice" />
                    <Separator />
                    <MenuItem Header="Move earlier" Command="{Binding MoveLeftCommand}" />
                    <MenuItem Header="Move later" Command="{Binding MoveRightCommand}" />
                    <Separator />
                    <MenuItem Header="Remove" Command="{Binding RemoveCommand}" />
                  </ContextMenu>
                </Border.ContextMenu>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The plus, holding everything installed. -->
        <Button Classes="tiny" Content="+" Width="28"
                IsEnabled="{Binding HasTarget}"
                ToolTip.Tip="Add an effect to the end of the chain">
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel Spacing="6" Width="240">
                <TextBlock Classes="section" Text="Add effect" />

                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Plugins.Effects}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding $parent[UserControl].((vm:PluginChainViewModel)DataContext).AddCommand}"
                                CommandParameter="{Binding .}">
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Classes="cardHint" Text="{Binding FormatName}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBlock Classes="cardHint"
                           IsVisible="{Binding !Plugins.HasEffects}"
                           Text="No plugins yet. Scan for them in SETTINGS." />
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>

        <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding Status}" />
      </StackPanel>

      <TextBlock Classes="cardHint"
                 IsVisible="{Binding IsEmpty}"
                 Text="No effects here." />
    </StackPanel>
  </Border>
</UserControl>
