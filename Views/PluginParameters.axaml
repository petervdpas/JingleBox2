<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Machines.Ui;assembly=JingleBox2.Machines.Ui"
             x:Class="JingleBox2.Views.PluginParameters"
             x:DataType="vm:PluginControlsViewModel">

  <UserControl.Styles>
    <!-- A reading is not a control: no dial, no hover, nothing to grab. -->
    <Style Selector="Border.readout">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="BorderBrush">
        <SolidColorBrush Color="{DynamicResource Color.Border}" />
      </Setter>
    </Style>

    <Style Selector="Border.readout TextBlock.value">
      <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.readout TextBlock.name">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <!-- One device's controls. Shared by the window a device opens in and by anywhere else that
       shows a plugin, so it looks the same wherever it is worked on. -->
  <StackPanel Spacing="10">

    <!-- A plugin runs in a process of its own. When one falls over, this is what is left: a
         note saying so, and a button. Nothing else in the application noticed. -->
    <Border Classes="inset" IsVisible="{Binding HasStopped}">
      <StackPanel Spacing="8">
        <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding StoppedNote}" />
        <Button Content="Start it again"
                HorizontalAlignment="Left"
                Command="{Binding RestartCommand}"
                ToolTip.Tip="Loads it again with the settings it had. Anything it was holding that was never saved does not come back." />
      </StackPanel>
    </Border>

    <!-- The plugin's own interface, where it has one. Everything inside it is the plugin's
         doing; the host only lends it the window. -->
    <views:PluginEditorHost IsVisible="{Binding HasOwnWindow}"
                            Editor="{Binding Editor}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />

    <!-- Knobs are the fallback, for a plugin that draws nothing of its own. -->
    <StackPanel Spacing="10" IsVisible="{Binding !HasOwnWindow}">

    <!-- A plugin that took the application down while opening its window does not get another
         go at it without being asked for by name. -->
    <Border Classes="inset" IsVisible="{Binding IsBlocked}">
      <StackPanel Spacing="8">
        <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding BlockedNote}" />
        <Button Content="Let it try its window again"
                HorizontalAlignment="Left"
                Command="{Binding AllowCommand}"
                ToolTip.Tip="Close this and open it again to find out. If it goes down again it goes straight back on the list." />
      </StackPanel>
    </Border>

    <TextBlock Classes="cardHint" TextWrapping="Wrap"
               IsVisible="{Binding WasAllowed}"
               Text="Allowed. Close this window and open it again to try the plugin's own interface." />

    <!-- A plugin with thousands of parameters has a list that stops somewhere. Where it stops
         is said out loud rather than left to look like the plugin is missing controls. -->
    <TextBlock Classes="cardHint"
               TextWrapping="Wrap"
               IsVisible="{Binding IsTruncated}"
               Text="{Binding TruncationNote}" />

    <!-- The knobs, with the ring the pointer leaves on one lying over the top of them. Over
         and never in, or the row would move when a knob was pointed at. -->
    <Panel>
    <ItemsControl x:Name="Dials" ItemsSource="{Binding Controls}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PluginParameterViewModel">
          <ui:Knob Margin="0,0,14,10"
                      DialSize="38"
                      Label="{Binding Name}"
                      Display="{Binding Text}"
                      Minimum="{Binding Minimum}"
                      Maximum="{Binding Maximum}"
                      DefaultValue="{Binding Default}"
                      SmallStep="{Binding SmallStep}"
                      LargeStep="{Binding LargeStep}"
                      Value="{Binding Value}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <ui:LinkGlow x:Name="Glow" IsHitTestVisible="False" />
    </Panel>

    <!-- The on and off ones. A dial with two positions is a tick box wearing a hat. -->
    <ItemsControl ItemsSource="{Binding Switches}" IsVisible="{Binding HasSwitches}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>

      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:PluginParameterViewModel">
          <CheckBox Margin="0,0,14,0" Content="{Binding Name}" IsChecked="{Binding IsOn}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- What the plugin reports back, kept apart from what you set. -->
    <StackPanel Spacing="6" IsVisible="{Binding HasReadouts}">
      <TextBlock Classes="section" Text="Reading" />

      <ItemsControl ItemsSource="{Binding Readouts}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PluginParameterViewModel">
            <Border Classes="readout" Margin="0,0,8,6">
              <StackPanel Spacing="1">
                <TextBlock Classes="value" Text="{Binding Text}" />
                <TextBlock Classes="name" Text="{Binding Name}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
