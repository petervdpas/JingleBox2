<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.SongControlsView"
             x:DataType="vm:TrackerViewModel">

  <!-- What this song has its controller pointed at. The song's own and not the desk's: the
       desk is looked after in SETTINGS, where it belongs, because it is the same in every song
       and this is not. -->
  <Border Classes="card">
    <StackPanel Classes="cardBody">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Classes="cardTitle" Text="This song's controls" />
      </StackPanel>

      <TextBlock Classes="cardHint" TextWrapping="Wrap"
                 Text="Press Ctrl+Shift+M with an instrument's panel open, rest the pointer on a knob until it glows, and touch the control on your desk. What you point at here is this song's and travels in its file. The same gesture on a machine on the rack makes a link that works in every song, and those are listed in SETTINGS." />

      <Border Classes="inset" IsVisible="{Binding SongControls.HasLinks}">
        <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding SongControls.Controllers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Classes="cardHint" FontWeight="SemiBold" Margin="0,0,0,4"
                             Text="{Binding Said}" />

                  <ItemsControl ItemsSource="{Binding Links}" Margin="10,0,0,0">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                     FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                                     Text="{Binding Control}" />

                          <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" Text="{Binding What}" />

                          <!-- Only when it is pinned to a track. Almost every link follows
                               you, and a column saying so on every row says nothing. -->
                          <TextBlock Grid.Column="2" Classes="cardHint" VerticalAlignment="Center"
                                     IsVisible="{Binding IsPinned}"
                                     Text="{Binding Where}" />

                          <TextBlock Grid.Column="3" Classes="cardHint" VerticalAlignment="Center"
                                     Text="{Binding How}" />

                          <Button Grid.Column="4" Content="Forget" Classes="danger"
                                  Command="{Binding ForgetCommand}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Classes="cardHint" TextWrapping="Wrap"
                 IsVisible="{Binding !SongControls.HasLinks}"
                 Text="{Binding SongControls.Nothing}" />
    </StackPanel>
  </Border>

</UserControl>
