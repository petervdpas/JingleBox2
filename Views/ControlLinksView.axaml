<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.ControlLinksView"
             x:DataType="vm:ControlLinksViewModel">

  <!-- The templates, as a card for each controller against each thing it is pointed at. Bound
       to the list itself rather than to whoever holds one, which is what lets the same drawing
       serve both places it is wanted: the tracker's MIDI CC page and SETTINGS. It was written
       out twice before and the two had already drifted: one had a column the other did not. -->
  <!-- One card is one controller and one target, which is exactly what a file is written from.
       It was a card per target with the controllers nested inside, and that put the templates
       one level down and made the card a thing no file could be written from: a card holding
       two controllers would land on somebody who has one of them. -->
  <StackPanel Spacing="8">
    <TextBlock Classes="cardTitle" Text="{Binding Title}" />

    <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding Hint}" />

    <TextBlock Classes="cardHint" TextWrapping="Wrap"
               IsVisible="{Binding !HasLinks}"
               Text="{Binding Nothing}" />

    <ItemsControl ItemsSource="{Binding Cards}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="card" Margin="0,0,0,8">
            <StackPanel>
              <!-- The heading is the whole of what the card is: what it is pointed at, what
                   sort of thing that is, and which controller. The sort is said quietly and
                   beside the name rather than as a heading of its own, because it is the same
                   word on every card of a run and the name is what you are looking for.

                   The heading folds the card, the same chevron and the same gesture the machine
                   editor's cards use. A desk pointed at six machines is six cards of ten rows
                   apiece, which is more than anybody can hold in their eye, so the ones you are
                   not working on fold away. The whole heading is the button rather than the
                   chevron alone, since a target the size of a character is one nobody can
                   hit. -->
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <ToggleButton Grid.Column="0" Classes="fold" IsChecked="{Binding Open}"
                              ToolTip.Tip="Show or hide what this controller does to this one thing.">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="chevron" Text="&#x25BE;" VerticalAlignment="Center" />
                    <TextBlock Classes="cardTitle" Text="{Binding Title}" />
                    <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding Kind}" />
                    <TextBlock Classes="cardHint" VerticalAlignment="Center" FontWeight="SemiBold"
                               Text="{Binding Said}" />
                  </StackPanel>
                </ToggleButton>

                <Button Grid.Column="1" Content="Export..." Classes="page"
                        Click="Export_Click"
                        ToolTip.Tip="Write what this controller does to this one thing out as a template, to keep or to send to somebody else." />
              </Grid>

              <ItemsControl ItemsSource="{Binding Links}" Margin="10,8,0,0"
                            IsVisible="{Binding Open}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                      <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                 FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                                 Text="{Binding Control}" />

                      <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Said}" />

                      <!-- Only when it is pinned to a track, which a mixer link is
                           not: there the card is the strip and this would repeat it. -->
                      <TextBlock Grid.Column="2" Classes="cardHint" VerticalAlignment="Center"
                                 IsVisible="{Binding IsPinned}"
                                 Text="{Binding Where}" />

                      <!-- Pressed when the guess was wrong. A button that repeats while
                           it is held sends what an encoder sends, so working it out from
                           the values cannot be right every time. -->
                      <Button Grid.Column="3" Classes="page"
                              Content="{Binding How}"
                              Command="{Binding NextCommand}"
                              ToolTip.Tip="What kind of control this is, worked out from what it sends. Press to say it is something else; press past the end to have it listen again." />

                      <Button Grid.Column="4" Content="Forget" Classes="danger"
                              Command="{Binding ForgetCommand}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Classes="cardHint" TextWrapping="Wrap"
               IsVisible="{Binding HasStatus}"
               Text="{Binding Status}" />

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Content="Import a template..." Classes="page"
              Click="Import_Click"
              ToolTip.Tip="Read a template somebody made, here or elsewhere. What it points at is named by id, so it means the same thing on any installation that has the machine." />

      <Button Content="Forget them all" Classes="danger"
              IsEnabled="{Binding HasLinks}"
              Command="{Binding ForgetAllCommand}" />
    </StackPanel>
  </StackPanel>

</UserControl>
