<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.InstrumentEditor"
             x:Name="Root"
             x:DataType="vm:IInstrumentDesigner">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A label and its control, kept together on one line of the top row. -->
    <Style Selector="StackPanel.entry">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>

    <!-- One block of the voice: a heading with its knobs or faders under it. -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,24,10" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="8"
                IsVisible="{Binding Editor, Converter={x:Static ObjectConverters.IsNotNull}}">

            <!-- Everything that is a name or a choice, on as few lines as it takes -->
            <WrapPanel Orientation="Horizontal">
              <StackPanel Classes="entry">
                <TextBlock Classes="field" Text="Name" />
                <TextBox Text="{Binding Editor.Name}" Width="170"
                         IsReadOnly="{Binding !Editor.CanRename}"
                         ToolTip.Tip="A machine keeps the machine's name. Duplicate it to have one of your own." />
              </StackPanel>

              <!-- Somewhere to start. On most machines that is one of the presets shipped in
                   its own folder; on the Recording machine it is one of your takes, because a
                   recording machine with no recording on it has no settings worth shipping.
                   Either way the name, the id and the level stay: this is still the same
                   instrument, given a different sound to make. -->
              <StackPanel Classes="entry">
                <TextBlock Classes="field" Text="{Binding Presets.Caption}" />

                <!-- One control, not three: the arrows, the name and how far through you are
                     all say the same fact and have to move together. The arrows are how you
                     hunt for a sound; pressing the name opens the whole list. -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <!-- Only where the list is takes. A machine offering its own presets has
                       nothing to narrow, and the picker keeps the whole width. -->
                  <ComboBox Width="132" VerticalAlignment="Center"
                            IsVisible="{Binding Presets.PicksTakes}"
                            ItemsSource="{Binding Editor.Takes.Filters}"
                            SelectedItem="{Binding Editor.Takes.Filter}"
                            ToolTip.Tip="Narrow the takes to one category. They are filed on the RECORD tab." />

                  <views:Chooser ItemsSource="{Binding Presets.Items}"
                                 SelectedItem="{Binding Presets.Selected, Mode=TwoWay}"
                                 Placeholder="Start from..."
                                 ToolTip.Tip="{Binding Presets.Hint}" />
                </StackPanel>
              </StackPanel>

            </WrapPanel>

            <TextBlock Classes="cardHint"
                       Text="{Binding Editor.SourceText}"
                       TextTrimming="CharacterEllipsis" />



            <!-- Plugin instruments. The plugin does the playing, so there is no wave to draw
                 and no envelope of ours to set: what is here is the plugin's own. -->
            <StackPanel Spacing="8" IsVisible="{Binding Editor.IsPlugin}">
              <TextBlock Classes="cardHint"
                         IsVisible="{Binding Editor.HasPluginProblem}"
                         TextWrapping="Wrap"
                         Text="{Binding Editor.PluginProblem}" />

              <Border Classes="inset" IsVisible="{Binding Editor.HasPluginPanel}" HorizontalAlignment="Left">
                <StackPanel Spacing="10">
                  <TextBlock Classes="section" Text="{Binding Editor.PluginText}" />

                  <!-- The plugin's own interface opens in a window of its own. Serum draws
                       itself at 1190 by 740 and Vital at 1400 by 820, which is a window, not
                       a panel on a page. -->
                  <Button Content="Open the plugin"
                          HorizontalAlignment="Left"
                          Click="OpenPluginWindow_Click"
                          ToolTip.Tip="The plugin's own interface, in a window you can leave open while you work." />

                  <!-- The instrument's own level, on top of whatever the plugin plays at. The
                       volume column in a pattern rides this the same as for any instrument. -->
                  <views:Fader Label="Level" Unit=" dB" Format="0.0" DefaultValue="0"
                               Minimum="-60" Maximum="6" SmallStep="0.5" LargeStep="3"
                               TrackLength="96"
                               Ticks="6,0,-12,-40"
                               HorizontalAlignment="Left"
                               ToolTip.Tip="Unity is 0 dB, and above it is makeup gain."
                               Value="{Binding Editor.VolumeDecibels}" />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- Sample instruments. Everything below this section applies to a recording as
                 much as to a generated wave: the two are the same voice with a different
                 source, so only what is actually about the file lives here. -->
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding Editor.IsSample}">
              <views:PanelGroup Caption="Sample" VerticalAlignment="Top" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <views:WaveformView Width="340" Height="90"
                                      Peaks="{Binding Editor.Peaks}"
                                      Placeholder="{Binding Editor.SampleText}"
                                      ShowMarkers="True"
                                      ShowLoop="{Binding Editor.IsLooping}"
                                      Start="{Binding Editor.SampleStart}"
                                      End="{Binding Editor.SampleEnd}"
                                      LoopStart="{Binding Editor.LoopStart}"
                                      LoopEnd="{Binding Editor.LoopEnd}"
                                      Playhead="{Binding Editor.Playhead}"
                                      ToolTip.Tip="Drag the solid handles to set what plays, and the dashed ones to set the loop." />

                  <TextBlock Classes="cardHint" Text="{Binding Editor.SampleText}" />

                  <!-- One line: the switches are the tallest thing here and everything else
                       stands level with their handles rather than on the floor of the row. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="field" VerticalAlignment="Center" Text="Base note" />
                    <views:NumberField Value="{Binding Editor.BaseNoteSemitone}"
                                       Minimum="0" Maximum="119" Width="70" VerticalAlignment="Center"
                                       ToolTip.Tip="The pitch the file sounds at. Every other note is read faster or slower than this one." />
                    <TextBlock Classes="field" VerticalAlignment="Center" Text="{Binding Editor.BaseNoteText}" />

                    <TextBlock Classes="field" VerticalAlignment="Center" Text="Loop" Margin="10,0,0,0" />
                    <ComboBox Width="110" VerticalAlignment="Center"
                              ItemsSource="{Binding Editor.LoopModes}"
                              SelectedItem="{Binding Editor.LoopMode}"
                              ToolTip.Tip="Forward jumps back to the loop start; ping-pong turns round at each end." />

                    <!-- Switches rather than tick boxes: this is a machine's front panel, and
                         the rest of it reads its settings off handles that show every position
                         at once. -->
                    <views:Switch Label="Direction" Margin="6,0,0,0"
                                  OnLabel="Reverse" OffLabel="Forward"
                                  IsChecked="{Binding Editor.Reverse}"
                                  ToolTip.Tip="Plays the window from its end towards its start." />

                    <views:Switch Label="Voices" Margin="6,0,0,0"
                                  OnLabel="One" OffLabel="Many"
                                  IsChecked="{Binding Editor.OneVoice}"
                                  ToolTip.Tip="One: a key played by hand stops the note before it. Many: they sound over each other, as a keyboard does. A track is one voice either way." />
                  </StackPanel>
                </StackPanel>
              </views:PanelGroup>
            </WrapPanel>

            <!-- Zampler. The map first, drawn rather than listed, because what you need to
                 see is whether the keyboard is covered and a table of ranges will not tell you.
                 Then the zone in hand, then the filter and the two envelopes it lands in,
                 which on the machine this follows was the whole of the instrument. -->
            <StackPanel Spacing="12" IsVisible="{Binding Editor.IsZampler}">

              <StackPanel Spacing="6">
                <TextBlock Classes="section" Text="Map" />

                <views:ZoneStrip Height="86"
                                 Zones="{Binding Editor.Zones.Zones}"
                                 Selected="{Binding Editor.Zones.Selected}"
                                 Revision="{Binding Editor.Zones.Revision}"
                                 ToolTip.Tip="Drag an edge to move it, drag the middle to slide the whole zone along, drag the white line to say which key the recording was made at. Where two zones overlap, the one in front wins." />

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Add zone" Command="{Binding Editor.Zones.AddCommand}" />
                  <Button Content="Remove" Command="{Binding Editor.Zones.RemoveCommand}"
                          IsEnabled="{Binding Editor.Zones.CanRemove}" />
                  <Button Content="Spread" Command="{Binding Editor.Zones.SpreadCommand}"
                          ToolTip.Tip="Lays every zone that has a recording out evenly across the keyboard, each rooted in its own middle." />
                </StackPanel>
              </StackPanel>

              <views:SliceEditor Slices="{Binding Editor.Slices}" />

              <StackPanel Orientation="Horizontal" Spacing="24">

                <!-- The zone in hand. Framed like the filter and the envelopes, so the panel
                     reads as three parts rather than a column and some boxes. -->
                <views:PanelGroup Caption="Zone" IsVisible="{Binding Editor.Zones.HasZone}"
                                  VerticalAlignment="Top">
                <StackPanel Spacing="8">

                  <!-- Which zone, what is on it, and what it is called: three questions on
                       two rows rather than four. The buttons stand together because they are
                       both about the recording on this zone. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Named by the property rather than by what the zone prints itself as,
                         so a zone that takes another recording is renamed in the list too. -->
                    <ComboBox Width="150"
                              ItemsSource="{Binding Editor.Zones.Zones}"
                              SelectedItem="{Binding Editor.Zones.Selected}"
                              DisplayMemberBinding="{Binding Title}" />

                    <Button Content="Clear" Click="ClearZoneSample_Click" />

                    <Button Content="Load samples..." Click="ImportZones_Click"
                            ToolTip.Tip="Pick any number of samples from anywhere. They are copied into JingleBox and laid across the keyboard, one zone apiece." />
                  </StackPanel>

                  <!-- The only way onto a zone. On the machine this follows, sampling and
                       playing were one box and there was no step between them called finding
                       the file; here the RECORD tab is that box's input. -->
                  <!-- One button, and the shelf opens in a dialog with room to hunt in. On
                       the panel it costs the width of a button; the category, the search and
                       the list of takes all live in the dialog, where there is room for them. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:TakePicker Takes="{Binding Editor.Takes}"
                                      Picked="ZoneRecording_Changed"
                                      ToolTip.Tip="Fetches one of your recordings onto this zone: search it by name or narrow it to a category. Anything from elsewhere is imported on the RECORD tab first." />

                    <TextBlock Classes="field" Text="Name" Margin="6,0,0,0" />
                    <TextBox Width="130" Text="{Binding Editor.Zones.Selected.Name}" />
                  </StackPanel>

                  <TextBlock Classes="cardHint" Text="{Binding Editor.Zones.Selected.FileText}"
                             TextTrimming="CharacterEllipsis" MaxWidth="260" />

                  <!-- The range and the root are set on the map by dragging, so they are read
                       out here rather than dialled. -->
                  <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Classes="field" Text="Keys" />
                    <TextBlock Classes="section" Text="{Binding Editor.Zones.Selected.RangeText}" />
                    <TextBlock Classes="field" Text="Root" Margin="10,0,0,0" />
                    <TextBlock Classes="section" Text="{Binding Editor.Zones.Selected.RootText}" />
                  </StackPanel>

                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 3 3">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Level"
                                Format="0.00" DefaultValue="1" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Zones.Selected.Volume}" />

                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Pan"
                                Format="0.00" DefaultValue="0" Minimum="-1" Maximum="1" SmallStep="0.02" LargeStep="0.2"
                                Value="{Binding Editor.Zones.Selected.Pan}" />

                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Fine"
                                Unit="c" Format="0" DefaultValue="0" Minimum="-100" Maximum="100" SmallStep="1" LargeStep="10"
                                Value="{Binding Editor.Zones.Selected.FineCents}"
                                ToolTip.Tip="Hundredths of a semitone, for sitting one zone against the next." />
                  </views:PanelStrip>
                </StackPanel>
                </views:PanelGroup>

                <!-- The filter and the two envelopes: a four pole low pass with an envelope of
                     its own, which is what an Emulator put every voice through. -->
                <StackPanel Spacing="8">
                  <views:PanelGroup Caption="Filter">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 3 3 3 3">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Cutoff"
                                Format="0.00" DefaultValue="1" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.08"
                                Display="{Binding Editor.Zampler.CutoffText}"
                                Value="{Binding Editor.Zampler.Cutoff}"
                                ToolTip.Tip="A four pole low pass, twenty four decibels an octave, as the SSM2045 in an Emulator II was." />

                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Resonance"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="0.98" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Zampler.Resonance}" />

                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Env amount"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Zampler.EnvelopeAmount}"
                                ToolTip.Tip="How far the filter's own envelope moves the cutoff, up to six octaves." />

                    <views:Switch views:PanelStrip.Span="3" TitleLines="2" Label="Env polarity"
                                  OnLabel="Close" OffLabel="Open"
                                  IsChecked="{Binding Editor.Zampler.EnvelopeInverted}" />

                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Key follow"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Zampler.KeyFollow}"
                                ToolTip.Tip="How much the cutoff rises with the keyboard, so the top does not go dull." />
                  </views:PanelStrip>
                  </views:PanelGroup>

                  <!-- Side by side, because they are the same four questions asked twice and
                       reading one against the other is how you set them. Framed rather than
                       headed, since two headings over two adjacent rows stop belonging to
                       either of them. -->
                  <StackPanel Orientation="Horizontal" Spacing="10">

                    <views:PanelGroup Caption="Filter envelope">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <views:Fader Label="Attack" Unit="ms" Format="0" DefaultValue="2"
                                     Minimum="0" Maximum="4000" SmallStep="1" LargeStep="25" TrackLength="76"
                                     Value="{Binding Editor.Zampler.FilterAttackMs}" />
                        <views:Fader Label="Decay" Unit="ms" Format="0" DefaultValue="300"
                                     Minimum="0" Maximum="8000" SmallStep="5" LargeStep="50" TrackLength="76"
                                     Value="{Binding Editor.Zampler.FilterDecayMs}" />
                        <views:Fader Label="Sustain" Format="0.00" DefaultValue="0.5"
                                     Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1" TrackLength="76"
                                     Value="{Binding Editor.Zampler.FilterSustain}" />
                        <views:Fader Label="Release" Unit="ms" Format="0" DefaultValue="200"
                                     Minimum="0" Maximum="8000" SmallStep="5" LargeStep="50" TrackLength="76"
                                     Value="{Binding Editor.Zampler.FilterReleaseMs}" />
                      </StackPanel>
                    </views:PanelGroup>

                    <views:PanelGroup Caption="Amplifier">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <views:Fader Label="Attack" Unit="ms" Format="0" DefaultValue="2"
                                     Minimum="0" Maximum="4000" SmallStep="1" LargeStep="25" TrackLength="76"
                                     Value="{Binding Editor.Zampler.AttackMs}" />
                        <views:Fader Label="Decay" Unit="ms" Format="0" DefaultValue="200"
                                     Minimum="0" Maximum="8000" SmallStep="5" LargeStep="50" TrackLength="76"
                                     Value="{Binding Editor.Zampler.DecayMs}" />
                        <views:Fader Label="Sustain" Format="0.00" DefaultValue="1"
                                     Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1" TrackLength="76"
                                     Value="{Binding Editor.Zampler.Sustain}" />
                        <views:Fader Label="Release" Unit="ms" Format="0" DefaultValue="160"
                                     Minimum="0" Maximum="8000" SmallStep="5" LargeStep="50" TrackLength="76"
                                     Value="{Binding Editor.Zampler.ReleaseMs}" />
                        <views:Fader Label="Level" Format="0.00" DefaultValue="1"
                                     Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1" TrackLength="76"
                                     Value="{Binding Editor.Zampler.Volume}" />
                      </StackPanel>
                    </views:PanelGroup>

                  </StackPanel>

                </StackPanel>
              </StackPanel>
            </StackPanel>

            <!-- BongaBong. Four rows of four, because that is the shape a hand knows: the
                 pads are where they are on every drum machine ever made, and the key each one
                 answers to runs across then down from C-4. A pad lights while it is sounding,
                 and they light together, since a crash goes on ringing under the snare. -->
            <StackPanel Spacing="12" IsVisible="{Binding Editor.IsBongaBong}">

              <StackPanel Orientation="Horizontal" Spacing="12">
                <views:PanelGroup Caption="Pads" VerticalAlignment="Top">
                <ItemsControl ItemsSource="{Binding Editor.Kit.Pads}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="4" Rows="4" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DrumPadViewModel">
                      <views:PushButton CapText="{Binding CapText}" Label="{Binding NoteText}"
                                        CapWidth="86" CapHeight="42" FontSize="11"
                                        Colour="#4A4E57" Margin="0,0,5,5"
                                        HasLamp="True" LampBelow="False" Lit="{Binding IsLit}"
                                        IsSelected="{Binding IsSelected}"
                                        Command="{Binding TapCommand}"
                                        ToolTip.Tip="Hits the pad. The key under it is the one that fires it in a pattern." />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                </views:PanelGroup>

                <!-- The pad in hand, and the keyboard under it. The keys are the pads by
                     another name, so they belong beside them rather than at the foot of the
                     panel: hitting a key and watching its pad answer is one glance, not two. -->
                <StackPanel Spacing="10" VerticalAlignment="Top">

                <views:PanelGroup Caption="Pad" VerticalAlignment="Top"
                                  IsVisible="{Binding Editor.Kit.HasPad}">
                <StackPanel Spacing="8">

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="150"
                              ItemsSource="{Binding Editor.Kit.Pads}"
                              SelectedItem="{Binding Editor.Kit.Selected}"
                              DisplayMemberBinding="{Binding CapText}"
                              ToolTip.Tip="Which pad the settings below are about." />

                    <Button Content="Clear" Click="ClearPadSample_Click"
                            ToolTip.Tip="Takes the recording off this pad." />

                    <Button Content="Load samples..." Click="ImportPads_Click"
                            ToolTip.Tip="Pick any number of samples from anywhere. They are copied into JingleBox and put on the pads in order, so the kit no longer depends on where they came from." />
                  </StackPanel>

                  <!-- The only way onto a pad, and deliberately: everything a machine plays is
                       one of your recordings, which means JingleBox owns every file a song
                       depends on. Bring anything else in on the RECORD tab first. -->
                  <!-- One button, and the shelf opens in a dialog with room to hunt in. On
                       the panel it costs the width of a button; the category, the search and
                       the list of takes all live in the dialog, where there is room for them. -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <views:TakePicker Takes="{Binding Editor.Takes}"
                                      Picked="PadRecording_Changed"
                                      ToolTip.Tip="Fetches one of your recordings onto this pad: search it by name or narrow it to a category. Anything from elsewhere is imported on the RECORD tab first." />

                    <TextBlock Classes="field" Text="Name" Margin="6,0,0,0" />
                    <TextBox Width="130" Text="{Binding Editor.Kit.Selected.Name}" />
                  </StackPanel>

                  <TextBlock Classes="cardHint" Text="{Binding Editor.Kit.Selected.FileText}"
                             TextTrimming="CharacterEllipsis" MaxWidth="260" />

                  <StackPanel Orientation="Horizontal" Spacing="14">
                    <views:Knob Label="Level" LabelAbove="True" Format="0.00" DefaultValue="1"
                                Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Kit.Selected.Volume}"
                                ToolTip.Tip="How loud this pad is, under the track's own level." />

                    <views:Knob Label="Pan" LabelAbove="True" Format="0.00" DefaultValue="0"
                                Minimum="-1" Maximum="1" SmallStep="0.02" LargeStep="0.2"
                                Value="{Binding Editor.Kit.Selected.Pan}"
                                ToolTip.Tip="Where this pad stands on the kit. The track's own pan is added to it." />

                    <views:Knob Label="Choke" LabelAbove="True" Format="0" DefaultValue="0"
                                Minimum="0" Maximum="8" SmallStep="1" LargeStep="1"
                                Value="{Binding Editor.Kit.Selected.Choke}"
                                ToolTip.Tip="Pads sharing a number cut each other off, which is what a closed hihat does to an open one. Nought is no group, which is most of a kit." />
                  </StackPanel>
                </StackPanel>
                </views:PanelGroup>

                <views:Clavier Octave="{Binding Octave}"
                               HorizontalAlignment="Left"
                               Lit="{Binding Sounding.Lit}"
                               Command="{Binding KeyCommand}"
                               ToolTip.Tip="Click the keys to play, or type them (Z to M, Q to P). A key lights while its pad is sounding, and the pad it belongs to is the one the settings above are about." />

                </StackPanel>
              </StackPanel>

              <views:SliceEditor Slices="{Binding Editor.Slices}" />

            </StackPanel>

            <!-- OddSkilla. The same controls it has always had, stood on a grid instead of
                 scattered across boxes: a knob is three cells and the wave switch is four, so
                 the rows line up down the panel even though nothing in them is the same width.
                 Reading a row left to right is reading the signal path.

                 The envelope is faders because an envelope is four times over the same
                 question, and four sliders answer it at a glance in a way four knobs never
                 do. -->
            <StackPanel Spacing="10" IsVisible="{Binding Editor.IsSynth}">

              <!-- What it is doing, drawn rather than described. -->
              <StackPanel Orientation="Horizontal" Spacing="16">
                <views:PanelGroup Caption="Shape">
                  <views:WaveScope Width="176" Height="60"
                                   Patch="{Binding Editor.Patch.Patch}"
                                   Revision="{Binding Editor.Patch.Revision}"
                                   Cycles="{Binding ScopeCycles}"
                                   Trigger="{Binding NoteTrigger}"
                                   ToolTip.Tip="A window of time onto the wave, with duty and drive applied. Tuning fits more or fewer cycles into it, and a played note bends it as the pitch envelope and vibrato do." />
                </views:PanelGroup>

                <views:PanelGroup Caption="Envelope">
                  <views:EnvelopeScope Width="176" Height="60"
                                       Patch="{Binding Editor.Patch.Patch}"
                                       Revision="{Binding Editor.Patch.Revision}"
                                       HoldSeconds="{Binding HoldSeconds}"
                                       Trigger="{Binding NoteTrigger}"
                                       ToolTip.Tip="The envelope, with the dashed line where the key is let go. Play a note and the playhead runs along it." />
                </views:PanelGroup>

                <views:Knob Label="Cycles" LabelAbove="True" Format="0" DefaultValue="2"
                            Minimum="1" Maximum="8" SmallStep="1" LargeStep="2"
                            VerticalAlignment="Bottom"
                            ToolTip.Tip="How much of the wave the view shows. A view setting: it is not part of the sound."
                            Value="{Binding ScopeCycles}" />
              </StackPanel>

              <views:PanelGroup Caption="Oscillator">
              <views:PanelStrip CellSize="26" Gap="4" Columns="4 3 3 3 3 3">
                <views:Switch views:PanelStrip.Span="4" TitleLines="2" Label="Wave"
                              ItemsSource="{Binding Editor.Patch.Waves}"
                              SelectedItem="{Binding Editor.Patch.Wave}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Duty"
                            Format="0.00" DefaultValue="0.5"
                            Minimum="0.05" Maximum="0.95" SmallStep="0.01" LargeStep="0.05"
                            IsEnabled="{Binding Editor.Patch.IsPulse}"
                            ToolTip.Tip="How far through the cycle a pulse turns over. Only a pulse has one, so it greys out on the other waves."
                            Value="{Binding Editor.Patch.Duty}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Tune"
                            Unit="st" Format="0" DefaultValue="0"
                            Minimum="-24" Maximum="24" SmallStep="1" LargeStep="12"
                            ToolTip.Tip="Whole semitones added to every note this instrument plays."
                            Value="{Binding Editor.Patch.TuneSemitones}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Fine"
                            Unit="c" Format="0" DefaultValue="0"
                            Minimum="-100" Maximum="100" SmallStep="1" LargeStep="10"
                            ToolTip.Tip="Hundredths of a semitone, for sitting this voice against another."
                            Value="{Binding Editor.Patch.FineCents}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Pitch env"
                            Unit="st" Format="0" DefaultValue="0"
                            Minimum="-24" Maximum="24" SmallStep="1" LargeStep="6"
                            ToolTip.Tip="How far the pitch starts away from the note. Negative drops into it, which is a kick drum."
                            Value="{Binding Editor.Patch.PitchEnvSemitones}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Pitch time"
                            Unit="ms" Format="0" DefaultValue="60"
                            Minimum="0" Maximum="2000" SmallStep="5" LargeStep="50"
                            ToolTip.Tip="How long that pitch offset takes to arrive at the note."
                            Value="{Binding Editor.Patch.PitchEnvMs}" />
              </views:PanelStrip>
              </views:PanelGroup>

              <views:PanelGroup Caption="Amplifier">
              <views:PanelStrip CellSize="26" Gap="4" Columns="4 3 3 3 3 3">
                <views:Fader views:PanelStrip.Span="4" Label="Attack" Unit="ms" Format="0" DefaultValue="2"
                             Minimum="0" Maximum="2000" SmallStep="1" LargeStep="25"
                             TrackLength="86"
                             Value="{Binding Editor.Patch.AttackMs}" />

                <views:Fader views:PanelStrip.Span="3" Label="Decay" Unit="ms" Format="0" DefaultValue="40"
                             Minimum="0" Maximum="5000" SmallStep="5" LargeStep="50"
                             TrackLength="86"
                             Value="{Binding Editor.Patch.DecayMs}" />

                <views:Fader views:PanelStrip.Span="3" Label="Sustain" Format="0.00" DefaultValue="0.6"
                             Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                             TrackLength="86"
                             Value="{Binding Editor.Patch.Sustain}" />

                <views:Fader views:PanelStrip.Span="3" Label="Release" Unit="ms" Format="0" DefaultValue="80"
                             Minimum="0" Maximum="5000" SmallStep="5" LargeStep="50"
                             TrackLength="86"
                             Value="{Binding Editor.Patch.ReleaseMs}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Drive"
                            Format="0.0" DefaultValue="1"
                            Minimum="1" Maximum="10" SmallStep="0.1" LargeStep="1"
                            ToolTip.Tip="Rounds the wave off into itself: fuller and harder, at the same level."
                            Value="{Binding Editor.Patch.Drive}" />

                <views:Fader views:PanelStrip.Span="3" Label="Level" Unit=" dB" Format="0.0" DefaultValue="0"
                             Minimum="-60" Maximum="6" SmallStep="0.5" LargeStep="3"
                             TrackLength="86"
                             Ticks="6,0,-12,-40"
                             ToolTip.Tip="Unity is 0 dB, and above it is makeup gain."
                             Value="{Binding Editor.VolumeDecibels}" />
              </views:PanelStrip>
              </views:PanelGroup>

              <views:PanelGroup Caption="Filter and modulation">
              <views:PanelStrip CellSize="26" Gap="4" Columns="4 3 3 3 3 3">
                <views:Knob views:PanelStrip.Span="4" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Cutoff"
                            Format="0.00" DefaultValue="1"
                            Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.08"
                            Display="{Binding Editor.Patch.FilterCutoffText}"
                            ToolTip.Tip="A low pass. Wide open at the top, where it does nothing at all."
                            Value="{Binding Editor.Patch.FilterCutoff}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Resonance"
                            Format="0.00" DefaultValue="0"
                            Minimum="0" Maximum="0.98" SmallStep="0.01" LargeStep="0.1"
                            ToolTip.Tip="How much the filter rings at its cutoff."
                            Value="{Binding Editor.Patch.FilterResonance}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Vib rate"
                            Unit="Hz" Format="0.0" DefaultValue="0"
                            Minimum="0" Maximum="20" SmallStep="0.1" LargeStep="1"
                            ToolTip.Tip="How fast the pitch wavers."
                            Value="{Binding Editor.Patch.VibratoRateHz}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Vib depth"
                            Unit="c" Format="0" DefaultValue="0"
                            Minimum="0" Maximum="200" SmallStep="1" LargeStep="10"
                            ToolTip.Tip="How far it wavers, in hundredths of a semitone."
                            Value="{Binding Editor.Patch.VibratoDepthCents}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Trem rate"
                            Unit="Hz" Format="0.0" DefaultValue="0"
                            Minimum="0" Maximum="20" SmallStep="0.1" LargeStep="1"
                            ToolTip.Tip="How fast the level wavers."
                            Value="{Binding Editor.Patch.TremoloRateHz}" />

                <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Trem depth"
                            Format="0.00" DefaultValue="0"
                            Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                            ToolTip.Tip="How far it wavers, as a fraction of full level."
                            Value="{Binding Editor.Patch.TremoloDepth}" />
              </views:PanelStrip>
              </views:PanelGroup>
            </StackPanel>

            <!-- Ouroboros. Everything stands on one grid: a knob is three cells, a toggle two,
                 so the rows line up down the panel even though nothing in them is the same
                 width. Reading a row left to right is reading the signal path. -->
            <StackPanel Spacing="10" IsVisible="{Binding Editor.IsOuroboros}">

              <!-- Two rows, and the difference between them is the whole layout. The top one
                   is the signal path in the order the sound goes through it: oscillator, mixer,
                   filter, amplifier. The bottom one is everything that moves what is above.

                   Every group holds a single row of controls, so none of them has a half-empty
                   second line, and the two mod groups are named for what they move rather than
                   sitting inside the stage they belong to, where they made those groups twice
                   the height of the others. -->

              <StackPanel Orientation="Horizontal" Spacing="10">

                <views:PanelGroup Caption="Oscillator" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 3 2 3 3">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Frequency"
                                Unit="st" Format="0" DefaultValue="0" Minimum="-24" Maximum="24" SmallStep="1" LargeStep="12"
                                Value="{Binding Editor.Ouroboros.TuneSemitones}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Fine"
                                Unit="c" Format="0" DefaultValue="0" Minimum="-100" Maximum="100" SmallStep="1" LargeStep="10"
                                Value="{Binding Editor.Ouroboros.FineCents}" />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Wave"
                                  ItemsSource="{Binding Editor.Ouroboros.Waves}"
                                  SelectedItem="{Binding Editor.Ouroboros.Wave}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Pulse width"
                                Format="0.00" DefaultValue="0.5" Minimum="0.02" Maximum="0.98" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Ouroboros.PulseWidth}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Glide"
                                Unit="ms" Format="0" DefaultValue="0" Minimum="0" Maximum="2000" SmallStep="5" LargeStep="50" ToolTip.Tip="How long a note takes to slide from the one before it. Zero is off."
                                Value="{Binding Editor.Ouroboros.GlideMs}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="Mixer" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Mix"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1" ToolTip.Tip="Nought is all oscillator, one is all noise, and between them is both."
                                Value="{Binding Editor.Ouroboros.NoiseMix}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="Filter" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 3 2">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Cutoff"
                                Format="0" DefaultValue="12000" Minimum="20" Maximum="20000" SmallStep="50" LargeStep="500" Display="{Binding Editor.Ouroboros.CutoffText}"
                                Value="{Binding Editor.Ouroboros.CutoffHz}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Resonance"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="0.98" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Ouroboros.Resonance}" />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Mode"
                                  ItemsSource="{Binding Editor.Ouroboros.FilterModes}"
                                  SelectedItem="{Binding Editor.Ouroboros.FilterMode}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="Amplifier" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="2 3">
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Amp" OnLabel="Envelope" OffLabel="Open"
                                  IsChecked="{Binding Editor.Ouroboros.EnvelopeToAmp}"
                                  ToolTip.Tip="Open, a note is simply on at full and the envelope only moves what it is pointed at." />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Volume"
                                Format="0.00" DefaultValue="0.5" Minimum="0" Maximum="2" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Ouroboros.Volume}" />
                  </views:PanelStrip>
                </views:PanelGroup>

              </StackPanel>

              <StackPanel Orientation="Horizontal" Spacing="10">

                <views:PanelGroup Caption="Envelope" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 2 3">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Attack"
                                Unit="ms" Format="0" DefaultValue="2" Minimum="0" Maximum="4000" SmallStep="1" LargeStep="50"
                                Value="{Binding Editor.Ouroboros.AttackMs}" />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Sustain" OnLabel="Hold" OffLabel="Decay"
                                  IsChecked="{Binding Editor.Ouroboros.Sustain}"
                                  ToolTip.Tip="Hold, the note stays until it is let go. Decay, it falls away and stays gone." />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Decay"
                                Unit="ms" Format="0" DefaultValue="300" Minimum="0" Maximum="8000" SmallStep="5" LargeStep="100"
                                Value="{Binding Editor.Ouroboros.DecayMs}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="LFO" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="3 2 2">
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Rate"
                                Unit="Hz" Format="0.00" DefaultValue="5" Minimum="0.01" Maximum="100" SmallStep="0.1" LargeStep="1"
                                Value="{Binding Editor.Ouroboros.LfoRateHz}" />
                    <views:Led views:PanelStrip.Span="2" Label="rate"
                               IsLit="{Binding Editor.Ouroboros.LfoLit}"
                               VerticalAlignment="Center" Margin="0,46,0,0"
                               ToolTip.Tip="Goes round at the rate beside it, so the number can be seen as well as read. It runs whether or not a note is playing, which is when the rate is being set." />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Wave"
                                  ItemsSource="{Binding Editor.Ouroboros.LfoWaves}"
                                  SelectedItem="{Binding Editor.Ouroboros.LfoWave}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="Moves the oscillator" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="2 3 2">
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Source"
                                  ItemsSource="{Binding Editor.Ouroboros.ModSources}"
                                  SelectedItem="{Binding Editor.Ouroboros.VcoModSource}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Amount"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Ouroboros.VcoModAmount}" />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="What"
                                  ItemsSource="{Binding Editor.Ouroboros.VcoModTargets}"
                                  SelectedItem="{Binding Editor.Ouroboros.VcoModTarget}" />
                  </views:PanelStrip>
                </views:PanelGroup>

                <views:PanelGroup Caption="Moves the filter" VerticalAlignment="Top">
                  <views:PanelStrip CellSize="26" Gap="4" Columns="2 3 2">
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Source"
                                  ItemsSource="{Binding Editor.Ouroboros.ModSources}"
                                  SelectedItem="{Binding Editor.Ouroboros.VcfModSource}" />
                    <views:Knob views:PanelStrip.Span="3" LabelAbove="True" LabelLines="2" HeadRoom="50" Ticks="11" DialSize="40" Label="Amount"
                                Format="0.00" DefaultValue="0" Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Ouroboros.VcfModAmount}" />
                    <views:Switch views:PanelStrip.Span="2" TitleLines="2" Label="Polarity" OnLabel="Close" OffLabel="Open"
                                  IsChecked="{Binding Editor.Ouroboros.VcfModInverted}"
                                  ToolTip.Tip="Which way the modulation moves the filter." />
                  </views:PanelStrip>
                </views:PanelGroup>

              </StackPanel>

            </StackPanel>

            <!-- The voice: the same chain whether the source is a recording or a wave, so this
                 row is shown for both. A plugin has none of it, because the plugin does its own
                 envelope and its own everything else; and neither has Ouroboros, which brings
                 its own above rather than sharing this one. -->
            <WrapPanel Orientation="Horizontal" IsVisible="{Binding Editor.HasCommonVoice}">

              <views:PanelGroup Caption="Shape" VerticalAlignment="Top" IsVisible="{Binding Editor.IsSynth}" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <views:WaveScope Width="150" Height="58"
                                   Patch="{Binding Editor.Patch.Patch}"
                                   Revision="{Binding Editor.Patch.Revision}"
                                   Cycles="{Binding ScopeCycles}"
                                   Trigger="{Binding NoteTrigger}"
                                   ToolTip.Tip="A window of time onto the wave, with duty and drive applied. Tuning fits more or fewer cycles into it, and a played note bends it as the pitch envelope and vibrato do." />

                  <views:Knob Label="Cycles" Format="0" DefaultValue="2"
                              Minimum="1" Maximum="8" SmallStep="1" LargeStep="2"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="How much of the wave the view shows. A view setting: it is not part of the sound."
                              Value="{Binding ScopeCycles}" />
                </StackPanel>
              </views:PanelGroup>

              <views:PanelGroup Caption="Envelope" VerticalAlignment="Top" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <StackPanel Orientation="Horizontal" Spacing="12">
                    <views:EnvelopeScope Width="150" Height="58"
                                         VerticalAlignment="Top"
                                         Patch="{Binding Editor.Patch.Patch}"
                                         Revision="{Binding Editor.Patch.Revision}"
                                         HoldSeconds="{Binding HoldSeconds}"
                                         Trigger="{Binding NoteTrigger}"
                                         ToolTip.Tip="The envelope, with the dashed line where the key is let go. Play a note and the playhead runs along it." />

                    <views:Fader Label="Attack" Unit="ms" Format="0" DefaultValue="2"
                                 Minimum="0" Maximum="2000" SmallStep="1" LargeStep="25"
                                 TrackLength="96"
                                 Value="{Binding Editor.Patch.AttackMs}" />

                    <views:Fader Label="Decay" Unit="ms" Format="0" DefaultValue="40"
                                 Minimum="0" Maximum="5000" SmallStep="5" LargeStep="50"
                                 TrackLength="96"
                                 Value="{Binding Editor.Patch.DecayMs}" />

                    <views:Fader Label="Sustain" Format="0.00" DefaultValue="0.6"
                                 Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                 TrackLength="96"
                                 Value="{Binding Editor.Patch.Sustain}" />

                    <views:Fader Label="Release" Unit="ms" Format="0" DefaultValue="80"
                                 Minimum="0" Maximum="5000" SmallStep="5" LargeStep="50"
                                 TrackLength="96"
                                 Value="{Binding Editor.Patch.ReleaseMs}" />
                  </StackPanel>
                </StackPanel>
              </views:PanelGroup>

              <views:PanelGroup Caption="Pitch and modulation" VerticalAlignment="Top" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <UniformGrid Columns="4" Rows="2">
                    <views:Knob Label="Tune" Unit="st" Format="0" DefaultValue="0"
                                Minimum="-24" Maximum="24" SmallStep="1" LargeStep="12"
                                Margin="0,0,10,8"
                                ToolTip.Tip="Whole semitones added to every note this instrument plays."
                                Value="{Binding Editor.Patch.TuneSemitones}" />

                    <views:Knob Label="Fine" Unit="c" Format="0" DefaultValue="0"
                                Minimum="-100" Maximum="100" SmallStep="1" LargeStep="10"
                                Margin="0,0,10,8"
                                ToolTip.Tip="Hundredths of a semitone, for sitting this voice against another."
                                Value="{Binding Editor.Patch.FineCents}" />

                    <views:Knob Label="Vib rate" Unit="Hz" Format="0.0" DefaultValue="0"
                                Minimum="0" Maximum="20" SmallStep="0.1" LargeStep="1"
                                Margin="0,0,10,8"
                                Value="{Binding Editor.Patch.VibratoRateHz}" />

                    <views:Knob Label="Vib depth" Unit="c" Format="0" DefaultValue="0"
                                Minimum="0" Maximum="200" SmallStep="1" LargeStep="10"
                                Margin="0,0,0,8"
                                Value="{Binding Editor.Patch.VibratoDepthCents}" />

                    <views:Knob Label="Pitch env" Unit="st" Format="0" DefaultValue="0"
                                Minimum="-24" Maximum="24" SmallStep="1" LargeStep="6"
                                Margin="0,0,10,0"
                                Value="{Binding Editor.Patch.PitchEnvSemitones}" />

                    <views:Knob Label="Pitch time" Unit="ms" Format="0" DefaultValue="60"
                                Minimum="0" Maximum="2000" SmallStep="5" LargeStep="50"
                                Margin="0,0,10,0"
                                Value="{Binding Editor.Patch.PitchEnvMs}" />

                    <views:Knob Label="Trem rate" Unit="Hz" Format="0.0" DefaultValue="0"
                                Minimum="0" Maximum="20" SmallStep="0.1" LargeStep="1"
                                Margin="0,0,10,0"
                                Value="{Binding Editor.Patch.TremoloRateHz}" />

                    <views:Knob Label="Trem depth" Format="0.00" DefaultValue="0"
                                Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.1"
                                Value="{Binding Editor.Patch.TremoloDepth}" />
                  </UniformGrid>
                </StackPanel>
              </views:PanelGroup>

              <views:PanelGroup Caption="Filter" VerticalAlignment="Top" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <StackPanel Orientation="Horizontal" Spacing="12">
                    <views:Knob Label="Cutoff" Format="0.00" DefaultValue="1"
                                Minimum="0" Maximum="1" SmallStep="0.01" LargeStep="0.08"
                                Display="{Binding Editor.Patch.FilterCutoffText}"
                                ToolTip.Tip="A low pass. Wide open at the top, where it does nothing at all."
                                Value="{Binding Editor.Patch.FilterCutoff}" />

                    <views:Knob Label="Resonance" Format="0.00" DefaultValue="0"
                                Minimum="0" Maximum="0.98" SmallStep="0.01" LargeStep="0.1"
                                ToolTip.Tip="How much the filter rings at its cutoff."
                                Value="{Binding Editor.Patch.FilterResonance}" />
                  </StackPanel>
                </StackPanel>
              </views:PanelGroup>

              <views:PanelGroup Caption="Output" VerticalAlignment="Top" Margin="0,0,10,10">
                <StackPanel Spacing="6">
  <StackPanel Orientation="Horizontal" Spacing="12">
                    <views:Fader Label="Level" Unit=" dB" Format="0.0" DefaultValue="0"
                                 Minimum="-60" Maximum="6" SmallStep="0.5" LargeStep="3"
                                 TrackLength="96"
                                 Ticks="6,0,-12,-40"
                                 ToolTip.Tip="Unity is 0 dB, and above it is makeup gain."
                                 Value="{Binding Editor.VolumeDecibels}" />

                    <StackPanel Spacing="8" VerticalAlignment="Top">
                      <views:Knob Label="Drive" Format="0.0" DefaultValue="1"
                                  Minimum="1" Maximum="10" SmallStep="0.1" LargeStep="1"
                                  ToolTip.Tip="Rounds the wave off into itself: fuller and harder, at the same level."
                                  Value="{Binding Editor.Patch.Drive}" />

                      <views:Knob Label="Duty" Format="0.00" DefaultValue="0.5"
                                  Minimum="0.05" Maximum="0.95" SmallStep="0.01" LargeStep="0.05"
                                  IsEnabled="{Binding Editor.Patch.IsPulse}"
                                  ToolTip.Tip="How far through the cycle a pulse turns over. Only a pulse has one, so it greys out on the other waves."
                                  Value="{Binding Editor.Patch.Duty}" />
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </views:PanelGroup>
            </WrapPanel>

            <!-- The keyboard, at the foot where a keyboard goes, and the same on every panel.
                 It plays, it shows what is playing, and it carries its own octave: the lamps
                 are not a setting beside the keys, they are where the keys are looking. -->
            <views:Clavier Octave="{Binding Octave}"
                           HorizontalAlignment="Left"
                           Margin="0,14,0,0"
                           IsVisible="{Binding !Editor.IsBongaBong}"
                           Lit="{Binding Sounding.Lit}"
                           Command="{Binding KeyCommand}"
                           ToolTip.Tip="Click the keys to play, or type them (Z to M, Q to P). A key lights while its note is sounding, whether you played it or the pattern did. The arrows and the lamps move the three octaves on show, and it follows a note played outside them." />

    </StackPanel>
  </ScrollViewer>
</UserControl>
