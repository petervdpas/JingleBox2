<!-- ===============================
     Views/ConfigView.axaml
     =============================== -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.ConfigView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="Border.padCard">
      <Setter Property="Background" Value="#141414"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="Margin" Value="10"/>
    </Style>

    <Style Selector="Button.danger">
      <Setter Property="Background" Value="#3A1E1E"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="0,16,0,0">

    <!-- PROFILE BAR -->
    <Border DockPanel.Dock="Top"
            Background="#101010"
            BorderBrush="#2A2A2A"
            BorderThickness="1"
            CornerRadius="12"
            Padding="12"
            Margin="0,0,0,12">

      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="10"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">

        <ComboBox Grid.Row="0" Grid.Column="0"
                  ItemsSource="{Binding ProfileNames}"
                  SelectedItem="{Binding SelectedProfileName}"
                  HorizontalAlignment="Stretch"/>

        <Button Grid.Row="0" Grid.Column="1"
                Content="Delete"
                Classes="danger"
                Command="{Binding DeleteProfileCommand}"/>

        <TextBox Grid.Row="1" Grid.Column="0"
                 Watermark="New profile name"
                 Text="{Binding NewProfileName}"/>

        <Button Grid.Row="1" Grid.Column="1"
                Content="Add"
                Command="{Binding AddProfileCommand}"/>
      </Grid>
    </Border>

    <!-- PAD CONFIG LIST -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,28,0">

      <ItemsControl ItemsSource="{Binding Pads}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadViewModel">
            <Border Classes="padCard">
              <StackPanel Spacing="12">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <TextBox Grid.Column="0"
                           Watermark="Pad name"
                           Text="{Binding Name}" />

                  <ComboBox Grid.Column="1"
                            Width="140"
                            ItemsSource="{x:Static vm:PadViewModel.SourceKinds}"
                            SelectedItem="{Binding SourceKind}" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10"
                      IsVisible="{Binding IsFile}">
                  <TextBox Grid.Column="0"
                           Watermark="Choose an audio file…"
                           Text="{Binding FilePath}" />
                  <Button Grid.Column="1"
                          Content="Browse…"
                          Command="{Binding AssignCommand}" />
                </Grid>

                <TextBox IsVisible="{Binding IsWeb}"
                         Watermark="Stream URL (https://...)"
                         Text="{Binding FilePath}" />

                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="6">

                  <StackPanel Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2">
                    <TextBlock FontSize="12"
                               Opacity="0.75"
                               Text="Volume" />
                    <Slider Minimum="0"
                            Maximum="1"
                            Value="{Binding Volume}"
                            LargeChange="0.1"
                            SmallChange="0.01" />
                  </StackPanel>

                  <TextBlock Grid.Row="1"
                             Grid.Column="0"
                             VerticalAlignment="Center"
                             Opacity="0.75"
                             Text="{Binding Volume, StringFormat={}{0:0.00}}" />

                  <StackPanel Grid.Row="1"
                              Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="8"
                              HorizontalAlignment="Right">
                    <Button Content="Test"
                            Command="{Binding PlayCommand}" />
                    <Button Content="Stop"
                            Command="{Binding StopCommand}" />
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Classes="danger" />
                  </StackPanel>
                </Grid>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </ScrollViewer>
  </DockPanel>
</UserControl>
