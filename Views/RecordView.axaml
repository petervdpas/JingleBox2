<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             x:Class="JingleBox2.Views.RecordView"
             x:DataType="vm:RecordViewModel">

  <!-- Rows rather than one long scroll. The two cards at the top are whatever height they
       need, and the shelf takes what is left and scrolls inside itself.

       A list inside a scrolling page is given no height to fit into, so it grows to the height
       of every row it holds and the page grows with it. At two thousand takes that page is
       eight hundred thousand pixels tall: the scrollbar is a hairline, the top cards scroll
       away as you look through the list, and the list cannot be scrolled on its own at all.
       Given a row of its own it stays the size of the window whatever the shelf holds. -->
  <Grid RowDefinitions="Auto,Auto,Auto,*" Classes="tabRoot">

    <!-- Recording Controls -->
      <Border Grid.Row="0" Classes="card" Margin="0,0,0,12">
        <!-- The gain sits down the right, where a desk keeps it: the controls that start and
             stop a take belong together, and the fader belongs next to the meter it feeds. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="12">
          <!-- Only on a system with a graph to patch; elsewhere the input is whatever the
               device picker in SETTINGS chose. -->
          <StackPanel Spacing="4" IsVisible="{Binding IsRoutingAvailable}">
            <TextBlock Text="Capture from" Opacity="0.8" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding Routes}"
                        SelectedItem="{Binding SelectedRoute}"
                        DisplayMemberBinding="{Binding Display}"
                        HorizontalAlignment="Stretch"
                        DropDownOpened="Routes_DropDownOpened"
                        PlaceholderText="Whatever the system chose" />
              <Button Grid.Column="1" Content="Refresh"
                      Command="{Binding RefreshRoutesCommand}"
                      ToolTip.Tip="Programs only appear while they are playing something." />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="🔴 Record"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StartRecordingCommand}"
                    IsEnabled="{Binding CanRecord}" />
            <Button Content="⏹ Stop"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StopRecordingCommand}"
                    IsEnabled="{Binding IsRecording}" />

            <!-- The other way onto the shelf. Beside Record because these are the two of them,
                 and here rather than on the list below, which is not there to be clicked when
                 the shelf is still empty. -->
            <Button Content="Import..."
                    MinWidth="96" Padding="10,5"
                    Margin="12,0,0,0"
                    Click="Import_Click"
                    ToolTip.Tip="Bring recordings onto the shelf. Anything that is not already a 16-bit WAV is converted into one on the way in." />
          </StackPanel>

          <!-- Drawn rather than bound to a string, because a clock with thousandths on it moves
               twenty times a second and a control that draws one piece of lettering is the whole
               of what should be invalidated when it does. -->
          <views:TimeReadout Time="{Binding RecordingTime}"
                             ReadingSize="24"
                             HorizontalAlignment="Center" />

          <!-- The same slot the tracker and the pads use, pointed at the recorder. What is on it
               is applied to the take after it has been captured rather than on the way in, so a
               plugin taking a moment cannot put a hole in the only copy of a performance, and
               the capture as it arrived is kept beside the take whenever there is anything here.
               See ITakeEffects. -->
          <StackPanel Spacing="4">
            <TextBlock Text="Record through" Opacity="0.8" />
            <views:PluginStrip DataContext="{Binding Effect}" />
          </StackPanel>

        </StackPanel>

        <!-- The gain and what it is doing, side by side, the way a channel strip has them. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <ui:Fader Label="Input gain" Unit=" dB" Format="0.0" DefaultValue="0"
                       Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}"
                       SmallStep="0.5" LargeStep="3"
                       TrackLength="150"
                       Ticks="12,6,0,-6,-12,-24"
                       ToolTip.Tip="Drag it, or use the wheel and the arrow keys. Double click for 0 dB."
                       Value="{Binding RecordGainDb}" />

          <StackPanel Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="CLIP" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                         Classes="cliptext" Classes.clipping="{Binding IsClipping}" />
              <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                      Classes="cliplight" Classes.clipping="{Binding IsClipping}" />
            </StackPanel>

            <ui:LevelMeter Width="26" Height="150"
                              Stereo="{Binding IsStereoInput}"
                              Left="{Binding LevelLeft}"
                              Right="{Binding LevelRight}"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="Peak level, left and right. Accent to -6 dB, amber to -1, red above." />
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>

      <!-- The take that has just been made, and it is a card of its own on purpose. A take
           nobody has named is not on the shelf: not in the list, not under the search box and
           not filed anywhere. Here it is played, named and kept, or thrown away. See
           ITakeScratch. -->
      <Border Grid.Row="1" Classes="card" Margin="0,0,0,12"
              IsVisible="{Binding HasScratch}">
        <StackPanel Classes="cardBody">
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0" Classes="cardTitle" Text="Scratchpad"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1" Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                       Text="{Binding ScratchShown.DurationMs, StringFormat='{}{0}ms'}" />

            <!-- Which of the two the card is about. Only where a chain made two of them, since
                 with nothing on the chain there is one take and a picker with one row on it is
                 a control that says nothing. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center"
                        IsVisible="{Binding ScratchHasClean}">
              <RadioButton Content="Through the chain" GroupName="scratchVersion"
                           IsChecked="{Binding !ScratchShowsClean}" />
              <RadioButton Content="Clean" GroupName="scratchVersion" Margin="8,0,0,0"
                           IsChecked="{Binding ScratchShowsClean}" />
            </StackPanel>
          </Grid>

          <Border Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <ui:WaveformView Height="120"
                             Peaks="{Binding ScratchWaveform.PeakData}"
                             Playhead="{Binding ScratchPlayhead}"
                             ShowMarkers="False"
                             ShowLoop="False"
                             Placeholder="Nothing recorded yet" />
          </Border>

          <!-- The name and the two answers. The name box lives here rather than over the Record
               button because naming is what saving is: nothing is written under a name until
               this is pressed, and until then the take is disposable. -->
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
            <Button Grid.Column="0" Content="▶" MinWidth="36" Padding="6,5" FontSize="12"
                    IsEnabled="{Binding !ScratchShown.IsPlaying}"
                    Command="{Binding PlayRecordingCommand}"
                    CommandParameter="{Binding ScratchShown}"
                    ToolTip.Tip="Play what was just recorded" />
            <Button Grid.Column="1" Content="■" MinWidth="36" Padding="6,5" FontSize="12"
                    IsEnabled="{Binding ScratchShown.IsPlaying}"
                    Command="{Binding StopRecordingPlaybackCommand}"
                    CommandParameter="{Binding ScratchShown}"
                    ToolTip.Tip="Stop playing" />

            <TextBox Grid.Column="2" Margin="6,0,0,0"
                     Text="{Binding RecordingName}"
                     PlaceholderText="Name this take"
                     Classes.invalid="{Binding HasNameError}" />

            <Button Grid.Column="3" Content="Save" MinWidth="80" Padding="10,5"
                    Classes="save"
                    IsEnabled="{Binding CanSaveTake}"
                    Command="{Binding SaveTakeCommand}"
                    ToolTip.Tip="Keep this take on the shelf under that name." />
            <Button Grid.Column="4" Content="Throw away" MinWidth="96" Padding="10,5"
                    Classes="danger"
                    Command="{Binding DiscardTakeCommand}"
                    ToolTip.Tip="Delete it. Recording again does this too, and so does closing the application." />
          </Grid>

          <TextBlock Text="{Binding NameError}"
                     IsVisible="{Binding HasNameError}"
                     Foreground="{DynamicResource DangerBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- The take that is picked: its picture, and everything you can do to it. -->
      <Border Grid.Row="2" Classes="card" Margin="0,0,0,12"
              IsVisible="{Binding SelectedRecording, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Classes="cardBody">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="cardTitle" Text="{Binding SelectedRecording.Name}" />
              <TextBlock Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                         Text="{Binding SelectedRecording.DurationMs, StringFormat='{}{0}ms'}" />
            </StackPanel>

            <!-- What it is filed under, on the line that says what it is. Typed rather than
                 picked from a list, because a category is made by naming one; what has been
                 named already drops down as you type so the second saxophone goes where the
                 first one went. Said out loud on Enter or on leaving the box. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <TextBlock Text="Category" Opacity="0.8" VerticalAlignment="Center" />
              <views:CategoryField Width="200"
                                   ItemsSource="{Binding Shelf.Categories}"
                                   Text="{Binding TakeCategory}"
                                   ToolTip.Tip="Type a category to file this take under. Empty it to unfile it." />
            </StackPanel>
          </Grid>

          <!-- The picture sits on the page's own colour rather than the card's, the way the
               slice editor's does, so it reads as a window cut into the card. -->
          <Border Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <!-- The one waveform control, the same one a machine's face draws its take with,
                 rather than a canvas of this page's own. It was drawn here by hand and so had
                 no play cursor: the position was arriving from the player and nothing put it on
                 the screen. Read only here, since trimming is what Edit is for. -->
            <ui:WaveformView Height="120"
                             Peaks="{Binding CurrentWaveform.PeakData}"
                             Playhead="{Binding Playhead}"
                             ShowMarkers="False"
                             ShowLoop="False"
                             Placeholder="No recording picked" />
          </Border>

          <!-- Under the picture, where they act on the take you are looking at. On the rows
               they were four buttons apiece to read past while looking for a name. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.7" FontSize="12"
                       Text="{Binding CurrentWaveform.TotalSamples, StringFormat='Samples: {0}'}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Content="▶" MinWidth="36" Padding="6,5" FontSize="12"
                      IsEnabled="{Binding !SelectedRecording.IsPlaying}"
                      Command="{Binding PlayRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}"
                      ToolTip.Tip="Play this recording" />
              <Button Content="■" MinWidth="36" Padding="6,5" FontSize="12"
                      IsEnabled="{Binding SelectedRecording.IsPlaying}"
                      Command="{Binding StopRecordingPlaybackCommand}"
                      CommandParameter="{Binding SelectedRecording}"
                      ToolTip.Tip="Stop playing" />

              <Button Content="Edit" MinWidth="64" Padding="10,5"
                      Command="{Binding EditRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}" />
              <Button Content="Delete" MinWidth="64" Padding="10,5" Classes="danger"
                      IsEnabled="{Binding !SelectedRecording.IsInUse}"
                      ToolTip.Tip="{Binding SelectedRecording.UsedBy, StringFormat='In use by {0}. Delete the instrument first.'}"
                      Command="{Binding DeleteRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Recordings Library -->
      <Border Grid.Row="3" Classes="card" IsVisible="{Binding Recordings.Count}">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,220,Auto" ColumnSpacing="8" Margin="0,0,0,8">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Classes="cardTitle" Text="Recordings" VerticalAlignment="Center" />
              <views:HelpBadge Topic="record.takes" />
            </StackPanel>

            <!-- Only while something is hidden, since "10 of 10" is a line about nothing. -->
            <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                       Text="{Binding Shelf.Showing}" />

            <!-- Before the category, because the two narrow together and this is the one you
                 reach for first: a category is which shelf, a name is which take. -->
            <TextBox Grid.Column="2" Text="{Binding Shelf.Search}"
                     PlaceholderText="Search by name..."
                     ToolTip.Tip="Show only the takes whose name has this in it, inside whichever category is picked." />

            <ComboBox Grid.Column="3" MinWidth="170"
                      ItemsSource="{Binding Shelf.Filters}"
                      SelectedItem="{Binding Shelf.Filter}"
                      ToolTip.Tip="Narrow the shelf to one category, or to the takes nobody has put in one yet." />
          </Grid>

          <!-- A list you pick from, rather than a stack of little control panels. What a row
               says is what the take is; what you do to it is under its picture above. -->
          <ListBox Classes="cards"
                   ItemsSource="{Binding Shelf.Shown}"
                   SelectedItem="{Binding SelectedRecording}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />

                  <!-- A sample instrument plays this file itself, so a recording that is spoken
                       for is tagged. Up in the corner rather than beside the name: it belongs
                       to the whole row, and a name is not a place to hang a second thing off. -->
                  <Border Grid.Row="0" Grid.Column="1"
                          Classes="badge" MaxWidth="220"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          IsVisible="{Binding IsInUse}"
                          ToolTip.Tip="{Binding UsedBy, StringFormat='Used by {0}. Delete the instrument first.'}">
                    <TextBlock Text="{Binding UsedBy, StringFormat='USED BY {0}'}"
                               TextTrimming="CharacterEllipsis" />
                  </Border>

                  <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.7" FontSize="12"
                             Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.7" FontSize="12"
                             Text="{Binding DurationMs, StringFormat='Duration: {0}ms'}" />

                  <!-- Down in the other corner from the usage badge: two things about the row,
                       neither of them hanging off the name. -->
                  <Border Grid.Row="2" Grid.Column="1"
                          Classes="badge filed" MaxWidth="220"
                          HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          IsVisible="{Binding HasCategory}">
                    <TextBlock Text="{Binding Category}" TextTrimming="CharacterEllipsis" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

  </Grid>

</UserControl>
