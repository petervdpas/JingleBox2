<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.RecordView"
             x:DataType="vm:RecordViewModel">

  <ScrollViewer>
    <StackPanel Classes="tabRoot">

      <!-- Recording Controls -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Spacing="4">
            <TextBlock Text="Recording Name" Opacity="0.8" />
            <TextBox Text="{Binding RecordingName}"
                     Classes.invalid="{Binding HasNameError}" />
            <TextBlock Text="{Binding NameError}"
                       IsVisible="{Binding HasNameError}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="🔴 Record"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StartRecordingCommand}"
                    IsEnabled="{Binding CanRecord}" />
            <Button Content="⏹ Stop"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StopRecordingCommand}"
                    IsEnabled="{Binding IsRecording}" />
          </StackPanel>

          <TextBlock Text="{Binding RecordingTime}"
                     FontSize="24"
                     Foreground="#FF6B7280"
                     HorizontalAlignment="Center" />

          <!-- Input Gain -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="Input Gain" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding RecordGainDb, StringFormat='{}{0:0.0} dB'}"
                         Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
            </Grid>
            <Slider Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}"
                    Value="{Binding RecordGainDb}" TickFrequency="6" />
          </StackPanel>

          <!-- Level Meter -->
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Grid.Column="0" Text="Level" Opacity="0.8" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="CLIP" FontSize="10" FontWeight="SemiBold"
                         Margin="0,0,6,0" VerticalAlignment="Center"
                         Classes="cliptext" Classes.clipping="{Binding IsClipping}" />
              <Border Grid.Column="3" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                      Classes="cliplight" Classes.clipping="{Binding IsClipping}" />
            </Grid>
            <ProgressBar Value="{Binding Level}" Minimum="0" Maximum="1" Height="6" />
          </StackPanel>

          <TextBlock Text="{Binding Status}"
                     Opacity="0.7"
                     FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Waveform Display -->
      <Border Classes="card" IsVisible="{Binding CurrentWaveform, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Classes="cardBody">
          <TextBlock Text="Waveform" FontWeight="SemiBold" />
          <Canvas Height="120" Background="#1F2937" Name="RecordWaveformCanvas">
          </Canvas>
          <TextBlock Text="{Binding CurrentWaveform.TotalSamples, StringFormat='Samples: {0}'}" Opacity="0.7" FontSize="12" />
        </StackPanel>
      </Border>

      <!-- Recordings Library -->
      <Border Classes="card" IsVisible="{Binding Recordings.Count}">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Recordings" />

          <ItemsControl ItemsSource="{Binding Recordings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderThickness="1" BorderBrush="#374151" Padding="8" CornerRadius="4" Margin="0,4">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" Opacity="0.7" FontSize="12" />
                      <TextBlock Text="{Binding DurationMs, StringFormat='Duration: {0}ms'}" Opacity="0.7" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                      <Button Content="Edit" MinWidth="64" Padding="10,5"
                              Command="{Binding $parent[UserControl].DataContext.EditRecordingCommand}"
                              CommandParameter="{Binding .}" />
                      <Button Content="Delete" MinWidth="64" Padding="10,5" Classes="danger"
                              Command="{Binding $parent[UserControl].DataContext.DeleteRecordingCommand}"
                              CommandParameter="{Binding .}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
