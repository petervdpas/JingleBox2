<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.RecordView"
             x:DataType="vm:RecordViewModel">

  <ScrollViewer>
    <StackPanel Classes="tabRoot">

      <!-- Recording Controls -->
      <Border Classes="card">
        <!-- The gain sits down the right, where a desk keeps it: the controls that start and
             stop a take belong together, and the fader belongs next to the meter it feeds. -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Grid.Column="0" Spacing="12">
          <!-- Only on a system with a graph to patch; elsewhere the input is whatever the
               device picker in SETTINGS chose. -->
          <StackPanel Spacing="4" IsVisible="{Binding IsRoutingAvailable}">
            <TextBlock Text="Capture from" Opacity="0.8" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding Routes}"
                        SelectedItem="{Binding SelectedRoute}"
                        DisplayMemberBinding="{Binding Display}"
                        HorizontalAlignment="Stretch"
                        DropDownOpened="Routes_DropDownOpened"
                        PlaceholderText="Whatever the system chose" />
              <Button Grid.Column="1" Content="Refresh"
                      Command="{Binding RefreshRoutesCommand}"
                      ToolTip.Tip="Programs only appear while they are playing something." />
            </Grid>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Text="Recording Name" Opacity="0.8" />
            <TextBox Text="{Binding RecordingName}"
                     Classes.invalid="{Binding HasNameError}" />
            <TextBlock Text="{Binding NameError}"
                       IsVisible="{Binding HasNameError}"
                       Foreground="{DynamicResource DangerBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Content="🔴 Record"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StartRecordingCommand}"
                    IsEnabled="{Binding CanRecord}" />
            <Button Content="⏹ Stop"
                    MinWidth="96" Padding="10,5"
                    Command="{Binding StopRecordingCommand}"
                    IsEnabled="{Binding IsRecording}" />

            <!-- The other way onto the shelf. Beside Record because these are the two of them,
                 and here rather than on the list below, which is not there to be clicked when
                 the shelf is still empty. -->
            <Button Content="Import WAV"
                    MinWidth="96" Padding="10,5"
                    Margin="12,0,0,0"
                    Click="Import_Click"
                    ToolTip.Tip="Copy WAV files onto the shelf. Anything not already 16-bit is converted on the way in." />
          </StackPanel>

          <TextBlock Text="{Binding RecordingTime}"
                     FontSize="24"
                     Foreground="#FF6B7280"
                     HorizontalAlignment="Center" />

        </StackPanel>

        <!-- The gain and what it is doing, side by side, the way a channel strip has them. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <views:Fader Label="Input gain" Unit=" dB" Format="0.0" DefaultValue="0"
                       Minimum="{Binding MinGainDb}" Maximum="{Binding MaxGainDb}"
                       SmallStep="0.5" LargeStep="3"
                       TrackLength="150"
                       Ticks="12,6,0,-6,-12,-24"
                       ToolTip.Tip="Drag it, or use the wheel and the arrow keys. Double click for 0 dB."
                       Value="{Binding RecordGainDb}" />

          <StackPanel Spacing="6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="CLIP" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                         Classes="cliptext" Classes.clipping="{Binding IsClipping}" />
              <Border Width="9" Height="9" CornerRadius="5" VerticalAlignment="Center"
                      Classes="cliplight" Classes.clipping="{Binding IsClipping}" />
            </StackPanel>

            <views:LevelMeter Width="26" Height="150"
                              Stereo="{Binding IsStereoInput}"
                              Left="{Binding LevelLeft}"
                              Right="{Binding LevelRight}"
                              HorizontalAlignment="Center"
                              ToolTip.Tip="Peak level, left and right. Accent to -6 dB, amber to -1, red above." />
          </StackPanel>
        </StackPanel>
        </Grid>
      </Border>

      <!-- The take that is picked: its picture, and everything you can do to it. -->
      <Border Classes="card" IsVisible="{Binding SelectedRecording, Converter={x:Static ObjectConverters.IsNotNull}}">
        <StackPanel Classes="cardBody">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="cardTitle" Text="{Binding SelectedRecording.Name}" />
            <TextBlock Opacity="0.7" FontSize="12" VerticalAlignment="Center"
                       Text="{Binding SelectedRecording.DurationMs, StringFormat='{}{0}ms'}" />
          </StackPanel>

          <!-- The picture sits on the page's own colour rather than the card's, the way the
               slice editor's does, so it reads as a window cut into the card. -->
          <Border Background="{DynamicResource BgBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="4">
            <Canvas Height="120" Name="RecordWaveformCanvas" />
          </Border>

          <!-- Under the picture, where they act on the take you are looking at. On the rows
               they were four buttons apiece to read past while looking for a name. -->
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Opacity="0.7" FontSize="12"
                       Text="{Binding CurrentWaveform.TotalSamples, StringFormat='Samples: {0}'}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
              <Button Content="▶" MinWidth="36" Padding="6,5" FontSize="12"
                      IsEnabled="{Binding !SelectedRecording.IsPlaying}"
                      Command="{Binding PlayRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}"
                      ToolTip.Tip="Play this recording" />
              <Button Content="■" MinWidth="36" Padding="6,5" FontSize="12"
                      IsEnabled="{Binding SelectedRecording.IsPlaying}"
                      Command="{Binding StopRecordingPlaybackCommand}"
                      CommandParameter="{Binding SelectedRecording}"
                      ToolTip.Tip="Stop playing" />

              <Button Content="Edit" MinWidth="64" Padding="10,5"
                      Command="{Binding EditRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}" />
              <Button Content="Delete" MinWidth="64" Padding="10,5" Classes="danger"
                      IsEnabled="{Binding !SelectedRecording.IsInUse}"
                      ToolTip.Tip="{Binding SelectedRecording.UsedBy, StringFormat='In use by {0}. Delete the instrument first.'}"
                      Command="{Binding DeleteRecordingCommand}"
                      CommandParameter="{Binding SelectedRecording}" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Recordings Library -->
      <Border Classes="card" IsVisible="{Binding Recordings.Count}">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Recordings" />

          <!-- A list you pick from, rather than a stack of little control panels. What a row
               says is what the take is; what you do to it is under its picture above. -->
          <ListBox Classes="cards"
                   ItemsSource="{Binding Recordings}"
                   SelectedItem="{Binding SelectedRecording}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                  <TextBlock Grid.Row="0" Grid.Column="0"
                             Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />

                  <!-- A sample instrument plays this file itself, so a recording that is spoken
                       for is tagged. Up in the corner rather than beside the name: it belongs
                       to the whole row, and a name is not a place to hang a second thing off. -->
                  <Border Grid.Row="0" Grid.Column="1"
                          Classes="badge" MaxWidth="220"
                          HorizontalAlignment="Right" VerticalAlignment="Top"
                          IsVisible="{Binding IsInUse}"
                          ToolTip.Tip="{Binding UsedBy, StringFormat='Used by {0}. Delete the instrument first.'}">
                    <TextBlock Text="{Binding UsedBy, StringFormat='USED BY {0}'}"
                               TextTrimming="CharacterEllipsis" />
                  </Border>

                  <TextBlock Grid.Row="1" Grid.Column="0" Opacity="0.7" FontSize="12"
                             Text="{Binding CreatedAt, StringFormat='Created: {0:g}'}" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Opacity="0.7" FontSize="12"
                             Text="{Binding DurationMs, StringFormat='Duration: {0}ms'}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
