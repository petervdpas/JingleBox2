<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.MachinesView"
             x:DataType="vm:MachineRackViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A label and its control, kept together on one line of the top row. -->
    <Style Selector="StackPanel.entry">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>

    <!-- One block of the voice: a heading with its knobs or faders under it. -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,24,10" />
    </Style>
  </UserControl.Styles>

  <!-- No margin of its own. This page stands where the pattern grid stands, inside the
       tracker's own margin, and a ring added here only pushes it away from the edges the
       page beside it uses. -->
  <DockPanel>

    <Grid ColumnDefinitions="240,12,*">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Machines" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <!-- The machines are always here, one each, under their own names. The only thing
                 you add is a plugin; a variant of a machine is a Duplicate of it. -->
            <TextBlock Classes="cardHint" Text="Add a plugin:"
                       IsVisible="{Binding HasAvailablePlugins}" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasAvailablePlugins}">
              <ComboBox Grid.Column="0" x:Name="PluginPicker"
                        ItemsSource="{Binding AvailablePlugins}"
                        DisplayMemberBinding="{Binding Name}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Pick a plugin..." />
              <Button Grid.Column="1" Content="+ New" Click="NewFromPlugin_Click"
                      ToolTip.Tip="A VST3 or CLAP instrument. Scan for them on the SETTINGS page." />
            </Grid>

            <TextBlock Classes="cardHint" Margin="0,4,0,0"
                       Text="No plugins scanned yet. SETTINGS has the scanner."
                       IsVisible="{Binding !HasAvailablePlugins}" />

            <Button Content="Delete" HorizontalAlignment="Stretch" Classes="danger"
                    Margin="0,6,0,0"
                    IsEnabled="{Binding CanDelete}"
                    Command="{Binding DeleteCommand}"
                    ToolTip.Tip="Takes a plugin out of the rack. A machine cannot be taken out." />
          </StackPanel>

          <ListBox ItemsSource="{Binding Machines}"
                   SelectedItem="{Binding Selected}"
                   ItemTemplate="{StaticResource RackRow}" />
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to give the machine list more or less room." />

      <Border Grid.Column="2" Classes="card">
        <!-- The designer is its own control, so the same panel serves this tab and the
             window a track opens onto the instrument it plays. -->
        <views:InstrumentEditor />
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
