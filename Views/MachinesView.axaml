<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.MachinesView"
             x:DataType="vm:MachineRackViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A label and its control, kept together on one line of the top row. -->
    <Style Selector="StackPanel.entry">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>

    <!-- One block of the voice: a heading with its knobs or faders under it. -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,24,10" />
    </Style>

    <!-- The rack's own two tabs, not the application's five. Left as they were they take the
         page strip's size, which is a heading, and two headings will not stand side by side in
         a column this narrow so they stack and eat a third of the list. -->
    <Style Selector="TabControl.rack > TabItem">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0,2,0,6" />
      <Setter Property="Margin" Value="0,0,14,0" />
    </Style>

    <!-- Each row in its machine's colour, a wash for a row and more of it for the one in hand.
         The rack reads as a rack of coloured boxes rather than as a list with a coloured edge,
         and the row you have picked is that machine's colour rather than the application's.
         Here rather than on the list, since there are two lists and one rule. -->
    <Style Selector="ListBox.rack ListBoxItem" x:DataType="vm:RackMachine">
      <Setter Property="Background" Value="{Binding Row}" />
    </Style>
    <Style Selector="ListBox.rack ListBoxItem:pointerover /template/ ContentPresenter" x:DataType="vm:RackMachine">
      <Setter Property="Background" Value="{Binding RowOver}" />
    </Style>
    <Style Selector="ListBox.rack ListBoxItem:selected /template/ ContentPresenter" x:DataType="vm:RackMachine">
      <Setter Property="Background" Value="{Binding RowPicked}" />
    </Style>
  </UserControl.Styles>

  <!-- No margin of its own. This page stands where the pattern grid stands, inside the
       tracker's own margin, and a ring added here only pushes it away from the edges the
       page beside it uses. -->
  <DockPanel>

    <Grid ColumnDefinitions="240,12,*">

      <Border Grid.Column="0" Classes="card">
        <!-- Two tabs and one rule for both: what is on a tab is what this installation has
             registered. A plugin is on neither, and never was worth shelving: a CLAP or a VST3
             is somebody else's program, used by a song rather than owned by this installation,
             and it is picked where a song picks its instruments and where a track adds an
             effect. -->
        <TabControl Classes="rack">

          <TabItem Header="Machines">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <!-- Every registered machine has its own box already. This is for the second
                     one: a Zampler set up differently, kept beside the first. -->
                <TextBlock Classes="cardHint" Text="Add a machine:"
                           IsVisible="{Binding HasAvailableMachines}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasAvailableMachines}">
                  <ComboBox Grid.Column="0" x:Name="MachinePicker"
                            ItemsSource="{Binding AvailableMachines}"
                            DisplayMemberBinding="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Pick a machine..." />
                  <Button Grid.Column="1" Content="+ New" Click="NewFromMachine_Click"
                          ToolTip.Tip="Another box on that machine, set up however you like." />
                </Grid>

                <!-- Which is the ordinary state: every registered machine is given its box
                     when the rack is read, so there is nothing left to add. -->
                <TextBlock Classes="cardHint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Every machine you have is on the rack. SETTINGS, System is where machines are added and taken away."
                           IsVisible="{Binding !HasAvailableMachines}" />

                <Button Content="Delete" HorizontalAlignment="Stretch" Classes="danger"
                        Margin="0,6,0,0"
                        IsEnabled="{Binding CanDelete}"
                        Command="{Binding DeleteCommand}"
                        ToolTip.Tip="Takes it off the rack, so songs are no longer offered it. A machine can be put back from the picker above; the machine itself is only lost by unregistering it in SETTINGS." />
              </StackPanel>

              <ListBox ItemsSource="{Binding Machines}"
                       SelectedItem="{Binding Selected}"
                       DoubleTapped="OpenMachine"
                       Classes="rack"
                       ItemTemplate="{StaticResource RackRow}" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Effects">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <TextBlock Classes="cardHint" Text="Add an effect:"
                           IsVisible="{Binding HasAvailableEffects}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasAvailableEffects}">
                  <ComboBox Grid.Column="0" x:Name="EffectPicker"
                            ItemsSource="{Binding AvailableEffects}"
                            DisplayMemberBinding="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Pick an effect..." />
                  <Button Grid.Column="1" Content="+ New" IsEnabled="False" />
                </Grid>

                <!-- There are none, and this says why rather than showing an empty picker. An
                     effect is registered the way a machine is, and there is no effect engine
                     for one to be on yet. -->
                <TextBlock Classes="cardHint" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="No effects yet. A plugin effect goes on a track's chain, under the pattern."
                           IsVisible="{Binding !HasAvailableEffects}" />
              </StackPanel>

              <ListBox ItemsSource="{Binding Effects}"
                       SelectedItem="{Binding Selected}"
                       DoubleTapped="OpenMachine"
                       Classes="rack"
                       ItemTemplate="{StaticResource RackRow}" />
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to give the machine list more or less room." />

      <!-- No card around it. The machine paints its own plate, edge and corners, and a card
           behind that is a second frame around the first. -->
      <views:InstrumentPanel Grid.Column="2" />

    </Grid>
  </DockPanel>
</UserControl>
