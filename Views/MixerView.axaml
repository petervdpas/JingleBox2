<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             xmlns:midi="clr-namespace:JingleBox2.Midi"
             xmlns:routing="clr-namespace:JingleBox2.Audio.Routing.Records"
             xmlns:rec="clr-namespace:JingleBox2.UI.Records"
             xmlns:arec="clr-namespace:JingleBox2.Audio.Records"
             x:Class="JingleBox2.Views.MixerView"
             x:DataType="vm:TrackerViewModel">

  <UserControl.Resources>
    <!-- A strip over something that is not a track: a badge, a fader and a meter, and nothing
         else. No pan, no mute, no solo and no ducking, because none of those mean anything for
         the recording input, the pads as a whole, or a take being auditioned. One template for
         all three, since what differs between them is only what the fader writes to. -->
    <DataTemplate x:Key="SourceStrip" x:DataType="vm:SourceStripViewModel">
      <Border Classes="inset" Width="134">
        <!-- The same six rows every strip here uses, so a row of them lines up: badge, pan,
             mute and solo, the fader and its meter, the reading, and the side chain. This shape
             has no side chain, so its last row stays empty rather than the rows being different
             from one strip to the next. -->
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
          <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
            <Border Classes="badge" HorizontalAlignment="Center"
                    ToolTip.Tip="{Binding Tip}">
              <TextBlock Text="{Binding Label}" />
            </Border>

            <!-- Only where there is a bus underneath. The recording input has neither: panning
                 what is being recorded is not something the recorder does, and a mute there
                 would be recording nothing without saying so. No solo on any of them, because
                 solo here is the song's and these are not in the song. -->
          </StackPanel>

          <ui:Knob Grid.Row="1" Label="Pan" Format="0.00" DefaultValue="0"
                   Minimum="-1" Maximum="1" SmallStep="0.05" LargeStep="0.25"
                   HorizontalAlignment="Center" Margin="0,8,0,0"
                   IsVisible="{Binding OnABus}"
                   Value="{Binding Pan}" />

          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                      HorizontalAlignment="Center" Margin="0,8,0,0"
                      IsVisible="{Binding OnABus}">
              <ToggleButton Classes="strip" Content="M"
                            IsChecked="{Binding Mute}"
                            ToolTip.Tip="Silence this, leaving its fader where it is." />

              <!-- Grey rather than gone where there is no bus: a solo is worked out by the bus,
                   which is the only thing that knows every source, so without one there is nothing
                   to pause the others with. Left in place so the strip does not change shape. -->
              <ToggleButton Classes="strip" Content="S"
                            IsEnabled="{Binding CanSolo}"
                            IsChecked="{Binding Solo}"
                            ToolTip.Tip="Hear only this." />
          </StackPanel>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                      HorizontalAlignment="Center" Margin="0,8,0,0">
            <ui:Fader ShowValue="False" Unit=" dB" Format="+0.0;-0.0;0.0" DefaultValue="0"
                      Margin="0,13,0,0"
                      Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                      SmallStep="0.5" LargeStep="3"
                      TrackLength="0"
                      Ticks="6,0,-6,-12,-24,-40,-60"
                      ToolTip.Tip="{Binding Tip}"
                      Value="{Binding VolumeDecibels}" />

            <ui:LevelMeter Width="22"
                           VerticalAlignment="Stretch"
                           Margin="0,0,0,7"
                           Stereo="True"
                           Left="{Binding Left}"
                           Right="{Binding Right}" />
          </StackPanel>

          <!-- The reading is the strip's rather than the fader's: see the note on the track
               strip below for why a fader cannot carry the word. -->
          <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,0"
                     FontFamily="{x:Static ui:PatternFont.Family}" FontSize="11"
                     Text="{Binding VolumeDecibels, StringFormat='Level: {0:+0.0;-0.0;0.0} dB'}" />

          <!-- Where this strip is fed from, in the row a track's strip keeps its ducking in, so
               the desk stays one shape across. Only the recording input has one: what feeds the
               pads and a take is this program.

               **Its width is fixed rather than stretched.** A route is named by whatever is
               playing, so the list holds sentences like "Built-in Audio Analog Stereo", and a
               picker measured against its contents would make one strip wider than every other
               strip on the desk. The name is trimmed here and said in full on the tip and on
               RECORD. -->
          <StackPanel Grid.Row="5" Spacing="4" Margin="0,10,0,0"
                      IsVisible="{Binding TakesSource}">
            <TextBlock Classes="cardHint" HorizontalAlignment="Center" Text="Source" />

            <ComboBox Width="118"
                      HorizontalAlignment="Center"
                      FontSize="11"
                      IsEnabled="{Binding Source.IsRoutingAvailable}"
                      ItemsSource="{Binding Source.Routes}"
                      SelectedItem="{Binding Source.SelectedRoute}"
                      DropDownOpened="Sources_DropDownOpened"
                      PlaceholderText="Nothing yet"
                      ToolTip.Tip="What the input is taken from. A program is only in the list while it is playing.">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="routing:AudioRoute">
                  <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"
                             ToolTip.Tip="{Binding Display}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Capturing a source and taking it off everything else are two different acts, so
                 this is a switch of its own under the picker rather than something choosing a
                 source implies. Off unless somebody says so: a browser that went silent
                 everywhere the moment it was picked would read as this application having
                 broken it. Grey where the machine cannot rather than gone, the rule every other
                 switch on this page keeps. -->
            <!-- The desk's input channel: what is coming in goes through the recording chain and
                 out of the master, which is what an insert on an input has always meant. Grey
                 for what an output is playing, since hearing that through the output is a loop
                 rather than a monitor.

                 **As wide as the picker rather than as wide as its own words.** Centred on
                 itself, a switch sits where the length of its label puts it, so two of them
                 under one picker have their boxes on two different lines down the strip. Given
                 the picker's width they all start on the picker's own left edge, which is the
                 one edge this column has. -->
            <CheckBox Content="Hear it"
                      Classes="strip"
                      IsEnabled="{Binding Source.CanHear}"
                      IsChecked="{Binding Source.Hearing, Mode=TwoWay}"
                      ToolTip.Tip="Hear what is coming in, through the Recording Effects chain, out of the master. It arrives a buffer or two late, and what an output is playing cannot be heard this way because that is a loop." />

            <!-- Only drawn where a source has to be sent somewhere rather than simply
                 unplugged, which is a machine with no graph. A cable is the usual answer and a
                 spare socket is as good; picking one here is what makes the switch under it
                 something that can be pressed. -->
            <StackPanel Spacing="2" IsVisible="{Binding Source.NeedsSilentOutput}">
              <TextBlock Classes="cardHint" HorizontalAlignment="Center" Text="Send it to" />

              <ComboBox Width="118"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        ItemsSource="{Binding Source.SilentOutputs}"
                        SelectedItem="{Binding Source.SilentOutput, Mode=TwoWay}"
                        PlaceholderText="Nothing yet"
                        ToolTip.Tip="Where a source goes when it is taken off its own output. A cable, or an output nobody is listening to.">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="arec:AudioEndpoint">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <CheckBox Content="Only here"
                      Classes="strip"
                      IsEnabled="{Binding Source.CanTakeAside}"
                      IsChecked="{Binding Source.TakeAside, Mode=TwoWay}"
                      ToolTip.Tip="Take this source off its own output, so it is heard through JingleBox2 and nowhere else. Put back when you close the application." />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The word over a group of strips. Quiet, since it names the row rather than being part
         of it: what the eye is looking for on this page is a fader, not a heading. -->
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.55" />
      <Setter Property="Margin" Value="2,0,0,0" />
    </Style>

    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Mute and solo read as lit or unlit, so they need a state the eye can catch. -->
    <Style Selector="ToggleButton.strip">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- The switches under the IN strip's picker. As wide as the picker rather than as wide as
         their own words, so their boxes stand on the picker's own left edge: centred on
         themselves, two labels of different lengths put their boxes on two different lines and
         the column reads as ragged. The number is the picker's, said again because a picker
         measured against a route's name would be wider than the strip. -->
    <Style Selector="CheckBox.strip">
      <Setter Property="Width" Value="118" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- The two caps over the patchbay. Square rather than the mute button's shape, since what
         is on them is one mark rather than a letter: a wide cap with a hyphen in the middle of
         it reads as a button whose word did not load. The mark is set large and heavy for the
         same reason, and the cap carries the picture's own ground so it stands off the page
         rather than floating on it. -->
    <Style Selector="Button.zoom">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton.strip:checked">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Accent}" />
      </Setter>
      <Setter Property="Foreground" Value="Black" />
    </Style>
  </UserControl.Styles>

  <!-- No margin of its own. This page stands where the pattern grid stands, inside the
       tracker's own margin, and a ring added here only pushes it away from the edges the
       page beside it uses. -->
  <DockPanel>

    <!-- Two tabs, and both are the mixer's own business. The desk is what the song is
         summing; the patchbay is where that sound comes from and where it goes, which is the
         same question asked one step further out. It is a tab rather than a page along the
         top because nothing on it means anything without the strips beside it. -->
    <TabControl Classes="inner">

      <TabItem Header="Mixer">
        <Border Classes="card">
          <DockPanel>
            <!-- The same button a machine's face carries, in the same corner, and the same lines
                 behind it. The mixer is drawn by this program rather than described by anybody, so
                 there is no part to drop and it goes in the card's own header. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,10">
              <TextBlock Grid.Column="0" Classes="cardTitle" Text="Mixer" />

              <views:HelpBadge Grid.Column="1" Topic="mixer.strips" />

              <!-- Out into a window of its own, and back again. In the header rather than only in the
                   menu because it is a thing you do rather than a thing you set, and a page you can
                   take out should say so where you can see it. Closing the window puts the page back,
                   so this is the only half that needs a button. -->
              <ui:PushButton Grid.Column="3" x:Name="DetachButton"
                             Mark="Window" CapWidth="30" CapHeight="20"
                             Pressed="Detach_Pressed"
                             ToolTip.Tip="Open the mixer in a window of its own. Closing that window puts it back here." />


              <ui:PushButton Grid.Column="4" x:Name="MixerMenuButton"
                             Mark="Bars" CapWidth="30" CapHeight="20"
                             Pressed="MixerMenu_Pressed"
                             ToolTip.Tip="What your controllers do to the mixer. Point one at a template you have already made, or start learning." />
            </Grid>

            <!-- What the master makes move over the pattern. Under the mixer rather than under the
                 pattern, because the master is not a track and the panel down there is about the
                 track the cursor is in. -->
            <views:FoldStrip DockPanel.Dock="Bottom" Title="master automation"
                             IsOpen="{Binding ShowsMasterLanes, Mode=TwoWay}"
                             StripHeight="{Binding MasterLanesHeight, Mode=TwoWay}">
              <views:AutomationStrip DataContext="{Binding MasterLanes}" />
            </views:FoldStrip>

            <!-- What the whole mix goes through, under the strips it is the sum of. The same strip
                 the pattern page puts under a track, because a chain is a chain: what differs is
                 only which of them it is about. -->
            <!-- The topmost of the two, so this is the one that carries the room above the pair:
             docked from the bottom the automation goes lowest and this stands over it, against
             the row of faders. -->
        <views:FoldStrip DockPanel.Dock="Bottom" Title="master effects" Margin="0,10,0,0"
                             IsOpen="{Binding ShowsMasterChain, Mode=TwoWay}"
                             StripHeight="{Binding MasterChainHeight, Mode=TwoWay}">
              <views:PluginStrip DataContext="{Binding MasterEffect}" />
            </views:FoldStrip>

            <!-- The master stands apart from the tracks and on the right, where the sum of a row
                 belongs. Outside the scroller, so it stays where it is however many tracks the song
                 has and however far along them you have scrolled: it is the one strip you always
                 want to be able to see. -->
            <!-- In a ContentControl so the visibility is asked of the tracker while the strip
                 itself is given the master: a DataContext set on the same element would take the
                 binding beside it with it. The same reason the tracker holds its rack page that
                 way. -->
            <ContentControl DockPanel.Dock="Right" Margin="12,0,0,0"
                            IsVisible="{Binding MasterStrip, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Content="{Binding MasterStrip}">
              <ContentControl.ContentTemplate>
                <DataTemplate x:DataType="vm:TrackStripViewModel">
                  <Border Classes="inset" Width="134">
                    <!-- The same six rows the other two strip shapes use, so the master lines up
                         with the tracks beside it. It has no side chain, so its last row is empty. -->
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                      <Border Grid.Row="0" Classes="badge" HorizontalAlignment="Center"
                              ToolTip.Tip="The whole mix, after every track.">
                        <TextBlock Text="{Binding Label}" />
                      </Border>

                      <ui:Knob Grid.Row="1" Label="Pan" Format="0.00" DefaultValue="0"
                                  Minimum="-1" Maximum="1" SmallStep="0.05" LargeStep="0.25"
                                  HorizontalAlignment="Center" Margin="0,8,0,0"
                                  views:Pointable.Offers="{Binding PanLink}"
                                  Value="{Binding Pan}" />

                      <!-- Mute and no solo. Soloing the master would mean soloing everything, which
                           is what it is already doing. -->
                      <ToggleButton Grid.Row="2" Classes="strip" Content="M" IsChecked="{Binding Mute}"
                                    HorizontalAlignment="Center" Margin="0,8,0,0"
                                    views:Pointable.Offers="{Binding MuteLink}"
                                    ToolTip.Tip="Silence the whole mix" />

                      <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                                  HorizontalAlignment="Center" Margin="0,8,0,0">
                        <ui:Fader ShowValue="False" Unit=" dB" Format="+0.0;-0.0;0.0" DefaultValue="0"
                                     Margin="0,13,0,0"
                                     Minimum="-60" Maximum="6" SmallStep="0.5" LargeStep="3"
                                     TrackLength="0"
                                     Ticks="6,0,-6,-12,-24,-40,-60"
                                     views:Pointable.Offers="{Binding LevelLink}"
                                     ToolTip.Tip="The last thing between the mix and the card. Double click to go back to unity."
                                     Value="{Binding VolumeDecibels}" />

                        <!-- What is leaving, which is the one meter on this page measuring the thing
                             you actually hear. -->
                        <ui:LevelMeter Width="22"
                                          VerticalAlignment="Stretch"
                                          Margin="0,0,0,7"
                                          Stereo="True"
                                          Left="{Binding Left}"
                                          Right="{Binding Right}"
                                          ToolTip.Tip="What is leaving, after every track and the master's own effect." />
                      </StackPanel>

                      <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,0"
                                 FontFamily="{x:Static ui:PatternFont.Family}" FontSize="11"
                                 Text="{Binding VolumeDecibels, StringFormat='Level: {0:+0.0;-0.0;0.0} dB'}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ContentControl.ContentTemplate>
            </ContentControl>

            <!-- Everything that is not the master, in its three groups, scrolling under it. The
                 master is docked to the right and outside this, so it stays put however far along
                 the tracks you have gone: it is the one strip you always want to be able to see.

                 The groups are labelled because the row is no longer all one kind of thing. Two of
                 them are the application's and one is the song's, and that difference decides what a
                 fader does: pulling a track down changes the song, pulling PADS down changes this
                 installation. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <StackPanel Orientation="Horizontal" Spacing="18">

                <!-- Each group is a DockPanel rather than a stack, so its title takes the line it
                     needs and the strips under it take everything left. Stacked, every group was as
                     tall as its own contents, which left the three shortest strips a third the
                     height of the tracks beside them and their faders squeezed into what was left. -->
                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="RECORDER" />

                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                    <ContentControl Content="{Binding $parent[views:MixerView].RecorderInput}"
                                    ContentTemplate="{StaticResource SourceStrip}" />

                    <ContentControl Content="{Binding $parent[views:MixerView].RecorderPlay}"
                                    ContentTemplate="{StaticResource SourceStrip}" />
                  </StackPanel>
                </DockPanel>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="PADS" />

                  <ContentControl Margin="0,6,0,0"
                                  Content="{Binding $parent[views:MixerView].PadsStrip}"
                                  ContentTemplate="{StaticResource SourceStrip}" />
                </DockPanel>

                <DockPanel>
                  <TextBlock DockPanel.Dock="Top" Classes="groupTitle" Text="TRACKER" />

                  <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Strips}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TrackStripViewModel">
                    <!-- A strip is picked by touching it anywhere, which is what makes one link on
                         the mixer enough: everything pointed at a strip follows the track you are
                         on, and this is how you say which that is. Tunnelled, so taking hold of a
                         fader picks its strip on the way past rather than instead of moving it. -->
                    <Border Classes="inset" Width="134"
                            Classes.selected="{Binding IsSelected}">
                      <!-- **Six rows, and everything on a strip lands in one of them.** It was a
                           dock panel, which has no places in it: a dock panel gives the rest of the
                           room to whichever child is written last, so adding a line of text after
                           the fader handed the room to the text and squeezed the fader and its meter
                           into a band along the top. That is not a thing to remember, it is a thing
                           to stop being possible.

                           The rows, in order: the badge, the pan knob, the mute and solo pair, the
                           fader and its meter, the level reading, and the side chain. Only the
                           fourth grows, so the strips fill the page and every other row is where it
                           is on every strip: a mixer has to read across.

                           All three strip shapes here use these same six, which is what makes a row
                           of them line up. -->
                      <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center">
                          <!-- The instrument is on the badge rather than under it. A name can be
                               any length, and a line for it would make one strip taller than the
                               next, which is the one thing a row of strips must not do. -->
                          <Border Classes="badge" HorizontalAlignment="Center"
                                  ToolTip.Tip="{Binding InstrumentTip}">
                            <TextBlock Text="{Binding Label}" />
                          </Border>

                        </StackPanel>

                        <ui:Knob Grid.Row="1" Label="Pan" Format="0.00" DefaultValue="0"
                                    Minimum="-1" Maximum="1" SmallStep="0.05" LargeStep="0.25"
                                    HorizontalAlignment="Center" Margin="0,8,0,0"
                                    views:Pointable.Offers="{Binding PanLink}"
                                    Value="{Binding Pan}" />

                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4"
                                    HorizontalAlignment="Center" Margin="0,8,0,0">
                          <ToggleButton Classes="strip" Content="M" IsChecked="{Binding Mute}"
                                        views:Pointable.Offers="{Binding MuteLink}"
                                        ToolTip.Tip="Mute this track" />

                          <ToggleButton Classes="strip" Content="S" IsChecked="{Binding Solo}"
                                        views:Pointable.Offers="{Binding SoloLink}"
                                        ToolTip.Tip="Solo: while any track is soloed, the others are silent" />
                        </StackPanel>

                        <!-- The side chain, along the bottom of the strip: the track it
                             listens to, how far down it goes, and how long it takes to come back.
                             Every strip's is at the same height, so a mixer reads across. -->
                        <StackPanel Grid.Row="5" Spacing="4" Margin="0,10,0,0">
                          <TextBlock Classes="cardHint" HorizontalAlignment="Center" Text="Duck from" />

                          <ComboBox HorizontalAlignment="Stretch"
                                    FontSize="11"
                                    ItemsSource="{Binding DuckKeys}"
                                    SelectedItem="{Binding DuckKey}"
                                    ToolTip.Tip="The track whose notes push this one down. Pick the kick to clear room for it." />

                          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <ui:Knob Label="Duck" Format="0.00" DefaultValue="0"
                                        Minimum="0" Maximum="1" SmallStep="0.02" LargeStep="0.1"
                                        DialSize="30"
                                        views:Pointable.Offers="{Binding DuckLink}"
                                        ToolTip.Tip="How far down this track goes while the key track is at full scale."
                                        Value="{Binding Duck}" />

                            <ui:Knob Label="Rel" Unit="ms" Format="0" DefaultValue="150"
                                        views:Pointable.Offers="{Binding ReleaseLink}"
                                        Minimum="20" Maximum="1000" SmallStep="5" LargeStep="50"
                                        DialSize="30"
                                        ToolTip.Tip="How long this track takes to come back up once the key stops. The attack is always fast."
                                        Value="{Binding DuckReleaseMs}" />
                          </StackPanel>
                        </StackPanel>

                        <!-- The fader and the meter side by side, as they sit on a desk: the
                             hand is on one and the eye is on the other. Zero track length means
                             both take whatever height is left in the strip. -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Center" Margin="0,8,0,0">
                          <ui:Fader ShowValue="False" Unit=" dB" Format="+0.0;-0.0;0.0" DefaultValue="0"
                                       Margin="0,13,0,0"
                                       views:Pointable.Offers="{Binding LevelLink}"
                                       Minimum="-60" Maximum="6" SmallStep="0.5" LargeStep="3"
                                       TrackLength="0"
                                       Ticks="6,0,-6,-12,-24,-40,-60"
                                       ToolTip.Tip="Unity is 0 dB. Double click to go back to it."
                                       Value="{Binding VolumeDecibels}" />

                          <!-- The lamp takes the top of the meter, so the bars start below it. The
                               fader is pushed down by the same amount and the two travels line up;
                               doing it the other way, by pulling the meter up, put the lamp through
                               the mute and solo buttons above. -->
                          <ui:LevelMeter Width="22"
                                            VerticalAlignment="Stretch"
                                            Margin="0,0,0,7"
                                            Stereo="True"
                                            Left="{Binding Left}"
                                            Right="{Binding Right}"
                                            ToolTip.Tip="What this track is sounding, left and right." />
                        </StackPanel>

                        <!-- The reading is the strip's rather than the fader's, and that is not a
                             preference: **a fader is as wide as the longest reading it can show**,
                             so with the word inside that string it claimed the width of
                             "Level: -60.0 dB", which on a 134 pixel strip is all of it, and the
                             meter beside it was squeezed out of existence. The strip is wider than
                             the fader and has the room the fader has not. -->
                        <TextBlock Grid.Row="4" HorizontalAlignment="Center" Margin="0,4,0,0"
                                   FontFamily="{x:Static ui:PatternFont.Family}" FontSize="11"
                                   Text="{Binding VolumeDecibels, StringFormat='Level: {0:+0.0;-0.0;0.0} dB'}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                  </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </DockPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </TabItem>

      <!-- The picture, and a sidebar saying what the block you touched is. Every block on it
           either feeds this application or is this application, and every cable has us at one
           end, which is what makes it a patchbay somebody can use rather than a picture of the
           whole machine: there is no gesture on it that can unplug the speakers. -->
      <TabItem Header="Patchbay">
        <ContentControl Content="{Binding $parent[views:MixerView].Patchbay}">
          <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:PatchbayViewModel">
              <!-- The details go under the picture rather than beside it. The picture is
                   wide and grows sideways as blocks are added, so a column down the right was
                   taking room from the one thing on the page that needs it; under it the same
                   details lie in a row and cost only height. The same handle the rack and the
                   help window use shares the two out. -->
              <Grid RowDefinitions="*,12,Auto">

                <Border Grid.Row="0" Classes="card" MinHeight="180" ClipToBounds="True">
                  <Panel>
                    <views:PatchbayView x:Name="Bay" Loaded="Bay_Loaded"
                                        Nodes="{Binding Nodes}"
                                        Links="{Binding Links}"
                                        Live="{Binding Live}"
                                        Selected="{Binding Selected, Mode=TwoWay}" />

                    <!-- Over the picture rather than in a bar above it, since the picture is the
                         page: a row of its own would cost a strip of height on every song for
                         two buttons most of them never need. The corner opposite where the
                         blocks start, so they are not under the hand that is arranging them. -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,4,4,0">
                      <Button Classes="zoom" Content="-" Click="ZoomOut_Click"
                              ToolTip.Tip="Draw the picture smaller." />
                      <Button Classes="zoom" Content="+" Click="ZoomIn_Click"
                              ToolTip.Tip="Draw it larger." />
                    </StackPanel>
                  </Panel>
                </Border>

                <GridSplitter Grid.Row="1" Classes="handle rows" ResizeDirection="Rows"
                              ToolTip.Tip="Drag to give the picture or the details more room." />

                <!-- What the block in hand is. It says nothing rather than the last thing when
                     nothing is picked, since a panel describing a block nobody touched reads as
                     the picture having chosen for you. -->
                <Border Grid.Row="2" Classes="card">
                  <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8"
                          Margin="0,0,0,8">
                      <TextBlock Grid.Column="0" Classes="cardTitle" Text="Block" />
                      <views:HelpBadge Grid.Column="1" Topic="mixer.patchbay" VerticalAlignment="Center" />

                      <!-- On the heading's own line rather than under the details, since down
                           here the details are columns and a line of prose under them would be
                           as wide as the window and read as a caption for all of it. -->
                      <TextBlock Grid.Column="3" Classes="cardHint" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"
                                 Text="{Binding Says}" />
                    </Grid>

                    <!-- The details in a row, each part taking only what it needs, and the lot
                         scrolling sideways rather than wrapping: a block with thirty two tracks
                         on it is a long list however it is drawn, and a panel that grew taller
                         as a song did would take the picture's room with it. -->
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                      <StackPanel Orientation="Horizontal" Spacing="24">

                        <StackPanel Spacing="2" MaxWidth="240" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Selected.Title}" TextWrapping="Wrap" FontWeight="SemiBold" />
                          <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding Selected.Id}" />
                        </StackPanel>

                        <!-- What the block is putting out. Only for the blocks this application
                             owns: a program on the machine is somebody else's and we measure
                             nothing about it, so it gets no meter rather than one that cannot
                             move. The tracker's is every track at once, since what this panel
                             is asked is whether audio is coming out of the block. -->
                        <StackPanel Spacing="4" IsVisible="{Binding Metered}" VerticalAlignment="Top">
                          <TextBlock Classes="cardHint" Text="Level" />
                          <ui:LevelMeter Width="26" Height="96"
                                         HorizontalAlignment="Left"
                                         Stereo="True"
                                         Left="{Binding LevelLeft}"
                                         Right="{Binding LevelRight}"
                                         ToolTip.Tip="What is leaving this block, left and right." />
                        </StackPanel>

                        <StackPanel Spacing="4" IsVisible="{Binding Selected.HasIns}" VerticalAlignment="Top">
                          <TextBlock Classes="cardHint" Text="Takes in" />
                          <ItemsControl ItemsSource="{Binding Selected.Ins}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="rec:PatchPort">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                  <TextBlock FontFamily="{x:Static ui:PatternFont.Family}" FontSize="11"
                                             Text="{Binding Name}" />
                                  <TextBlock Classes="cardHint" FontSize="11" Text="{Binding Shape}" />
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                        <!-- One row per output, and the row is the same shape whatever the block
                             is: a track, the pads, a take and the master are four things here and
                             to a hand reaching for M or S they are one. A switch that means
                             nothing is dark rather than gone, which is the rule the mixer's own
                             strips keep, since a control that vanishes takes the layout with it. -->
                        <StackPanel Spacing="4" IsVisible="{Binding Selected.HasOuts}" VerticalAlignment="Top">
                          <TextBlock Classes="cardHint" Text="Gives out" />
                          <ItemsControl ItemsSource="{Binding Outputs}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:PatchSwitchViewModel">
                                <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="6" Margin="0,0,0,3">
                                  <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                              MinWidth="90" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{x:Static ui:PatternFont.Family}" FontSize="11"
                                               Text="{Binding Name}" />
                                    <TextBlock Classes="cardHint" FontSize="11" Text="{Binding Shape}" />
                                  </StackPanel>

                                  <ToggleButton Grid.Column="1" Classes="strip" Content="M"
                                                IsEnabled="{Binding CanMute}"
                                                IsChecked="{Binding Mute}"
                                                ToolTip.Tip="Silence this, leaving its fader where it is." />

                                  <ToggleButton Grid.Column="2" Classes="strip" Content="S"
                                                IsEnabled="{Binding CanSolo}"
                                                IsChecked="{Binding Solo}"
                                                ToolTip.Tip="Hear only this." />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>

                      </StackPanel>
                    </ScrollViewer>
                  </DockPanel>
                </Border>

              </Grid>
            </DataTemplate>
          </ContentControl.ContentTemplate>
        </ContentControl>
      </TabItem>

    </TabControl>
  </DockPanel>
</UserControl>
