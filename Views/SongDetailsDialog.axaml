<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="JingleBox2.Views.SongDetailsDialog"
        Title="Save song"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Spacing="16" Margin="20">

    <StackPanel Spacing="4">
      <TextBlock Text="Name" Opacity="0.8" />
      <TextBox Name="NameBox" KeyDown="Name_KeyDown" />
    </StackPanel>

    <StackPanel Spacing="4">
      <TextBlock Text="What is it?" Opacity="0.8" />

      <!-- Room for a couple of lines and no more. This is a note to yourself in six months,
           not a document, and Enter belongs to it rather than to the Save button. -->
      <TextBox Name="AboutBox"
               Height="70"
               AcceptsReturn="True"
               TextWrapping="Wrap"
               PlaceholderText="Optional. What it is for, how long it runs, what it ends on." />
    </StackPanel>

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Name="CancelButton" Content="Cancel" Click="Cancel_Click" MinWidth="88" IsCancel="True" />
      <Button Name="ConfirmButton" Content="Save" Click="Confirm_Click" MinWidth="88" IsDefault="True" />
    </StackPanel>

  </StackPanel>

</Window>
