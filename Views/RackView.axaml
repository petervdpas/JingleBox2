<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:vmi="clr-namespace:JingleBox2.ViewModels.Interfaces"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             x:Class="JingleBox2.Views.RackView"
             x:DataType="vm:RackViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.section">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A label and its control, kept together on one line of the top row. -->
    <Style Selector="StackPanel.entry">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,16,6" />
    </Style>

    <!-- One block of the voice: a heading with its knobs or faders under it. -->
    <Style Selector="StackPanel.group">
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="0,0,24,10" />
    </Style>

    <!-- Each row in its machine's colour, a wash for a row and more of it for the one in hand.
         The rack reads as a rack of coloured boxes rather than as a list with a coloured edge,
         and the row you have picked is that machine's colour rather than the application's.
         Here rather than on the list, since there are two lists and one rule. -->
    <Style Selector="ListBox.rack ListBoxItem" x:DataType="vmi:IRackRow">
      <Setter Property="Background" Value="{Binding Row}" />
    </Style>
    <Style Selector="ListBox.rack ListBoxItem:pointerover /template/ ContentPresenter" x:DataType="vmi:IRackRow">
      <Setter Property="Background" Value="{Binding RowOver}" />
    </Style>
    <Style Selector="ListBox.rack ListBoxItem:selected /template/ ContentPresenter" x:DataType="vmi:IRackRow">
      <Setter Property="Background" Value="{Binding RowPicked}" />
    </Style>
  </UserControl.Styles>

  <!-- No margin of its own. This page stands where the pattern grid stands, inside the
       tracker's own margin, and a ring added here only pushes it away from the edges the
       page beside it uses. -->
  <DockPanel>

    <!-- The list is 320 rather than 240, because what it draws is a name and a sentence under it
         saying what the box is, and at 240 that sentence folded onto three lines for every effect
         with anything to say about itself. -->
    <Grid ColumnDefinitions="320,12,*">

      <Border Grid.Column="0" Classes="card">
        <!-- Two tabs and one rule for both: what is on a tab is what this installation has
             registered. A plugin is on neither, and never was worth shelving: a CLAP or a VST3
             is somebody else's program, used by a song rather than owned by this installation,
             and it is picked where a song picks its instruments and where a track adds an
             effect. -->
        <TabControl Classes="inner" SelectedIndex="{Binding RackTab}">

          <TabItem Header="Machines">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <!-- Every registered machine has its own box already. This is for the second
                     one: a Zampler set up differently, kept beside the first. -->
                <TextBlock Classes="cardHint" Text="Add a machine:"
                           IsVisible="{Binding HasAvailableMachines}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasAvailableMachines}">
                  <ComboBox Grid.Column="0" x:Name="MachinePicker"
                            ItemsSource="{Binding AvailableMachines}"
                            DisplayMemberBinding="{Binding Name}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Pick a machine..." />
                  <Button Grid.Column="1" Content="+ New" Click="NewFromMachine_Click"
                          ToolTip.Tip="Another box on that machine, set up however you like." />
                </Grid>

                <!-- Which is the ordinary state: every registered machine is given its box
                     when the rack is read, so there is nothing left to add. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="0,4,0,0"
                      IsVisible="{Binding !HasAvailableMachines}">
                  <TextBlock Grid.Column="0" Classes="cardHint" TextWrapping="Wrap"
                             Text="Every machine you have is on the rack. SETTINGS, System is where machines are added and taken away." />

                  <!-- The page's own badge. It sits beside the line that already says where a
                       box comes from, since that is where somebody is looking when the list is
                       not what they expected. -->
                  <views:HelpBadge Grid.Column="1" Topic="rack.devices" VerticalAlignment="Top" />
                </Grid>

                <Button Content="Delete" HorizontalAlignment="Stretch" Classes="danger"
                        Margin="0,6,0,0"
                        IsEnabled="{Binding CanDelete}"
                        Command="{Binding DeleteCommand}"
                        ToolTip.Tip="Takes it off the rack, so songs are no longer offered it. A machine can be put back from the picker above; the machine itself is only lost by unregistering it in SETTINGS." />
              </StackPanel>

              <ListBox ItemsSource="{Binding Machines}"
                       SelectedItem="{Binding Selected}"
                       DoubleTapped="OpenMachine"
                       Classes="rack"
                       ItemTemplate="{StaticResource RackRow}" />
            </DockPanel>
          </TabItem>

          <TabItem Header="Effects">
            <DockPanel>
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">

                <!-- No picker beside this list, unlike the machines'. A machine's box can be
                     taken off the rack and put back because the box is an instrument you own;
                     an effect has nothing of the sort, since one in use is a slot on a track's
                     chain. Registered and here are the same fact, and SETTINGS, System is where
                     that changes. -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding HasEffects}">
                  <TextBlock Grid.Column="0" Classes="cardHint" TextWrapping="Wrap"
                             Text="Every effect you have is here. Drop one on a track's chain, under the pattern." />

                  <views:HelpBadge Grid.Column="1" Topic="rack.devices" VerticalAlignment="Top" />
                </Grid>

                <!-- There are none, and this says why rather than showing an empty list with no
                     explanation. An effect is a face over an engine, the engine is compiled in,
                     and an id with no engine behind it is read off disc and left there rather
                     than shown as a box that cannot sound. -->
                <TextBlock Classes="cardHint" TextWrapping="Wrap"
                           Text="No effects yet. A plugin effect goes on a track's chain, under the pattern."
                           IsVisible="{Binding !HasEffects}" />
              </StackPanel>

              <ListBox ItemsSource="{Binding Effects}"
                       SelectedItem="{Binding SelectedEffect}"
                       Classes="rack"
                       ItemTemplate="{StaticResource RackRow}" />
            </DockPanel>
          </TabItem>

        </TabControl>
      </Border>

      <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to give the machine list more or less room." />

      <!-- No card around it. The machine paints its own plate, edge and corners, and a card
           behind that is a second frame around the first. -->
      <views:SoundDevicePanel Grid.Column="2" IsVisible="{Binding ShowsMachine}" />

      <!-- A tab with nothing on it says so, in the middle of the room the panel would have had.
           Left to itself the page went on showing whatever was last drawn, so taking the last
           effect out of the registry left a machine standing beside an empty effects list. -->
      <TextBlock Grid.Column="2" Classes="cardHint"
                 IsVisible="{Binding ShowsNothing}"
                 Text="{Binding NothingSaid}"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center" />

      <!-- And the same room again for an effect, which is not an instrument and has no editor
           behind it: what is drawn is the effect's own face, and what its knobs are standing at
           here is a demonstration kept nowhere. It is worth drawing all the same, because this is
           where a hardware knob is pointed at an effect and where its own Menu hands a control
           surface back to it. -->
      <Border Grid.Column="2" x:Name="EffectPlate"
              IsVisible="{Binding ShowsEffect}"
              VerticalAlignment="Top"
              HorizontalAlignment="Left"
              Background="{DynamicResource BgBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="12">
        <ui:PanelView x:Name="EffectFace"
                      Face="{Binding SelectedEffect.Shown}"
                      Values="{Binding SelectedEffect.Values}"
                      Presets="{Binding SelectedEffect.Presets}"
                      Menu="{Binding SelectedEffect.Menu}" />
      </Border>

    </Grid>
  </DockPanel>
</UserControl>
