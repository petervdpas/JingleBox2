<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JingleBox2.ViewModels"
        xmlns:vmr="using:JingleBox2.ViewModels.Records"
        x:Class="JingleBox2.Views.CommandDialog"
        x:DataType="vm:CommandEditorViewModel"
        Title="Command"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <Window.Styles>
    <!-- One tick of the line. Lit where something happens on it: the note starting, stopping or
         sounding again, or an arpeggio holding the note off its own pitch. -->
    <Style Selector="Border.mark">
      <Setter Property="Height" Value="34" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.mark.on">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tick">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
  </Window.Styles>

  <StackPanel Spacing="16" Margin="20">

    <!-- Which command, by name. -->
    <ListBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Chosen}">
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vmr:CommandChoice">
          <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Summary}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <TextBlock Text="{Binding Chosen.Summary}" Opacity="0.8" TextWrapping="Wrap" />

    <!-- The line's twelve ticks. For a delay or a cut, clicking one is the amount; for a retrigger
         and an arpeggio it shows what the line will do. -->
    <StackPanel Spacing="4" IsVisible="{Binding ShowsRuler}">
      <ItemsControl ItemsSource="{Binding Ruler}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vmr:TickMark">
            <Button Classes="tick"
                    Command="{Binding $parent[Window].((vm:CommandEditorViewModel)DataContext).PickTickCommand}"
                    CommandParameter="{Binding Index}"
                    ToolTip.Tip="{Binding Index, StringFormat='Tick {0}'}">
              <Border Classes="mark" Classes.on="{Binding On}">
                <TextBlock Text="{Binding Text}" FontSize="11"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="Auto,*,Auto" Opacity="0.6">
        <TextBlock Grid.Column="0" Text="start of the line" FontSize="11" />
        <TextBlock Grid.Column="2" Text="next line" FontSize="11" />
      </Grid>
    </StackPanel>

    <!-- A retrigger: how often, and how much quieter each time. -->
    <Grid ColumnDefinitions="140,*,40" RowDefinitions="Auto,Auto" RowSpacing="8"
          IsVisible="{Binding IsRetrigger}">
      <TextBlock Grid.Row="0" Text="Every so many ticks" VerticalAlignment="Center" />
      <Slider Grid.Row="0" Grid.Column="1" Minimum="1" Maximum="11" TickFrequency="1"
              IsSnapToTickEnabled="True" Value="{Binding Every}" />
      <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Every}" VerticalAlignment="Center"
                 HorizontalAlignment="Right" />
      <TextBlock Grid.Row="1" Text="Quieter each time" VerticalAlignment="Center" />
      <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1"
              IsSnapToTickEnabled="True" Value="{Binding Fall}" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Fall}" VerticalAlignment="Center"
                 HorizontalAlignment="Right" />
    </Grid>

    <!-- An arpeggio: a chord by name, or the two intervals by hand. -->
    <StackPanel Spacing="8" IsVisible="{Binding IsArpeggio}">
      <ItemsControl ItemsSource="{Binding Chords}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vmr:ArpChord">
            <Button Content="{Binding Name}" Margin="0,0,6,6"
                    Command="{Binding $parent[Window].((vm:CommandEditorViewModel)DataContext).PickChordCommand}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Grid ColumnDefinitions="140,*,40" RowDefinitions="Auto,Auto" RowSpacing="8">
        <TextBlock Grid.Row="0" Text="First step up" VerticalAlignment="Center" />
        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1"
                IsSnapToTickEnabled="True" Value="{Binding Up}" />
        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Up}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
        <TextBlock Grid.Row="1" Text="Second step up" VerticalAlignment="Center" />
        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="15" TickFrequency="1"
                IsSnapToTickEnabled="True" Value="{Binding Up2}" />
        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Up2}" VerticalAlignment="Center"
                   HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>

    <!-- A volume or a pan: one slider. -->
    <Grid ColumnDefinitions="140,*" IsVisible="{Binding IsVolume}">
      <TextBlock Text="Volume" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="128" TickFrequency="1"
              IsSnapToTickEnabled="True" Value="{Binding Level}" />
    </Grid>
    <Grid ColumnDefinitions="140,*" IsVisible="{Binding IsPan}">
      <TextBlock Text="Left to right" VerticalAlignment="Center" />
      <Slider Grid.Column="1" Minimum="0" Maximum="128" TickFrequency="1"
              IsSnapToTickEnabled="True" Value="{Binding Place}" />
    </Grid>

    <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" />

    <Grid ColumnDefinitions="Auto,*,Auto">
      <TextBlock Grid.Column="0" VerticalAlignment="Center" Opacity="0.8"
                 FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                 Text="{Binding Written, StringFormat='Writes {0}'}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Content="Clear" Click="Clear_Click" MinWidth="88"
                ToolTip.Tip="Takes the command off, leaving the note." />
        <Button Content="Cancel" Click="Cancel_Click" MinWidth="88" IsCancel="True" />
        <Button Content="OK" Click="Confirm_Click" MinWidth="88" IsDefault="True" />
      </StackPanel>
    </Grid>

  </StackPanel>

</Window>
