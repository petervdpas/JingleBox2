<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:ctrl="clr-namespace:JingleBox2.Controls"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             x:Class="JingleBox2.Views.UseView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="ToggleButton.pad">
      <Setter Property="Background" Value="{DynamicResource PadBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ToggleButton.pad:pointerover">
      <Setter Property="Background" Value="{DynamicResource PadHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- A pad that is playing keeps its own colour and breathes, rather than being repainted in
         the theme's checked colour. The old way cost the thing a wall of pads is for: every
         playing pad turned the same orange, so which one you had fired was a question about
         which one had changed rather than something you could see, and a pad whose own colour
         happens to be that orange said nothing at all. It also took the lettering to black,
         which is unreadable on the dark pads.

         The ring stays, since a colour that moves says a pad is playing and an edge says which
         one, and at a glance across nine of them the edge is what the eye lands on first. -->
    <Style Selector="ToggleButton.pad:checked">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <!-- And the theme's own checked colour has to be told as well, or none of the above is
         visible: a button of this toolkit paints its content with the accent while it is
         checked, from inside its own template, where a background set on the button cannot
         reach. The pad's own colour is handed back in. -->
    <Style Selector="ToggleButton.pad:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{Binding $parent[ToggleButton].Background}"/>
    </Style>

    <!-- The breath itself: a wash over the pad's own colour rather than a second colour, so what
         moves is the pad's own brightness. Over the whole pad and under everything on it, so the
         lettering and the meters are not what is pulsing.

         Nought when it is not playing, which is what keeps this off the frame clock: the
         animation is on the class, and the class follows what the pad is doing. -->
    <Style Selector="Border.breath">
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="IsHitTestVisible" Value="False"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style Selector="Border.breath.playing">
      <Style.Animations>
        <Animation Duration="0:0:1.4" IterationCount="INFINITE" PlaybackDirection="Alternate"
                   Easing="SineEaseInOut">
          <KeyFrame Cue="0%">
            <Setter Property="Opacity" Value="0.0"/>
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="Opacity" Value="0.16"/>
          </KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>

    <Style Selector="Border.profileBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.primary">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgBrush}" Classes="tabRoot">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="14">

      <Border Grid.Row="0" Classes="profileBar">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="muted" Text="Profile:"/>
            <TextBlock Classes="primary" FontWeight="SemiBold" Text="{Binding SelectedProfileName}"/>
          </StackPanel>

          <!-- The same button a machine's face carries and the mixer's card has in its own
               corner, for the same reason: the pads are pointed at by resting the pointer on one
               and touching the hardware, and a page you can do that on should say so out loud
               rather than leaving the keystroke to be known. -->
          <ui:PushButton Grid.Column="1" x:Name="PadsMenuButton"
                         Mark="Bars" CapWidth="30" CapHeight="20"
                         Pressed="PadsMenu_Pressed"
                         ToolTip.Tip="What your controllers do to the pads. Point one at a template you have already made, or start learning." />
        </Grid>
      </Border>

      <!-- Pulled out by what each pad puts between itself and the next, so the outside edge
           of the grid lands on the same line as the bar above it rather than six pixels in.
           Not at the foot: the bottom row wants room between it and the status bar, or the
           pads look as though they have been cut off by it. -->
      <ItemsControl Grid.Row="1"
                    Margin="-6,-6,-6,0"
                    ItemsSource="{Binding Pads}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding PadColumns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadViewModel">
            <Border Margin="6">
              <ToggleButton Classes="pad"
                            views:Pointable.Offers="{Binding PadLink}"
                            IsChecked="{Binding IsPlaying, Mode=OneWay}"
                            Command="{Binding TogglePlayCommand}"
                            Background="{Binding PadBackground,
                                         Converter={StaticResource NullToUnset}}">
                <Grid>
                  <!-- The breath, under everything else on the pad. -->
                  <Border Classes="breath" Classes.playing="{Binding IsPlaying}" />

                  <!-- Pad title centred -->
                  <TextBlock Text="{Binding Title}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />

                  <!-- Volume + VU meter: bottom-left, 1/3 of pad height -->
                  <Grid RowDefinitions="2*,*"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="6,6,0,6"
                        IsVisible="{Binding HasSource}">
                    <Border Grid.Row="1"
                            Background="#CC000000"
                            CornerRadius="3"
                            Padding="3">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <!-- Volume bar (shows fade in/out) -->
                        <ctrl:VolumeMeter Width="8" Level="{Binding ChannelVolume}"
                                          FillBrush="#881E88E5" />
                        <!-- VU meter (real audio peaks) -->
                        <ctrl:VolumeMeter Width="8" Level="{Binding CurrentVolume}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Playback circle: top-right (files only) -->
                  <ctrl:CircleCountdown Width="16" Height="16"
                                        Progress="{Binding PlaybackProgress}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,6,0"
                                        IsVisible="{Binding IsRecording}" />

                  <!-- Stream indicator: top-right (streams only) -->
                  <TextBlock Text="📡"
                             FontSize="14"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,6,0"
                             Opacity="0.8"
                             IsVisible="{Binding IsStream}" />
                </Grid>
              </ToggleButton>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</UserControl>
