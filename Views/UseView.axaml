<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.UseView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="ToggleButton.pad">
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="ToggleButton.pad:checked">
      <Setter Property="Background" Value="#1E3A1E"/>
    </Style>

    <Style Selector="Border.profileBar">
      <Setter Property="Background" Value="#101010"/>
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>
  </UserControl.Styles>

  <Border Padding="24">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="14">

      <!-- Profile indicator (does NOT affect pad sizing logic) -->
      <Border Grid.Row="0" Classes="profileBar">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Opacity="0.75" Text="Profile:"/>
          <TextBlock FontWeight="SemiBold" Text="{Binding SelectedProfileName}"/>
        </StackPanel>
      </Border>

      <!-- Pads -->
      <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding Pads}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="2"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadViewModel">
            <Border Margin="10">
              <ToggleButton Classes="pad"
                            IsChecked="{Binding IsPlaying, Mode=OneWay}"
                            Command="{Binding TogglePlayCommand}"
                            Content="{Binding Title}" />
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</UserControl>
