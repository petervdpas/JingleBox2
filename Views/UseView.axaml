<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:ctrl="clr-namespace:JingleBox2.Controls"
             x:Class="JingleBox2.Views.UseView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="ToggleButton.pad">
      <Setter Property="Background" Value="{DynamicResource PadBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ToggleButton.pad:pointerover">
      <Setter Property="Background" Value="{DynamicResource PadHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="ToggleButton.pad:checked">
      <Setter Property="Background" Value="{DynamicResource PadCheckedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <!-- checked can be bright (Neon/Industrial) -->
      <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <Style Selector="Border.profileBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.primary">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgBrush}" Padding="24">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="14">

      <Border Grid.Row="0" Classes="profileBar">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="muted" Text="Profile:"/>
          <TextBlock Classes="primary" FontWeight="SemiBold" Text="{Binding SelectedProfileName}"/>
        </StackPanel>
      </Border>

      <ItemsControl Grid.Row="1"
                    ItemsSource="{Binding Pads}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding Columns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadViewModel">
            <Border Margin="10">
              <ToggleButton Classes="pad"
                            IsChecked="{Binding IsPlaying, Mode=OneWay}"
                            Command="{Binding TogglePlayCommand}"
                            Background="{Binding PadBackground,
                                         Converter={StaticResource NullToUnset}}">
                <Grid>
                  <!-- Pad title centred -->
                  <TextBlock Text="{Binding Title}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />

                  <!-- Indicators: top-right corner -->
                  <StackPanel Orientation="Horizontal"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Top"
                              Spacing="3"
                              Margin="0,4,6,0">
                    <TextBlock Text="▲" FontSize="10" Opacity="0.7"
                               IsVisible="{Binding HasFadeIn}" />
                    <TextBlock Text="▼" FontSize="10" Opacity="0.7"
                               IsVisible="{Binding HasFadeOut}" />
                    <ctrl:CircleCountdown Width="16" Height="16"
                                          Progress="{Binding PlaybackProgress}"
                                          IsVisible="{Binding HasSource}" />
                  </StackPanel>
                </Grid>
              </ToggleButton>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</UserControl>
