<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:ctrl="clr-namespace:JingleBox2.Controls"
             x:Class="JingleBox2.Views.UseView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="ToggleButton.pad">
      <Setter Property="Background" Value="{DynamicResource PadBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>

      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>

      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="ToggleButton.pad:pointerover">
      <Setter Property="Background" Value="{DynamicResource PadHoverBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <Style Selector="ToggleButton.pad:checked">
      <Setter Property="Background" Value="{DynamicResource PadCheckedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="BorderThickness" Value="2"/>
      <!-- checked can be bright (Neon/Industrial) -->
      <Setter Property="Foreground" Value="#000000"/>
    </Style>

    <Style Selector="Border.profileBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="10,8"/>
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>
    <Style Selector="TextBlock.primary">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgBrush}" Padding="0,6">
    <Grid RowDefinitions="Auto,*"
          RowSpacing="14">

      <Border Grid.Row="0" Classes="profileBar">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Classes="muted" Text="Profile:"/>
          <TextBlock Classes="primary" FontWeight="SemiBold" Text="{Binding SelectedProfileName}"/>
        </StackPanel>
      </Border>

      <!-- Pulled out by what each pad puts between itself and the next, so the outside edge
           of the grid lands on the same line as the bar above it rather than six pixels in.
           Not at the foot: the bottom row wants room between it and the status bar, or the
           pads look as though they have been cut off by it. -->
      <ItemsControl Grid.Row="1"
                    Margin="-6,-6,-6,0"
                    ItemsSource="{Binding Pads}"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="{Binding PadColumns}"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:PadViewModel">
            <Border Margin="6">
              <ToggleButton Classes="pad"
                            IsChecked="{Binding IsPlaying, Mode=OneWay}"
                            Command="{Binding TogglePlayCommand}"
                            Background="{Binding PadBackground,
                                         Converter={StaticResource NullToUnset}}">
                <Grid>
                  <!-- Pad title centred -->
                  <TextBlock Text="{Binding Title}"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />

                  <!-- Volume + VU meter: bottom-left, 1/3 of pad height -->
                  <Grid RowDefinitions="2*,*"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="6,6,0,6"
                        IsVisible="{Binding HasSource}">
                    <Border Grid.Row="1"
                            Background="#CC000000"
                            CornerRadius="3"
                            Padding="3">
                      <StackPanel Orientation="Horizontal" Spacing="3">
                        <!-- Volume bar (shows fade in/out) -->
                        <ctrl:VolumeMeter Width="8" Level="{Binding ChannelVolume}"
                                          FillBrush="#881E88E5" />
                        <!-- VU meter (real audio peaks) -->
                        <ctrl:VolumeMeter Width="8" Level="{Binding CurrentVolume}" />
                      </StackPanel>
                    </Border>
                  </Grid>

                  <!-- Playback circle: top-right (files only) -->
                  <ctrl:CircleCountdown Width="16" Height="16"
                                        Progress="{Binding PlaybackProgress}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,6,0"
                                        IsVisible="{Binding IsRecording}" />

                  <!-- Stream indicator: top-right (streams only) -->
                  <TextBlock Text="📡"
                             FontSize="14"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Top"
                             Margin="0,4,6,0"
                             Opacity="0.8"
                             IsVisible="{Binding IsStream}" />
                </Grid>
              </ToggleButton>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </Grid>
  </Border>
</UserControl>
