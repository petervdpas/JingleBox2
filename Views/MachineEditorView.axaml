<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:vmr="clr-namespace:JingleBox2.ViewModels.Records"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:machines="clr-namespace:JingleBox2.Machines;assembly=JingleBox2.Machines.Abstractions"
             xmlns:ui="clr-namespace:JingleBox2.Machines.Ui;assembly=JingleBox2.Machines.Ui"
             x:Class="JingleBox2.Views.MachineEditorView"
             x:DataType="vm:MainViewModel">

  <!-- Where a machine is built. The rack, in the tracker, is what is installed; this is the
       workshop, and what it holds is a project on disc: a folder with the machine in it, which
       is the thing that gets installed and, one day, sold.

       Four columns, left to right in the order the work goes: the parts you can put on a panel,
       the panel itself with its parameters under it, and what the thing you have picked is set
       to. -->
  <UserControl.Styles>
    <!-- A line in the utilities list: a row you press, not a button with a caption. Its own
         frame whether or not the pointer is over it, the same way a take on the shelf keeps
         one, because a list that draws a box only under the hand reads as a page of text. -->
    <Style Selector="Button.tool">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- The line a part would land on, while a hand is over it. The same accent the panel
         outlines with, so the two halves of the same drag look like one thing. -->
    <Style Selector="TextBlock.landing">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource BgBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A part in the library, which looks like a button and is not one. -->
    <Style Selector="Border.part">
      <Setter Property="Background" Value="{DynamicResource PadBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Every example gets the same box whatever it is a picture of, so the library reads as a
         row of parts rather than as a row of different sized pictures. -->
    <Style Selector="Border.sample">
      <Setter Property="Width" Value="86" />
      <Setter Property="Height" Value="50" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.part:pointerover">
      <Setter Property="Background" Value="{DynamicResource PadHoverBrush}" />
    </Style>

  </UserControl.Styles>

  <!-- The page, with a layer over it for the thing being carried. The layer is deaf to the
       pointer: it is a picture of what is in your hand and never something to aim at. -->
  <Panel>

  <DockPanel Classes="tabRoot">

    <Border DockPanel.Dock="Top" Classes="card">
      <StackPanel Classes="cardBody">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="cardTitle" VerticalAlignment="Center"
                     Text="{Binding MachineEditor.Title}" />

          <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                     Margin="8,0,0,0"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding MachineEditor.Project.Folder}" />

          <CheckBox Grid.Column="2" Content="Design" VerticalAlignment="Center"
                    IsChecked="{Binding MachineEditor.Designing}"
                    IsVisible="{Binding MachineEditor.CanDesign}"
                    ToolTip.Tip="On, a click picks a control up to be worked on. Off, the panel is the panel and a click turns it." />

          <Button Grid.Column="3" Content="New" Command="{Binding MachineEditor.NewCommand}"
                  ToolTip.Tip="A machine nobody has made yet. It gets its id now and keeps it forever." />

          <Button Grid.Column="4" Content="Open..." Click="Open_Click" />

          <!-- Warm while what is on screen is not what is in the folder. The same thing the
               song's Save button does, and for the same reason: a colour is read without being
               decoded. -->
          <Button Grid.Column="5" Content="Save" Click="Save_Click"
                  Classes.unsaved="{Binding MachineEditor.NeedsSaving}"
                  IsEnabled="{Binding MachineEditor.HasProject}"
                  ToolTip.Tip="Writes the machine to its folder. The button warms while there are changes that are not on disc yet." />

          <!-- The whole folder, not the manifest alone: a machine is its pictures, its presets
               and its sounds as much as its description. Beside Save because that is where a
               hand looks for it, and because the two differ by one question. -->
          <Button Grid.Column="6" Content="Save as..." Click="SaveAs_Click"
                  IsEnabled="{Binding MachineEditor.CanExport}"
                  ToolTip.Tip="Writes the whole machine into a folder you choose, pictures and presets and sounds and all, and works there from now on. The folder it came from is left as it was." />

          <!-- Back to the folder, not back one step. Dead for a machine that has never been
               written down, whose changes are the whole of it. -->
          <Button Grid.Column="7" Content="Cancel changes" Click="Cancel_Click"
                  IsEnabled="{Binding MachineEditor.CanCancelChanges}"
                  ToolTip.Tip="Throws away everything done since the last save and reads the machine back as it was. Asked first, because it cannot be undone." />

          <Button Grid.Column="8" Content="Export..." Click="Export_Click"
                  IsEnabled="{Binding MachineEditor.CanExport}"
                  ToolTip.Tip="Writes the whole machine out as a zip: the manifest, the panel and the sounds it ships with. That zip is what somebody else imports on the SETTINGS tab." />
        </Grid>

        <TextBlock Classes="cardHint" Text="{Binding MachineEditor.Status}"
                   IsVisible="{Binding MachineEditor.Status.Length}" />
      </StackPanel>
    </Border>

    <!-- The columns either side are only as wide as they are because of what is in them, and
         once everything in one is folded there is nothing in it but two titles, which is how
         the panel in the middle gets the room. Written out line by line because a width that
         changes has to be bound, and the short form cannot be. Both ways, so that a width the
         handle beside it set is the width the column comes back to. -->
    <!-- Two jobs, two tabs. What the machine looks like and what it sounds like when somebody
         first meets it have nothing to say to each other, and on one screen neither gets the
         room. The Design switch belongs to the first: on the other there is no panel being laid
         out for it to be about. -->
    <TabControl Classes="jobs" Margin="0,8,0,0" Padding="0"
                IsVisible="{Binding MachineEditor.HasProject}"
                SelectedIndex="{Binding MachineEditor.Page, Mode=TwoWay}">
      <TabControl.Styles>
        <!-- The size the pages across the top are. Fluent's own is a headline and cutting it
             down turned them into a footnote; these are the two halves of the screen and want
             reading at a glance. -->
        <Style Selector="TabControl.jobs > TabItem">
          <Setter Property="FontSize" Value="16" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="2,0,2,5" />
          <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
      </TabControl.Styles>

    <TabItem Header="Screen">
    <Grid Margin="0,8,0,0" MinWidth="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding MachineEditor.LeftWidth, Mode=TwoWay}" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="{Binding MachineEditor.RightWidth, Mode=TwoWay}" />
      </Grid.ColumnDefinitions>

      <!-- What a panel can be made of. Drag one onto the panel to put it inside whatever it
           lands on, or click it to put it inside whatever is picked. -->
      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="{Binding MachineEditor.PartsHeight, Mode=TwoWay}" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding MachineEditor.PanelHeight, Mode=TwoWay}" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Classes="card">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Classes="fold"
                          IsChecked="{Binding MachineEditor.PartsOpen}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chevron" Text="▾" VerticalAlignment="Center" />
                <TextBlock Classes="cardTitle" Text="Parts" />
              </StackPanel>
            </ToggleButton>

            <!-- The card, less its title. Folded it is not hidden but gone, so the row it is in
                 has nothing to measure and shrinks to the title above it. -->
            <DockPanel IsVisible="{Binding MachineEditor.PartsOpen}">
              <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" TextWrapping="Wrap"
                         Margin="0,6,0,0"
                         Text="A grid, a group, a row, a column and a strip hold other things. The rest are what you see." />

              <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding MachineEditor.Library}" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sys:String">
                    <!-- Not a button. A button takes the press for itself, and a part has to feel
                         the press to be picked up and dragged.

                         The example is the real control, small and dead to the pointer, because a
                         panel is chosen by eye: knowing which of a knob and a fader you want is
                         looking at them, not reading the two words. -->
                    <Border Classes="part" Tag="{Binding}" PointerPressed="Part_PointerPressed"
                            ToolTip.Tip="{Binding}">
                      <StackPanel Spacing="1">
                        <Border Classes="sample">
                          <ui:MachinePartSample Kind="{Binding}" />
                        </Border>

                        <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="10" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </DockPanel>
        </Border>

        <!-- Gone with either card it lies between: a handle answers by putting a size on both
             of them, which would pull a folded card open again the moment it was dragged. -->
        <GridSplitter Grid.Row="1" Classes="handle rows" ResizeDirection="Rows"
                      Height="10" HorizontalAlignment="Stretch"
                      IsVisible="{Binding MachineEditor.PartsPanelSizable}"
                      ToolTip.Tip="Drag to share the room between the parts and the panel." />

        <!-- The same panel as a list. Some things are easier to hit here than on the panel:
             an empty row, or a group with something on top of it. -->
        <Border Grid.Row="2" Classes="card">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Classes="fold"
                          IsChecked="{Binding MachineEditor.PanelOpen}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chevron" Text="▾" VerticalAlignment="Center" />
                <TextBlock Classes="cardTitle" Text="Panel" />
              </StackPanel>
            </ToggleButton>

            <DockPanel IsVisible="{Binding MachineEditor.PanelOpen}">
              <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6"
                    Margin="0,8,0,0">
                <Button Grid.Column="0" Content="Remove" Classes="danger"
                        HorizontalAlignment="Stretch"
                        IsEnabled="{Binding MachineEditor.HasSelection}"
                        Command="{Binding MachineEditor.RemoveElementCommand}" />

                <Button Grid.Column="1" Content="↑"
                        IsEnabled="{Binding MachineEditor.HasSelection}"
                        Command="{Binding MachineEditor.MoveUpCommand}"
                        ToolTip.Tip="Earlier among the things beside it, which is further left or further up." />

                <Button Grid.Column="2" Content="↓"
                        IsEnabled="{Binding MachineEditor.HasSelection}"
                        Command="{Binding MachineEditor.MoveDownCommand}" />
              </Grid>

              <!-- A part can be dropped on a line here as well as on the panel. Some containers
                   have nothing in them yet and so nothing on screen to aim at. -->
              <TreeView x:Name="PanelTree"
                        ItemsSource="{Binding MachineEditor.Elements}"
                        SelectedItem="{Binding MachineEditor.SelectedElement, Mode=TwoWay}"
                        Margin="0,8,0,0">
                <TreeView.Styles>
                  <!-- The branch says whether it is open, so picking something on the panel can
                       open the way down to it. -->
                  <Style Selector="TreeViewItem" x:DataType="vm:MachineElementViewModel">
                    <Setter Property="IsExpanded" Value="{Binding IsOpen, Mode=TwoWay}" />
                  </Style>
                </TreeView.Styles>
                <TreeView.ItemTemplate>
                  <TreeDataTemplate x:DataType="vm:MachineElementViewModel" ItemsSource="{Binding Children}">
                    <!-- Written out again rather than shared: one menu is one control and can
                         hang off one thing, and the panel has its own. The commands are the
                         same three. -->
                    <TextBlock Text="{Binding Display}"
                               Classes.landing="{Binding IsDropTarget}"
                               PointerPressed="Row_PointerPressed">
                      <TextBlock.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Remove"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.RemoveElementCommand}" />
                          <Separator />
                          <MenuItem Header="Move earlier"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.MoveUpCommand}" />
                          <MenuItem Header="Move later"
                                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.MoveDownCommand}" />
                        </ContextMenu>
                      </TextBlock.ContextMenu>
                    </TextBlock>
                  </TreeDataTemplate>
                </TreeView.ItemTemplate>
              </TreeView>
            </DockPanel>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns" Width="10"
                    IsVisible="{Binding MachineEditor.LeftColumnSizable}"
                    ToolTip.Tip="Drag to give the parts and the panel list more room." />

      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding MachineEditor.ParametersHeight, Mode=TwoWay}" />
        </Grid.RowDefinitions>

        <!-- The machine, drawn from its own description, in its own colours. Turning a knob here
             changes nothing but the knob: a value belongs to an instrument in a song, not to the
             machine. -->
        <Border Grid.Row="0" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="{Binding MachineEditor.Title}" />

            <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" TextWrapping="Wrap"
                       Margin="0,8,0,0"
                       Text="Drop a part onto whatever should hold it. Click a part of the panel to work on it. A grid puts what it holds where the row and column say." />

            <!-- The machine's colours stop here, at the plate the machine is on. Outside it are
                 the words this program is saying about the machine, and those have to stay
                 readable: painted in the machine's shades they are its own muted grey on its own
                 face, which is a line nobody can read on a dark machine. -->
            <Border x:Name="PanelPreview" Classes="inset" Margin="0,8,0,0" Padding="8"
                    TextElement.Foreground="{DynamicResource TextPrimaryBrush}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto">
              <!-- Stretched, not sized to what is on it. What is drawn stays at the top left
                   either way, and a panel only as big as its knobs would leave a new machine
                   with nowhere to drop the first one. -->
              <ui:MachinePanelView x:Name="PanelCanvas"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   MinHeight="200"
                                   Face="{Binding MachineEditor.Shown}"
                                   Values="{Binding MachineEditor.Values}"
                                   Takes="{Binding MachineEditor.Takes}"
                                   Presets="{Binding MachineEditor.Presets}"
                                   Pads="{Binding MachineEditor.PreviewPads}"
                                   Zones="{Binding MachineEditor.PreviewZones}"
                                   Scope="{Binding MachineEditor.PreviewScope}"
                                   Location="{Binding MachineEditor.PreviewLocation}"
                                   Slices="{Binding MachineEditor.PreviewSlices}"
                                   Selected="{Binding MachineEditor.SelectedShape, Mode=TwoWay}"
                                   Designing="{Binding MachineEditor.Designing}">
                <!-- The same three things the buttons under the panel list do, where the hand
                     already is. A right press picks the element up first, so the menu is always
                     about whatever was pressed rather than whatever was picked last. -->
                <ui:MachinePanelView.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Remove"
                              Command="{Binding MachineEditor.RemoveElementCommand}"
                              IsEnabled="{Binding MachineEditor.HasSelection}" />
                    <Separator />
                    <MenuItem Header="Move earlier"
                              Command="{Binding MachineEditor.MoveUpCommand}"
                              IsEnabled="{Binding MachineEditor.HasSelection}" />
                    <MenuItem Header="Move later"
                              Command="{Binding MachineEditor.MoveDownCommand}"
                              IsEnabled="{Binding MachineEditor.HasSelection}" />
                  </ContextMenu>
                </ui:MachinePanelView.ContextMenu>
              </ui:MachinePanelView>
            </ScrollViewer>
            </Border>
          </DockPanel>
        </Border>

        <GridSplitter Grid.Row="1" Classes="handle rows" ResizeDirection="Rows"
                      Height="10" HorizontalAlignment="Stretch"
                      IsVisible="{Binding MachineEditor.PanelParametersSizable}"
                      ToolTip.Tip="Drag to share the room between the panel and its parameters." />

        <!-- What the machine can be set to. This is most of what a machine is: the panel is these
             drawn, the patch is these stored, and an instrument in a song is these with values in
             them. -->
        <Border Grid.Row="2" Classes="card">
          <DockPanel>
            <!-- The hint and the button belong to the list, not to the title, so they go with
                 it: folded, there is nothing to add a parameter to on screen. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
              <ToggleButton Grid.Column="0" Classes="fold"
                            IsChecked="{Binding MachineEditor.ParametersOpen}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="chevron" Text="▾" VerticalAlignment="Center" />
                  <TextBlock Classes="cardTitle" VerticalAlignment="Center" Text="Parameters" />
                </StackPanel>
              </ToggleButton>

              <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center" Margin="8,0,0,0"
                         IsVisible="{Binding MachineEditor.ParametersOpen}"
                         TextTrimming="CharacterEllipsis"
                         Text="Key is what files use and never changes. Name is what the panel says." />

              <Button Grid.Column="2" Content="+ Parameter"
                      IsVisible="{Binding MachineEditor.ParametersOpen}"
                      Command="{Binding MachineEditor.AddParameterCommand}" />
            </Grid>

            <!-- Across as well as down. A parameter's row is a fixed set of fields wider than
                 this column can be made, and without this the row's width becomes the column's
                 smallest width and pushes the machine's own details off the window. -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          IsVisible="{Binding MachineEditor.ParametersOpen}">
              <ItemsControl ItemsSource="{Binding MachineEditor.Parameters}" Margin="0,10,0,0">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MachineParameterViewModel">
                    <Grid ColumnDefinitions="120,160,70,80,80,80,80,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                      <TextBox Grid.Column="0" Text="{Binding Key}" ToolTip.Tip="What this is stored under, forever." />
                      <TextBox Grid.Column="1" Text="{Binding Name}" ToolTip.Tip="What the panel calls it." />
                      <TextBox Grid.Column="2" Text="{Binding Unit}" PlaceholderText="unit" />
                      <TextBox Grid.Column="3" Text="{Binding Min}" ToolTip.Tip="Lowest it goes." />
                      <TextBox Grid.Column="4" Text="{Binding Max}" ToolTip.Tip="Highest it goes." />
                      <TextBox Grid.Column="5" Text="{Binding Default}" ToolTip.Tip="Where it sits before anybody touches it." />
                      <TextBox Grid.Column="6" Text="{Binding Step}" ToolTip.Tip="How far one notch moves it." />

                      <Button Grid.Column="7" Content="✕" Classes="danger"
                              Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MachineEditor.RemoveParameterCommand}"
                              CommandParameter="{Binding}"
                              ToolTip.Tip="Takes it off the machine." />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" Classes="handle" ResizeDirection="Columns" Width="10"
                    IsVisible="{Binding MachineEditor.RightColumnSizable}"
                    ToolTip.Tip="Drag to give the panel more room, or the fields beside it." />

      <Grid Grid.Column="4">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="{Binding MachineEditor.PickedHeight, Mode=TwoWay}" />
        </Grid.RowDefinitions>

        <!-- What a machine is, before anything about how it sounds: its name, its id, who made
             it, and the colour it wears wherever it is shown. -->
        <Border Grid.Row="0" Classes="card">
          <StackPanel Classes="cardBody">
            <ToggleButton Classes="fold" IsChecked="{Binding MachineEditor.MachineOpen}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chevron" Text="▾" VerticalAlignment="Center" />
                <TextBlock Classes="cardTitle" Text="The machine" />
              </StackPanel>
            </ToggleButton>

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                  IsVisible="{Binding MachineEditor.MachineOpen}"
                  ColumnSpacing="10" RowSpacing="8">
              <!-- These write straight into the project, which is a plain object and says
                   nothing when it moves, so the editor is told here instead. On losing focus
                   rather than per keystroke: a name typed in is one edit and not eleven. -->
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Name:" />
              <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding MachineEditor.Project.Name}"
                       LostFocus="Machine_Changed" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="What it is:" />
              <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MachineEditor.Project.Summary}"
                       LostFocus="Machine_Changed"
                       PlaceholderText="One line, for somebody choosing between machines" />

              <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Made by:" />
              <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding MachineEditor.Project.Author}"
                       LostFocus="Machine_Changed" />

              <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Version:" />
              <TextBox Grid.Row="3" Grid.Column="1" Width="120" HorizontalAlignment="Left"
                       Text="{Binding MachineEditor.Project.Version}"
                       LostFocus="Machine_Changed" />

              <TextBlock Grid.Row="4" Grid.Column="0" Classes="label" Text="Id:" />
              <TextBlock Grid.Row="4" Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding MachineEditor.Project.Id}"
                         ToolTip.Tip="What songs write down. Made once, and never changed." />

              <!-- Picked off the picture rather than typed, because six hex digits say nothing
                   about whether the thing will look like a rack device. The seven shades the
                   colour is worked into are behind the button: most machines never touch them. -->
              <TextBlock Grid.Row="5" Grid.Column="0" Classes="label" Text="Colour:"
                         VerticalAlignment="Top" Margin="0,3,0,0" />
              <StackPanel Grid.Row="5" Grid.Column="1" Spacing="6"
                          IsEnabled="{Binding MachineEditor.HasProject}">
                <views:ColourPicker Height="124" Colour="{Binding MachineEditor.Accent, Mode=TwoWay}"
                                    ToolTip.Tip="The colour the machine wears wherever it is shown. It keeps it whichever theme the application is wearing." />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                  <TextBox Grid.Column="0" FontFamily="Consolas,Menlo,monospace"
                           Text="{Binding MachineEditor.AccentHex, UpdateSourceTrigger=LostFocus}" />
                  <Button Grid.Column="1" Content="Colours..." Click="Colours_Click"
                          ToolTip.Tip="The seven shades the colour is worked into: the face, the groups on it, the lines around them and the marks." />
                </Grid>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <GridSplitter Grid.Row="1" Classes="handle rows" ResizeDirection="Rows"
                      Height="10" HorizontalAlignment="Stretch"
                      IsVisible="{Binding MachineEditor.MachinePickedSizable}"
                      ToolTip.Tip="Drag to share the room between what the machine is and what you are working on." />

        <!-- The one thing that is picked, and everything about it. A control is a kind, the
             parameter it turns, and whatever else that kind understands. -->
        <Border Grid.Row="2" Classes="card">
          <DockPanel>
            <ToggleButton DockPanel.Dock="Top" Classes="fold"
                          IsChecked="{Binding MachineEditor.PickedOpen}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Classes="chevron" Text="▾" VerticalAlignment="Center" />
                <TextBlock Classes="cardTitle" Text="What is picked" />
              </StackPanel>
            </ToggleButton>

            <DockPanel IsVisible="{Binding MachineEditor.PickedOpen}">
              <TextBlock DockPanel.Dock="Top" Classes="cardHint" TextWrapping="Wrap"
                         IsVisible="{Binding !MachineEditor.HasSelection}"
                         Text="Nothing yet. Click something on the panel, or a line in the list." />

              <ContentControl Content="{Binding MachineEditor.SelectedElement}" Margin="0,8,0,0">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="vm:MachineElementViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                      <StackPanel Spacing="8">

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="10" RowSpacing="8">
                          <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Is a:" />
                          <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.Library}"
                                    SelectedItem="{Binding Kind}" />

                          <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Turns:" />
                          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Parameter}"
                                   PlaceholderText="a parameter's key"
                                   ToolTip.Tip="Which parameter this control is on. Empty for anything that turns nothing." />

                          <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Pick one:" />
                          <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                                    PlaceholderText="from the parameters..."
                                    SelectionChanged="Parameter_SelectionChanged"
                                    ItemsSource="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.ParameterKeys}" />

                          <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="Says:" />
                          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Label}"
                                   PlaceholderText="what is written on it"
                                   ToolTip.Tip="Empty leaves it to the parameter's own name." />
                        </Grid>

                        <!-- The picker is two controls wearing one name: one offers the machine's
                             own presets, the other offers your recordings and comes with a
                             category list in front of it. Which of the two is a setting on the
                             object rather than something to be worked out from the machine. -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                              IsVisible="{Binding IsPicker}">
                          <TextBlock Grid.Column="0" Classes="label" Text="Browses:" />
                          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                                    ItemsSource="{Binding Sources}"
                                    SelectedItem="{Binding Source, Mode=TwoWay}"
                                    ToolTip.Tip="Its own presets are a handful shipped with the machine. Your recordings run to hundreds, so that one gets a category list in front of it." />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                          <TextBlock Grid.Column="0" Classes="cardTitle" VerticalAlignment="Center" Text="Set to" />

                          <Button Grid.Column="2" Content="+ Property" Command="{Binding AddPropertyCommand}" />
                        </Grid>

                        <TextBlock Classes="cardHint" TextWrapping="Wrap"
                                   Text="A grid takes rows and columns, and anything in one takes row, column and span. A group takes a caption, a spacer takes width and height. Anything at all takes an align of top, centre or bottom, and a margin of left, top, right, bottom that nudges it out of line and stands in for the gap its row or column would have given it." />

                        <ItemsControl ItemsSource="{Binding Properties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MachineElementPropertyViewModel">
                              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="6" Margin="0,0,0,6">
                                <TextBox Grid.Column="0" Text="{Binding Key}" />
                                <TextBox Grid.Column="1" Text="{Binding Value}" />

                                <Button Grid.Column="2" Content="✕" Classes="danger"
                                        Command="{Binding $parent[ItemsControl].((vm:MachineElementViewModel)DataContext).RemovePropertyCommand}"
                                        CommandParameter="{Binding}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- The one property no list of text boxes can fill in. A picture has to
                             be inside the machine's folder to travel with it, so choosing one is
                             copying a file as well as naming it, and only the machine knows where
                             it goes. Everything else about a picture is typed above like any
                             other property, which is why this shows only while one is picked. -->
                        <!-- The other thing no list of text boxes can do. A grid of pads is
                             its buttons, and ninety six of them dropped one at a time is not a
                             designer, so the shape is said once and the buttons are written. -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.PadsPicked}">
                          <Grid ColumnDefinitions="Auto,56,Auto,56,Auto,70" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" Classes="field" Text="Grid" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.PadRows}"
                                     ToolTip.Tip="How many rows of buttons." />

                            <TextBlock Grid.Column="2" Classes="field" Text="by" />
                            <TextBox Grid.Column="3"
                                     Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.PadColumns}"
                                     ToolTip.Tip="How many stand side by side. Six by sixteen is ninety six buttons." />

                            <TextBlock Grid.Column="4" Classes="field" Text="From key" />
                            <TextBox Grid.Column="5"
                                     Text="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.PadFirstKey}"
                                     ToolTip.Tip="The note the first pad answers to, written as the machine writes it: C-4. The rest run up from there. A plain number is taken too." />
                          </Grid>

                          <Button Content="Lay the grid out" HorizontalAlignment="Left"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.LayPadsCommand}"
                                  ToolTip.Tip="Writes that many buttons, keyed from there. Names already in the grid are kept in order, so adding a row does not throw away the ones you named." />
                        </StackPanel>

                        <Button Content="Choose a picture..."
                                HorizontalAlignment="Left"
                                Click="Picture_Click"
                                IsVisible="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.PicturePicked}"
                                ToolTip.Tip="Copies a png or jpg into the machine's own images folder and writes its name into the file property." />

                      </StackPanel>
                    </ScrollViewer>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </DockPanel>
          </DockPanel>
        </Border>
      </Grid>

    </Grid>
    </TabItem>

    <TabItem Header="Presets">
    <!-- The presets page. A preset file is an instrument file, the same shape read by the same
         reader, so what there is to edit is the file. That is not a shortcut: a preset holds a
         pad pointing at a wave, a set of knobs, where a wave is cut, or nothing but a pointer at
         the recordings you already have, and a form with a box for each of those would be four
         forms, none of which could say the fifth thing somebody wants next. -->
    <Grid Margin="0,8,0,0" ColumnDefinitions="260,12,*" MinWidth="0">

      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Presets" />

          <TextBlock DockPanel.Dock="Top" Classes="cardHint" TextWrapping="Wrap"
                     Margin="0,4,0,8"
                     Text="One preset to a file, in the machine's own folder, so they travel in the zip when it is exported." />

          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,*" ColumnSpacing="6" Margin="0,8,0,0">
            <Button Grid.Column="0" Content="+ Preset" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    Command="{Binding MachineEditor.PresetDesk.NewCommand}"
                    IsEnabled="{Binding MachineEditor.PresetDesk.Ready}"
                    ToolTip.Tip="Writes a new file with the least a preset can be in it: a name, and a machine that plays your own recordings." />

            <Button Grid.Column="1" Content="Remove" Classes="danger"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Command="{Binding MachineEditor.PresetDesk.DeleteCommand}"
                    IsEnabled="{Binding MachineEditor.PresetDesk.HasPreset}"
                    ToolTip.Tip="Deletes the preset and the recordings it was the only one playing. A folder another preset plays out of is left alone, and so is anything in there no preset named." />
          </Grid>

          <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" TextWrapping="Wrap"
                     Margin="0,8,0,0"
                     IsVisible="{Binding !MachineEditor.PresetDesk.Ready}"
                     Text="Save the machine first. A preset lives in the machine's folder, and this one has not got one yet." />

          <ListBox ItemsSource="{Binding MachineEditor.PresetDesk.Presets}"
                   SelectedItem="{Binding MachineEditor.PresetDesk.Picked, Mode=TwoWay}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vmr:MachinePresetSlot">
                <StackPanel Spacing="1" Margin="0,2">
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="cardHint" Text="{Binding FileName}" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Grid.Column="0" Classes="cardTitle" VerticalAlignment="Center"
                       Text="{Binding MachineEditor.PresetDesk.Picked.Name}" />

            <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding MachineEditor.PresetDesk.Said}" />

            <Button Grid.Column="2" Content="Add waves..."
                    Click="PresetWaves_Click"
                    IsEnabled="{Binding MachineEditor.PresetDesk.HasForm}"
                    ToolTip.Tip="Brings recordings in from anywhere, copies them into the machine beside this preset, and writes them onto the pads in order. A preset plays files that live inside the machine, so that the machine can be handed to somebody." />

            <Button Grid.Column="3" Content="Save preset"
                    Command="{Binding MachineEditor.PresetDesk.SaveCommand}"
                    IsEnabled="{Binding MachineEditor.PresetDesk.HasForm}"
                    ToolTip.Tip="Writes the file back. Anything it plays from outside the machine is brought inside first, so the preset arrives whole on somebody else's disc." />
          </Grid>

          <!-- What is wrong with it, said where the mistake is rather than at the moment of
               saving. -->
          <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" TextWrapping="Wrap"
                     Margin="0,8,0,0" Foreground="{DynamicResource DangerBrush}"
                     IsVisible="{Binding MachineEditor.PresetDesk.HasProblem}"
                     Text="{Binding MachineEditor.PresetDesk.Problem}" />

          <!-- The preset, set out the way the machine's own description says. A parameter the
               machine declares is a knob where the machine is played and a line here: one
               declaration, drawn twice. No controls of the machine's own on this page, because
               what a preset is worth is judged by playing it on the rack. -->
          <!-- The one preset that is not settings. A machine whose whole sound is a recording
               of yours has none worth shipping, so it ships this instead, and this is what the
               picker on its panel reads to know it should offer your shelf. -->
          <TextBlock DockPanel.Dock="Top" Classes="cardHint" TextWrapping="Wrap"
                     Margin="0,10,0,0"
                     IsVisible="{Binding MachineEditor.PresetDesk.Browses}"
                     Text="This machine has no settings worth shipping: what it is, is the recording on it. So its picker offers your own takes, filed the way the RECORD tab files them, rather than a list of presets. Nothing here to fill in." />

          <!-- What the builder can still assign a value to, and the button that does it. A
               preset is what somebody put in it: a kit that sets four drums says four drums,
               and the twelve empty pads are nobody's business. -->
          <!-- What the builder can give a value to. Everything the machine has is in here,
               narrowed by what sort of thing it is, because the thing you are looking for on a
               machine with ninety six pads and thirty knobs is a pad or a knob before it is
               anything else. Both lists come off the machine's own description. -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,150,220,Auto" ColumnSpacing="8"
                Margin="0,10,0,0"
                IsVisible="{Binding MachineEditor.PresetDesk.HasForm}">
            <TextBlock Grid.Column="0" Classes="field" Text="Give a value to" />

            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding MachineEditor.PresetDesk.Form.Kinds}"
                      SelectedItem="{Binding MachineEditor.PresetDesk.Form.Kind, Mode=TwoWay}"
                      ToolTip.Tip="What sort of thing: a pad, a knob, a fader, a recording. The sorts this machine actually has, read off its own panel." />

            <ComboBox Grid.Column="2" HorizontalAlignment="Stretch"
                      ItemsSource="{Binding MachineEditor.PresetDesk.Form.Offers}"
                      SelectedItem="{Binding MachineEditor.PresetDesk.Form.Offered, Mode=TwoWay}"
                      ToolTip.Tip="Which one. Pads are listed by the key each answers to." />

            <Button Grid.Column="3" Content="+ Add"
                    Command="{Binding MachineEditor.PresetDesk.Form.AddCommand}"
                    IsEnabled="{Binding MachineEditor.PresetDesk.Form.HasOffers}"
                    ToolTip.Tip="Starts saying something about it. A pad arrives with the lines a pad has and nothing in them. One the preset already speaks about is left alone." />
          </Grid>

          <ScrollViewer Margin="0,8,0,0"
                        IsVisible="{Binding MachineEditor.PresetDesk.HasForm}">
            <ItemsControl ItemsSource="{Binding MachineEditor.PresetDesk.Form.Sections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PresetSection">
                  <StackPanel Spacing="2" Margin="0,0,0,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="0,0,0,2">
                      <!-- The name, said the way the machine says it. Where the machine declares
                           its things the name is the machine's and is read out; where it does not,
                           the name is nowhere else and is typed here. -->
                      <TextBlock Grid.Column="0" Classes="section"
                                 IsVisible="{Binding !CanRename}"
                                 Text="{Binding Heading}" />

                      <TextBox Grid.Column="0" Width="180" FontWeight="SemiBold"
                               IsVisible="{Binding CanRename}"
                               Text="{Binding Heading, Mode=TwoWay}"
                               ToolTip.Tip="What this one is called, in the preset and on the machine." />

                      <Button Grid.Column="2" Content="✕" Classes="danger"
                              Command="{Binding RemoveCommand}"
                              ToolTip.Tip="Takes it out of the preset, so the preset says nothing about it again." />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Lines}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetLine">
                          <!-- The line follows what kind of thing it is. A number and a name are
                               typed; a recording is picked, because a wave has to be brought
                               inside the machine before a preset can name it. -->
                          <Grid ColumnDefinitions="140,260,Auto,Auto" ColumnSpacing="8" Margin="0,0,0,3">
                            <TextBlock Grid.Column="0" Classes="field" Text="{Binding Name}" />

                            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay}"
                                     ToolTip.Tip="{Binding Text}" />

                            <Button Grid.Column="2" Content="..."
                                    IsVisible="{Binding IsWave}"
                                    Click="PresetWave_Click"
                                    ToolTip.Tip="Puts a recording on this one. It is copied into the machine, so the preset names a file that travels with it." />

                            <TextBlock Grid.Column="3" Classes="cardHint" VerticalAlignment="Center"
                                       Text="{Binding Unit}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
    </TabItem>

    <TabItem Header="Utilities" IsVisible="{Binding MachineEditor.ShowsUtilities}">
    <!-- The jobs somebody would otherwise do in a file manager and an audio editor. A list of
         them, and one of them open: two tools side by side already filled the width, and the
         ones still to come would not fit at all. -->
    <DockPanel Margin="0,8,0,0">

      <!-- Which preset the tools act on. The machine is the one open: its name is at the top of
           the window, and a page acting on a different one is a page you can level the wrong kit
           from without noticing. -->
      <Border DockPanel.Dock="Top" Classes="card">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" Classes="label" Text="Preset:" VerticalAlignment="Center" />

          <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                    ItemsSource="{Binding MachineEditor.Utilities.Presets}"
                    SelectedItem="{Binding MachineEditor.Utilities.Preset}"
                    ToolTip.Tip="One of the presets of the machine open in the designer. To work on another machine's, open that machine." />
        </Grid>
      </Border>

      <!-- What it did, under everything, so no tool has to keep its own line. -->
      <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" TextWrapping="Wrap" Margin="0,8,0,0"
                 Foreground="{DynamicResource DangerBrush}"
                 IsVisible="{Binding MachineEditor.Utilities.HasProblem}"
                 Text="{Binding MachineEditor.Utilities.Problem}" />

      <TextBlock DockPanel.Dock="Bottom" Classes="cardHint" Margin="0,8,0,0"
                 Text="{Binding MachineEditor.Utilities.Said}" />

      <Panel Margin="0,12,0,0">

        <!-- The list. -->
        <Border Classes="card" VerticalAlignment="Top"
                IsVisible="{Binding MachineEditor.Utilities.OnList}">
          <StackPanel Classes="cardBody">
            <TextBlock Classes="cardTitle" Text="Utilities" />

            <TextBlock Classes="cardHint" TextWrapping="Wrap"
                       Text="What there is to do to the machine open here that is not drawing its panel or filling in a preset. Only the ones that apply are listed." />

            <ItemsControl ItemsSource="{Binding MachineEditor.Utilities.Tools}" Margin="0,4,0,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vmr:UtilityTool">
                  <Button Classes="tool" HorizontalAlignment="Stretch" Margin="0,3"
                          HorizontalContentAlignment="Left"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineEditor.Utilities.OpenCommand}"
                          CommandParameter="{Binding}">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      <TextBlock Classes="cardHint" Text="{Binding Blurb}" TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Renaming a preset. -->
        <Border Classes="card" VerticalAlignment="Top"
                IsVisible="{Binding MachineEditor.Utilities.OnRename}">
          <StackPanel Classes="cardBody">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Grid.Column="0" Content="&#x2039; Back"
                      Command="{Binding MachineEditor.Utilities.BackCommand}" />

              <TextBlock Grid.Column="1" Classes="cardTitle" VerticalAlignment="Center"
                         Text="Rename a preset" />
            </Grid>

            <TextBlock Classes="cardHint" TextWrapping="Wrap" MaxWidth="640"
                       HorizontalAlignment="Left"
                       Text="Three things at once: the file, the name written inside it, and the folder its recordings sit in along with every path that points into it. The number the file starts with is kept, so a preset stays where it is in the list." />

            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6"
                  MaxWidth="640" HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="File:" />
              <TextBlock Grid.Row="0" Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding MachineEditor.Utilities.PresetFile}" />

              <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Recordings:" />
              <TextBlock Grid.Row="1" Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Text="{Binding MachineEditor.Utilities.WaveFolder}"
                         ToolTip.Tip="The folder this preset plays out of. It is renamed with the preset, unless another preset plays out of it too." />
            </Grid>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaxWidth="640"
                  HorizontalAlignment="Left" Margin="0,4,0,0">
              <TextBox Grid.Column="0" MinWidth="320"
                       Text="{Binding MachineEditor.Utilities.Wanted}"
                       IsEnabled="{Binding MachineEditor.Utilities.HasPreset}"
                       PlaceholderText="What it should be called" />

              <Button Grid.Column="1" Content="Rename"
                      Command="{Binding MachineEditor.Utilities.RenameCommand}"
                      IsEnabled="{Binding MachineEditor.Utilities.HasPreset}" />
            </Grid>
          </StackPanel>
        </Border>

        <!-- Levelling a set of recordings. -->
        <Border Classes="card" IsVisible="{Binding MachineEditor.Utilities.OnLevel}">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Grid.Column="0" Content="&#x2039; Back"
                      Command="{Binding MachineEditor.Utilities.BackCommand}" />

              <TextBlock Grid.Column="1" Classes="cardTitle" VerticalAlignment="Center"
                         Text="Level recordings" />
            </Grid>

            <TextBlock DockPanel.Dock="Top" Classes="cardHint" TextWrapping="Wrap" Margin="0,6,0,0"
                       Text="Rewritten where they lie. Recordings inside a machine travel with it, so the level travels too; a folder anywhere else is levelled where it is, which is how a pack is put right before any of it is brought in." />

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,Auto,Auto,*" ColumnSpacing="10"
                  Margin="0,10,0,0">
              <TextBlock Grid.Column="0" Classes="label" Text="Look at:" VerticalAlignment="Center" />

              <RadioButton Grid.Column="1" GroupName="scope" Content="This preset"
                           IsVisible="{Binding MachineEditor.Utilities.HasPreset}"
                           IsChecked="{Binding MachineEditor.Utilities.OnPresetScope}" />

              <RadioButton Grid.Column="2" GroupName="scope" Content="The whole machine"
                           IsChecked="{Binding MachineEditor.Utilities.OnMachineScope}"
                           ToolTip.Tip="Every recording every preset of this machine plays, each one once: a file two presets share is one file and is moved once." />

              <RadioButton Grid.Column="3" GroupName="scope" Content="A folder"
                           IsChecked="{Binding MachineEditor.Utilities.OnFolderScope}" />

              <Button Grid.Column="4" Content="Choose..." HorizontalAlignment="Left"
                      Click="LevelFolder_Click"
                      ToolTip.Tip="A folder of wav files anywhere on the disc, and everything under it." />
            </Grid>

            <TextBlock DockPanel.Dock="Top" Classes="cardHint" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding MachineEditor.Utilities.Looking}" />

            <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,180,Auto,Auto,*,Auto"
                  ColumnSpacing="10" Margin="0,10,0,0">
              <TextBlock Grid.Column="0" Classes="label" Text="Loudest onto:" VerticalAlignment="Center" />

              <ui:Slide Grid.Column="1" VerticalAlignment="Center"
                        Minimum="{Binding MachineEditor.Utilities.LeastTarget}"
                        Maximum="{Binding MachineEditor.Utilities.MostTarget}"
                        SmallStep="0.5" LargeStep="3" DefaultValue="-1"
                        Value="{Binding MachineEditor.Utilities.Target}" />

              <TextBlock Grid.Column="2" VerticalAlignment="Center" MinWidth="52"
                         FontFamily="Consolas,Menlo,monospace" FontSize="11"
                         Text="{Binding MachineEditor.Utilities.Target, StringFormat={}{0:0.0} dB}" />

              <CheckBox Grid.Column="3" VerticalAlignment="Center"
                        IsChecked="{Binding MachineEditor.Utilities.KeepsBalance}"
                        Content="Keep the balance"
                        ToolTip.Tip="One gain for the whole set, taken from the loudest file, so a kit that was simply recorded quiet comes up without the quiet things starting to shout. Off, every file is put on the target itself, which suits a folder of odds and ends that were never a set." />

              <Button Grid.Column="5" Content="Level them"
                      Command="{Binding MachineEditor.Utilities.LevelCommand}"
                      IsEnabled="{Binding MachineEditor.Utilities.CanLevel}" />
            </Grid>

            <Border Classes="inset" Margin="0,10,0,0" Padding="0">
              <Panel>
                <!-- Why it is empty, which is never the same reason twice: a synth carries no
                     recordings, and neither does the machine that plays your own shelf. -->
                <TextBlock Classes="cardHint" Margin="10,8" TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           IsVisible="{Binding !MachineEditor.Utilities.HasWaves}"
                           Text="{Binding MachineEditor.Utilities.Nothing}" />

                <ScrollViewer IsVisible="{Binding MachineEditor.Utilities.HasWaves}">
                  <ItemsControl ItemsSource="{Binding MachineEditor.Utilities.Waves}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:WaveLevel">
                        <Grid ColumnDefinitions="*,70,70" ColumnSpacing="8" Margin="8,3">
                          <TextBlock Grid.Column="0" Text="{Binding Name}"
                                     ToolTip.Tip="{Binding Named}"
                                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                          <TextBlock Grid.Column="1" Text="{Binding PeakText}"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />

                          <TextBlock Grid.Column="2" Text="{Binding GainText}" Classes="cardHint"
                                     FontFamily="Consolas,Menlo,monospace" FontSize="11"
                                     HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Panel>
            </Border>
          </DockPanel>
        </Border>

      </Panel>
    </DockPanel>
    </TabItem>

    </TabControl>

  </DockPanel>

  <Canvas x:Name="GhostLayer" IsHitTestVisible="False" />

  </Panel>

</UserControl>
