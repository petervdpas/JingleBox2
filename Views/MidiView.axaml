<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:JingleBox2.ViewModels"
  xmlns:conv="clr-namespace:JingleBox2.Converters"
  x:Class="JingleBox2.Views.MidiView"
  x:Name="Root"
  x:DataType="vm:MidiViewModel">

  <UserControl.Resources>
    <conv:LearnButtonTextConverter x:Key="LearnText" />
  </UserControl.Resources>

  <!-- The mapping table, and nothing else. This was a dialog of its own once. What goes with
       it, how big the matrix is and what a pad does when it is hit, sits above it in SETTINGS
       where it can be read while the table is.

       No DataGrid: Avalonia's crashes in its constructor here. -->
  <Border Classes="card">
      <StackPanel Classes="cardBody">
        <TextBlock Classes="cardTitle" Text="Pad mapping" />

        <TextBlock Classes="cardHint" Text="{Binding PadDeviceSummary}" />

        <!-- Header row -->
        <Grid ColumnDefinitions="36,52,56,76,Auto"
          ColumnSpacing="10"
          Margin="0,0,0,6"
          Opacity="0.85">
          <TextBlock Grid.Column="0" Text="Pad" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Ch" FontWeight="SemiBold" />
          <TextBlock Grid.Column="3" Text="Note/CC" FontWeight="SemiBold" />
          <TextBlock Grid.Column="4" Text="" />
        </Grid>

        <!-- Rows -->
        <ItemsControl ItemsSource="{Binding Pads}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="36,52,56,76,Auto"
                ColumnSpacing="10"
                Margin="0,4">

                <TextBlock Grid.Column="0"
                  VerticalAlignment="Center"
                  Text="{Binding PadIndex}" />

                <!-- Keep as TextBlock for now (Type edits optional later) -->
                <TextBlock Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding Type}" />

                <TextBox Grid.Column="2"
                  VerticalAlignment="Center"
                  Text="{Binding Channel}" />

                <TextBox Grid.Column="3"
                  VerticalAlignment="Center"
                  Text="{Binding Value}" />

                <Button Grid.Column="4"
                  Content="{Binding IsLearning, Converter={StaticResource LearnText}}"
                  IsEnabled="{Binding ((vm:MidiViewModel)DataContext).HasPadDevice, ElementName=Root}"
                  Command="{Binding ((vm:MidiViewModel)DataContext).LearnCommand, ElementName=Root}"
                  CommandParameter="{Binding}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

      </StackPanel>
      </Border>

</UserControl>
