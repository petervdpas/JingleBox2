<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:JingleBox2.ViewModels"
  xmlns:conv="clr-namespace:JingleBox2.Converters"
  x:Class="JingleBox2.Views.MidiView"
  x:Name="Root"
  x:DataType="vm:MidiViewModel">

  <UserControl.Resources>
    <conv:LearnButtonTextConverter x:Key="LearnText" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Classes="tabRoot">

      <!-- Mapping (no DataGrid; avoids Avalonia DataGrid ctor crash) -->
      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Pad mapping (global)" />

          <TextBlock Text="{Binding Status}" Opacity="0.85"
            IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <!-- Header row -->
          <Grid ColumnDefinitions="60,120,60,90,90"
            ColumnSpacing="10"
            Margin="0,0,0,6"
            Opacity="0.85">
            <TextBlock Grid.Column="0" Text="Pad" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
            <TextBlock Grid.Column="2" Text="Ch" FontWeight="SemiBold" />
            <TextBlock Grid.Column="3" Text="Note/CC" FontWeight="SemiBold" />
            <TextBlock Grid.Column="4" Text="" />
          </Grid>

          <!-- Rows -->
          <ItemsControl ItemsSource="{Binding Pads}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="60,120,60,90,90"
                  ColumnSpacing="10"
                  Margin="0,4">

                  <TextBlock Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding PadIndex}" />

                  <!-- Keep as TextBlock for now (Type edits optional later) -->
                  <TextBlock Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding Type}" />

                  <TextBox Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Channel}" />

                  <TextBox Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="{Binding Value}" />

                  <Button Grid.Column="4"
                    Content="{Binding IsLearning, Converter={StaticResource LearnText}}"
                    Command="{Binding ((vm:MidiViewModel)DataContext).LearnCommand, ElementName=Root}"
                    CommandParameter="{Binding}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>

      <!-- Behavior -->
      <Border Classes="card">
        <CheckBox Content="Toggle mode (press again to stop)"
          IsChecked="{Binding ToggleMode}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>