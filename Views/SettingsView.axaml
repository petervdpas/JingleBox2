<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Machines.Ui;assembly=JingleBox2.Machines.Ui"
             x:Class="JingleBox2.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.padCount">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <!-- The rail down the side: the page has grown past what one column of cards can be read
         in, and a setting somebody is looking for is easier to find under a heading than by
         scrolling past everything else. Vertical rather than across the top, because the
         headings are words and words read better in a column. -->
    <!-- Across the top instead, for a window too narrow to give a hundred and fifty pixels to
         a list of five words. The switch is made in the code behind, since a width is not
         something a style can ask about. -->
    <Style Selector="TabControl.strip > TabItem">
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="TabControl.rail > TabItem">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="12,9" />
    </Style>

    <!-- Down the side, the sections are a column of words and every one of them is as wide
         as the column: a heading you click has the whole width to be clicked on. Across the
         top they are a row. -->
    <Style Selector="TabControl.rail">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <Style Selector="TabControl.strip">
      <Setter Property="ItemsPanel">
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter>
    </Style>

    <!-- Across the top, the sections sit above their settings and the handle has nothing to
         divide. -->
    <Style Selector="TabControl.strip /template/ ItemsPresenter#PART_ItemsPresenter">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Grid.RowSpan" Value="1" />
    </Style>

    <Style Selector="TabControl.strip /template/ GridSplitter#PART_Handle">
      <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="TabControl.strip /template/ ContentPresenter#PART_SelectedContentHost">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Padding" Value="0,8,0,0" />
    </Style>

  </UserControl.Styles>

  <!-- One part at a time. Everything here used to be one column of cards taller than the
       window, which is a page you scroll rather than a page you read. -->
  <TabControl x:Name="Sections" Classes="rail" TabStripPlacement="Left" Margin="0,6" Padding="0">

    <!-- A shape of its own, so the line between the sections and their settings can be
         dragged. A docked tab strip has nowhere to put a handle: it is as wide as it is and
         there is no arguing with it. Three columns and two rows instead, holding the same
         two parts a tab control always has, with the handle between them; which part sits
         where is what the rail and strip styles above decide. The handle is the hairline
         that used to be the settings' left border.

         Set here rather than in a style, because a control that is handed a different
         template while it is on screen puts its content into the new one before the old one
         has let go, and Avalonia will not have the same thing in two places at once. -->
    <TabControl.Template>
      <ControlTemplate>
        <Grid RowDefinitions="Auto,*">
          <Grid.ColumnDefinitions>
            <!-- Wide enough for the longest heading to start with. The stops are where the
                 words stop being readable and where a column is all the page. -->
            <ColumnDefinition Width="150" MinWidth="96" MaxWidth="340" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <ItemsPresenter Name="PART_ItemsPresenter"
                          Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                          ItemsPanel="{TemplateBinding ItemsPanel}" />

          <GridSplitter Name="PART_Handle" Classes="handle" ResizeDirection="Columns"
                        Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                        ToolTip.Tip="Drag to give the section list more or less room." />

          <ContentPresenter Name="PART_SelectedContentHost"
                            Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                            Padding="12,0,0,0"
                            Content="{TemplateBinding SelectedContent}"
                            ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Grid>
      </ControlTemplate>
    </TabControl.Template>

    <TabItem Header="Audio">
        <ScrollViewer>
          <StackPanel Spacing="12">

          <!-- Moved here from the top of the window. It belongs with the rest of what the
               sound goes through rather than above every page in the app. -->
          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <TextBlock Classes="cardTitle" Text="Output" />

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="label" Text="Output device:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding OutputDevices}"
                          SelectedItem="{Binding SelectedOutputDevice}"
                          DisplayMemberBinding="{Binding Name}"
                          HorizontalAlignment="Stretch" />
              </Grid>

              <TextBlock Classes="cardHint" TextWrapping="Wrap"
                         Text="Where everything comes out: the pads, the tracker and whatever the plugins are playing." />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="Engine" />
                <views:HelpBadge Topic="settings.engine" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="label" Text="Sample rate:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding EngineRateLabels}"
                          SelectedItem="{Binding SelectedEngineRate}"
                          HorizontalAlignment="Left"
                          MinWidth="220" />
              </Grid>

              <TextBlock Classes="cardHint" Text="{Binding EngineRateHint}" />

              <!-- The trade is written under it rather than left to be discovered: tighter is
                   better until a plugin takes a moment longer than usual, and then it is worse. -->
              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Classes="label" Text="Plugin cushion:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding RenderAheadLabels}"
                          SelectedItem="{Binding SelectedRenderAhead}"
                          HorizontalAlignment="Left"
                          MinWidth="220" />
              </Grid>

              <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding RenderAheadHint}" />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="Recording Input" />
                <views:HelpBadge Topic="settings.recording-input" />
              </StackPanel>

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="label" Text="Input device:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Record.InputDevices}"
                          SelectedItem="{Binding Record.SelectedDevice}"
                          HorizontalAlignment="Stretch" />
              </Grid>

              <Button Content="Refresh Devices"
                      HorizontalAlignment="Left"
                      Command="{Binding Record.RefreshDevicesCommand}" />
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
    </TabItem>

    <TabItem Header="MIDI">
        <ScrollViewer>
          <StackPanel Spacing="12">

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="MIDI Input" />
                <views:HelpBadge Topic="settings.midi-input" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Midi.Devices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,6">
                      <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="cardHint"
                                   Text="not connected"
                                   IsVisible="{Binding !IsConnected}" />
                      </StackPanel>

                      <CheckBox Grid.Column="1" Content="Pads"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DrivesPads}" />

                      <CheckBox Grid.Column="2" Content="Tracker"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DrivesTracker}" />

                      <CheckBox Grid.Column="3" Content="Controls"
                                VerticalAlignment="Center"
                                IsChecked="{Binding DrivesControls}"
                                ToolTip.Tip="This device's knobs and faders move parameters. Its own switch, because a keyboard whose keys should play the tracker is not always one whose wheel should move something." />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Classes="cardHint"
                         Text="No MIDI devices found."
                         IsVisible="{Binding !Midi.HasDevices}" />

              <Button Content="Refresh Devices"
                      HorizontalAlignment="Left"
                      Command="{Binding Midi.RefreshDevicesCommand}" />

              <TextBlock Classes="cardHint"
                         Text="{Binding Midi.Status}"
                         IsVisible="{Binding Midi.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
          </Border>

          <!-- How many pads there are, and what one does when it is hit. Both are about the
               pads the mapping underneath is mapping, so they are read together, and half the
               width each so that neither looks like the more important one. Narrow the window
               and they stack rather than squeezing one to a column of single letters. -->
          <views:Beside Gap="12" Least="290" Even="True">

              <Border Classes="card" VerticalAlignment="Top">
                <StackPanel Classes="cardBody">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="cardTitle" Text="Pad Matrix Size" />
                    <views:HelpBadge Topic="settings.pad-matrix" />
                  </StackPanel>

                  <Grid ColumnDefinitions="Auto,Auto,Auto,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="10"
                        RowSpacing="6">

                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Rows:" />
                    <ui:NumberField Grid.Row="0" Grid.Column="1"
                                       Minimum="1" Maximum="{Binding MostPads}"
                                       Value="{Binding Rows}"
                                       HorizontalAlignment="Left"
                                       Width="62" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Columns:" />
                    <ui:NumberField Grid.Row="1" Grid.Column="1"
                                       Minimum="1" Maximum="{Binding MostPads}"
                                       Value="{Binding Columns}"
                                       HorizontalAlignment="Left"
                                       Width="62" />

                    <!-- Reaching from one field to the other, the way a drawing program's
                         width and height are locked together. -->
                    <views:Linker Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                  VerticalAlignment="Stretch"
                                  Margin="0,4,0,4"
                                  IsLinked="{Binding LinkPadMatrix}"
                                  ToolTip.Tip="Keeps rows and columns the same. Type in either and the other follows." />

                    <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Total:" />
                    <StackPanel Grid.Row="2" Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6">
                      <TextBlock Classes="padCount" Text="{Binding WantedPadCount}" />
                      <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="pads" />
                    </StackPanel>

                    <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                               Classes="error"
                               Text="{Binding MatrixSizeError}"
                               IsVisible="{Binding MatrixSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </Grid>

                  <!-- Sixteen is what fits on a laptop and what a hand finds without looking.
                       Past that is a deliberate choice, so it is a switch and not just a
                       larger number in the field above. -->
                  <CheckBox Content="Use extended pad matrix"
                            IsChecked="{Binding ExtendedPadMatrix}"
                            ToolTip.Tip="Lets the matrix go up to 32 pads instead of 16. A grid that big wants the screen to match." />

                  <Button Content="Apply Matrix Size"
                          HorizontalAlignment="Left"
                          Command="{Binding ApplyMatrixSizeCommand}" />

                </StackPanel>
              </Border>

            <Border Classes="card" VerticalAlignment="Top">
              <StackPanel Classes="cardBody">
                <TextBlock Classes="cardTitle" Text="Pad behaviour" />

                <CheckBox Content="Toggle mode (press again to stop)"
                          IsChecked="{Binding Midi.ToggleMode}" />

                <TextBlock Classes="cardHint" TextWrapping="Wrap"
                           Text="On, a pad keeps playing until it is hit again. Off, it plays for as long as the pad is held." />
              </StackPanel>
            </Border>

          </views:Beside>

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <TextBlock Classes="cardTitle" Text="Knobs and faders" />

              <TextBlock Classes="cardHint" TextWrapping="Wrap"
                         Text="Press Ctrl+Shift+M and the panels stop turning: rest the pointer on a knob, it glows red, and the next thing you touch on your controller takes it. Press a glowing control to take the link off again. In a plugin's own window there is nothing to point at, so the knob you last turned there is the one that is offered." />

              <Border Classes="inset" IsVisible="{Binding Links.HasLinks}">
                <ItemsControl ItemsSource="{Binding Links.Links}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,2">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                                   Text="{Binding Control}" />

                        <TextBlock Grid.Column="1" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding What}" />

                        <TextBlock Grid.Column="2" Classes="cardHint" VerticalAlignment="Center"
                                   Text="{Binding Where}" />

                        <!-- Pressed when the guess was wrong. A button that repeats while it
                             is held sends what an encoder sends, so this cannot be right every
                             time, and past the end of the list it goes back to listening. -->
                        <Button Grid.Column="3" Classes="page"
                                Content="{Binding How}"
                                Command="{Binding NextCommand}"
                                ToolTip.Tip="What kind of control this is, worked out from what it sends. Press to say it is something else; press past the end to have it listen again." />

                        <Button Grid.Column="4" Content="Forget" Classes="danger"
                                Command="{Binding ForgetCommand}" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>

              <TextBlock Classes="cardHint"
                         IsVisible="{Binding !Links.HasLinks}"
                         Text="Nothing is pointed at anything yet." />

              <Button Content="Forget them all" Classes="danger"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding Links.HasLinks}"
                      Command="{Binding Links.ForgetAllCommand}" />
            </StackPanel>
          </Border>

          <!-- On the page rather than behind a button. It is about the devices listed above
               it, and a dialog you have to open to see a mapping is one you have to close
               again before you can look at anything else. -->
          <views:MidiView DataContext="{Binding Midi}" />

          </StackPanel>
        </ScrollViewer>
    </TabItem>

    <TabItem Header="Plugins">
        <ScrollViewer>
          <StackPanel Spacing="12">

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="Audio Plugins" />
                <views:HelpBadge Topic="settings.plugins" />
              </StackPanel>

              <WrapPanel Orientation="Horizontal">
                <Button Content="Scan for plugins" Command="{Binding Plugins.ScanCommand}"
                        Margin="0,0,8,4" />
                <TextBlock Classes="cardHint" VerticalAlignment="Center" Margin="0,0,0,4"
                           Text="{Binding Plugins.Status}" />
              </WrapPanel>

              <Border Classes="inset" IsVisible="{Binding Plugins.HasPlugins}">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding Plugins.Plugins}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                              <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding FormatName}" />
                              <TextBlock Classes="cardHint" VerticalAlignment="Center"
                                         Text="instrument" IsVisible="{Binding IsInstrument}" />
                            </StackPanel>
                            <TextBlock Classes="cardHint" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                                     Text="{Binding Vendor}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <TextBlock Classes="cardHint" TextWrapping="Wrap"
                         Text="Plugins run in a process of their own. One that falls over stops on its own and can be started again; it cannot take the app with it." />

              <!-- Plugins that crashed the application while opening their own window. Kept out
                   of the way until there is one, because most of the time there is not. -->
              <Border Classes="inset" IsVisible="{Binding Plugins.HasBlockedPlugins}">
                <StackPanel Spacing="6">
                  <TextBlock Classes="section" Text="Not opening their own windows" />

                  <TextBlock Classes="cardHint" TextWrapping="Wrap"
                             Text="These brought the application down while opening their own interface, so they are shown with the host's knobs instead. They still play and still save." />

                  <ItemsControl ItemsSource="{Binding Plugins.BlockedPlugins}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Classes="cardHint" Margin="0,2"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Name}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="Let them try again"
                          HorizontalAlignment="Left"
                          Command="{Binding Plugins.AllowBlockedCommand}"
                          ToolTip.Tip="Any that go down again go straight back on this list." />
                </StackPanel>
              </Border>

              <TextBlock Classes="cardHint" Text="Looked for in:" />
              <TextBlock Classes="cardHint" Text="{Binding Plugins.SearchPaths}" />

              <!-- Folders of your own, on top of the standard ones. Kept with the settings. -->
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Add a folder..." Click="OnAddPluginFolder"
                        ToolTip.Tip="Somewhere else to look, for plugins you keep outside the usual places." />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding Plugins.Folders}"
                            IsVisible="{Binding Plugins.HasFolders}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                      <TextBlock Grid.Column="0" Classes="cardHint" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding .}" />
                      <Button Grid.Column="1" Content="Remove" Classes="danger" Padding="8,3"
                              Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Plugins.RemoveFolderCommand}"
                              CommandParameter="{Binding .}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
    </TabItem>

    <TabItem Header="Looks">
        <ScrollViewer>
          <StackPanel Spacing="12">

          <!-- Moved here from the top of the window. What you change while you are working
               is the output device; a theme is something you pick once. -->
          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <TextBlock Classes="cardTitle" Text="Theme" />

              <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Classes="label" Text="Theme:" />
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ThemeNames}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          HorizontalAlignment="Left"
                          MinWidth="220" />
              </Grid>

              <TextBlock Classes="cardHint" TextWrapping="Wrap"
                         Text="Changes everything at once, the knobs and meters included." />
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <TextBlock Classes="cardTitle" Text="Pages" />

              <CheckBox Content="Show machine editor"
                        IsChecked="{Binding ShowMachineEditor}" />

              <TextBlock Classes="cardHint" TextWrapping="Wrap"
                         Text="Puts the machines in the menu along the top, beside RECORD and TRACKER, for when the instrument is the work rather than the song. They are inside the tracker either way." />
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
    </TabItem>

    <TabItem Header="System">
        <ScrollViewer>
          <StackPanel Spacing="12">

          <!-- What this installation is made up of. Here rather than on the rack, because
               adding and removing a machine is done to the installation and not to the song
               that is open. A machine that ships can always be taken again, so the list shows
               those it does not have beside those it does. -->
          <Border Classes="card">
            <StackPanel Classes="cardBody">
              <TextBlock Classes="cardTitle" Text="Machines" />

              <WrapPanel Orientation="Horizontal">
                <Button Content="Import a machine..." Click="OnImportMachine"
                        Margin="0,0,8,4" />
                <TextBlock Classes="cardHint" VerticalAlignment="Center" Margin="0,0,0,4"
                           Text="{Binding MachineShelf.Status}" />
              </WrapPanel>

              <Border Classes="inset">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                  <ItemsControl ItemsSource="{Binding MachineShelf.Machines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                          <StackPanel Grid.Column="0" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                              <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding Version}" />
                              <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding State}" />
                            </StackPanel>
                            <TextBlock Classes="cardHint" Text="{Binding Author}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button Grid.Column="1" Content="Remove" Classes="danger" Padding="8,3"
                                  IsVisible="{Binding IsInstalled}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineShelf.RemoveCommand}"
                                  CommandParameter="{Binding .}" />
                          <Button Grid.Column="1" Content="Add" Padding="8,3"
                                  IsVisible="{Binding IsAvailable}"
                                  Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).MachineShelf.AddCommand}"
                                  CommandParameter="{Binding .}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Border>

              <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding MachineShelf.Hint}" />
            </StackPanel>
          </Border>

          <!-- Off by default and free when off. On when something has gone wrong and somebody
               wants to know what, including inside the processes plugins run in. -->
          <Border Classes="card">
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="cardTitle" Text="Log" />
                <views:HelpBadge Topic="settings.log" />
              </StackPanel>

              <CheckBox Content="Write down what the app is doing" IsChecked="{Binding WriteLog}" />

              <!-- One switch per part, because the parts are not alike: most of what is
                   written happens once or only when something has gone wrong, and a few lines
                   are written per message or once a second for ever. Everything switched on at
                   once is how the line you turned it on for gets buried. -->
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding WriteLog}" Margin="18,0,0,0">
                <ItemsControl ItemsSource="{Binding LogParts}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <CheckBox Content="{Binding Name}" IsChecked="{Binding Writes}" Margin="0,0,16,0" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </WrapPanel>

              <TextBlock Classes="cardHint" TextWrapping="Wrap" Text="{Binding LogHint}" />
            </StackPanel>
          </Border>

          </StackPanel>
        </ScrollViewer>
    </TabItem>

  </TabControl>
</UserControl>
