<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             x:Class="JingleBox2.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.padCount">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Classes="tabRoot">

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Recording Input" />

          <TextBlock Classes="cardHint"
                     Text="Pick the device the RECORD tab captures from. The choice is remembered between sessions." />

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Classes="label" Text="Input device:" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Record.InputDevices}"
                      SelectedItem="{Binding Record.SelectedDevice}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Button Content="Refresh Devices"
                  HorizontalAlignment="Left"
                  Command="{Binding Record.RefreshDevicesCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="MIDI Input" />

          <TextBlock Classes="cardHint"
                     Text="Tick what each controller drives. A pad box and a keyboard can be connected at the same time. Pad Mapping is where a pad controller learns its notes." />

          <ItemsControl ItemsSource="{Binding Midi.Devices}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="0,0,0,6">
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="cardHint"
                               Text="not connected"
                               IsVisible="{Binding !IsConnected}" />
                  </StackPanel>

                  <CheckBox Grid.Column="1" Content="Pads"
                            VerticalAlignment="Center"
                            IsChecked="{Binding DrivesPads}" />

                  <CheckBox Grid.Column="2" Content="Tracker"
                            VerticalAlignment="Center"
                            IsChecked="{Binding DrivesTracker}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="cardHint"
                     Text="No MIDI devices found."
                     IsVisible="{Binding !Midi.HasDevices}" />

          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
            <Button Content="Refresh Devices"
                    Command="{Binding Midi.RefreshDevicesCommand}" />

            <Button Content="Pad Mapping..."
                    IsEnabled="{Binding Midi.HasPadDevice}"
                    Click="OnOpenPadMapping" />
          </StackPanel>

          <TextBlock Classes="cardHint"
                     Text="{Binding Midi.Status}"
                     IsVisible="{Binding Midi.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Audio Plugins" />

          <TextBlock Classes="cardHint"
                     Text="CLAP plugins installed on this machine. CLAP is the format this app hosts: it is the one with a plain C interface, so it works the same on Linux and Windows. LSP, Surge, Vital and the rest ship it; a plugin that only ships VST is not listed here." />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Scan for plugins" Command="{Binding Plugins.ScanCommand}" />
            <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="{Binding Plugins.Status}" />
          </StackPanel>

          <Border Classes="inset" IsVisible="{Binding Plugins.HasPlugins}">
            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
              <ItemsControl ItemsSource="{Binding Plugins.Plugins}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2">
                      <StackPanel Grid.Column="0" Spacing="1">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Classes="cardHint" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Classes="cardHint" VerticalAlignment="Center"
                                 Text="{Binding Vendor}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <TextBlock Classes="cardHint" Text="Looked for in:" />
          <TextBlock Classes="cardHint" Text="{Binding Plugins.SearchPaths}" />

          <!-- Folders of your own, on top of the standard ones. Kept with the settings. -->
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Add a folder..." Click="OnAddPluginFolder" />
            <TextBlock Classes="cardHint" VerticalAlignment="Center"
                       Text="Somewhere else to look, for plugins you keep outside the usual places." />
          </StackPanel>

          <ItemsControl ItemsSource="{Binding Plugins.Folders}"
                        IsVisible="{Binding Plugins.HasFolders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,2">
                  <TextBlock Grid.Column="0" Classes="cardHint" VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis" Text="{Binding .}" />
                  <Button Grid.Column="1" Content="Remove" Classes="danger" Padding="8,3"
                          Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).Plugins.RemoveFolderCommand}"
                          CommandParameter="{Binding .}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Classes="cardHint"
                     Text="Scanning opens each plugin to ask what is in it, and they stay loaded until the app closes: unloading plugin libraries is what makes hosts crash. Nothing plays through a plugin yet; this is the list a track will pick from." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Pad Matrix Size" />

          <TextBlock Classes="cardHint"
                     Text="Rows and columns for the pad grid. Minimum 4 pads (2x2 or 1x4), maximum 16 (4x4 or 2x8)." />

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="6">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Rows:" />
            <views:NumberField Grid.Row="0" Grid.Column="1"
                               Minimum="1" Maximum="16"
                               Value="{Binding Rows}"
                               HorizontalAlignment="Left"
                               Width="62" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Columns:" />
            <views:NumberField Grid.Row="1" Grid.Column="1"
                               Minimum="1" Maximum="16"
                               Value="{Binding Columns}"
                               HorizontalAlignment="Left"
                               Width="62" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Total:" />
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
              <TextBlock Classes="padCount" Text="{Binding PadCount}" />
              <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="pads" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="error"
                       Text="{Binding MatrixSizeError}"
                       IsVisible="{Binding MatrixSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>

          <Button Content="Apply Matrix Size"
                  HorizontalAlignment="Left"
                  Command="{Binding ApplyMatrixSizeCommand}" />

          <TextBlock Classes="cardHint"
                     Text="Changing the matrix stops all playing audio and rebuilds the grid. Pad settings are kept where possible." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
