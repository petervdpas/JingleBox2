<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.padCount">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Classes="tabRoot">

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Recording Input" />

          <TextBlock Classes="cardHint"
                     Text="Pick the device the RECORD tab captures from. The choice is remembered between sessions." />

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Classes="label" Text="Input device:" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Record.InputDevices}"
                      SelectedItem="{Binding Record.SelectedDevice}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Button Content="Refresh Devices"
                  HorizontalAlignment="Left"
                  Command="{Binding Record.RefreshDevicesCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="MIDI Input" />

          <TextBlock Classes="cardHint"
                     Text="Pick the controller that triggers pads. Map the pads themselves on the MIDI tab." />

          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <TextBlock Grid.Column="0" Classes="label" Text="MIDI device:" />
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding Midi.Devices}"
                      SelectedItem="{Binding Midi.SelectedDevice}"
                      HorizontalAlignment="Stretch" />
          </Grid>

          <Button Content="Refresh Devices"
                  HorizontalAlignment="Left"
                  Command="{Binding Midi.RefreshDevicesCommand}" />

          <TextBlock Classes="cardHint"
                     Text="{Binding Midi.Status}"
                     IsVisible="{Binding Midi.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Classes="cardBody">
          <TextBlock Classes="cardTitle" Text="Pad Matrix Size" />

          <TextBlock Classes="cardHint"
                     Text="Rows and columns for the pad grid. Minimum 4 pads (2x2 or 1x4), maximum 16 (4x4 or 2x8)." />

          <Grid ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnSpacing="10"
                RowSpacing="6">

            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Rows:" />
            <NumericUpDown Grid.Row="0" Grid.Column="1"
                           Minimum="1" Maximum="16"
                           Value="{Binding Rows}"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120" />

            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Columns:" />
            <NumericUpDown Grid.Row="1" Grid.Column="1"
                           Minimum="1" Maximum="16"
                           Value="{Binding Columns}"
                           FormatString="0"
                           HorizontalAlignment="Left"
                           Width="120" />

            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Total:" />
            <StackPanel Grid.Row="2" Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
              <TextBlock Classes="padCount" Text="{Binding PadCount}" />
              <TextBlock Classes="cardHint" VerticalAlignment="Center" Text="pads" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                       Classes="error"
                       Text="{Binding MatrixSizeError}"
                       IsVisible="{Binding MatrixSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>

          <Button Content="Apply Matrix Size"
                  HorizontalAlignment="Left"
                  Command="{Binding ApplyMatrixSizeCommand}" />

          <TextBlock Classes="cardHint"
                     Text="Changing the matrix stops all playing audio and rebuilds the grid. Pad settings are kept where possible." />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
