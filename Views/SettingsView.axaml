<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             x:Class="JingleBox2.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="10" />
    </Style>

    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style Selector="TextBlock.label">
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.padCount">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource BgBrush}" Padding="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <Border Classes="settingsCard">
          <StackPanel Spacing="16">
            <TextBlock Classes="header" Text="Pad Matrix Size" />

            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Text="Configure the number of rows and columns for your pad grid. Minimum 4 pads (e.g., 2x2 or 1x4), maximum 16 pads (e.g., 4x4 or 2x8)." />

            <Grid ColumnDefinitions="Auto,*"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnSpacing="16"
                  RowSpacing="12">

              <TextBlock Grid.Row="0" Grid.Column="0"
                         Classes="label"
                         Text="Rows:" />
              <NumericUpDown Grid.Row="0" Grid.Column="1"
                             Minimum="1"
                             Maximum="16"
                             Value="{Binding Rows}"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />

              <TextBlock Grid.Row="1" Grid.Column="0"
                         Classes="label"
                         Text="Columns:" />
              <NumericUpDown Grid.Row="1" Grid.Column="1"
                             Minimum="1"
                             Maximum="16"
                             Value="{Binding Columns}"
                             FormatString="0"
                             HorizontalAlignment="Left"
                             Width="120" />

              <TextBlock Grid.Row="2" Grid.Column="0"
                         Classes="label"
                         Text="Total:" />
              <StackPanel Grid.Row="2" Grid.Column="1"
                          Orientation="Horizontal"
                          Spacing="8">
                <TextBlock Classes="padCount" Text="{Binding PadCount}" />
                <TextBlock Classes="muted" VerticalAlignment="Center" Text="pads" />
              </StackPanel>

              <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                         Classes="error"
                         Text="{Binding MatrixSizeError}"
                         IsVisible="{Binding MatrixSizeError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </Grid>

            <Button Content="Apply Matrix Size"
                    HorizontalAlignment="Left"
                    Command="{Binding ApplyMatrixSizeCommand}" />

            <TextBlock Classes="muted"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Text="Note: Changing the matrix size will stop all playing audio and rebuild the pad grid. Pad configurations will be preserved where possible." />

          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Border>
</UserControl>
