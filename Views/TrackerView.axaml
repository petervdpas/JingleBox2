<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:ui="clr-namespace:JingleBox2.Rack.Controls;assembly=JingleBox2.Rack.Controls"
             xmlns:rec="clr-namespace:JingleBox2.Tracker.Records"
             xmlns:vmr="clr-namespace:JingleBox2.ViewModels.Records"
             xmlns:conv="clr-namespace:JingleBox2.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             x:Class="JingleBox2.Views.TrackerView"
             x:DataType="vm:TrackerViewModel">

  <UserControl.Resources>
    <conv:TimesMoreConverter x:Key="TimesMore" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- The loop strip beside a slot of the order: barely there until the slot is in the range,
         and the accent colour when it is. Always drawn rather than made visible, so there is
         somewhere to start a drag on a row that is not looped yet. -->
    <Style Selector="Border.loopbar">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.TextPrimary}" Opacity="0.10" />
      </Setter>
    </Style>

    <!-- The slot's place in the song: a label rather than a value, so it steps back from the
         pattern number beside it, which is the part that is worth reading and worth changing. -->
    <Style Selector="TextBlock.place">
      <Setter Property="Opacity" Value="0.55" />
    </Style>

    <!-- And the pattern, in a cell of its own so a column of them reads down the list. -->
    <Style Selector="Border.slotpattern">
      <Setter Property="Padding" Value="6,1" />
      <Setter Property="MinWidth" Value="30" />
      <Setter Property="CornerRadius" Value="3" />
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.TextPrimary}" Opacity="0.08" />
      </Setter>
    </Style>

    <Style Selector="Border.loopbar.looped">
      <Setter Property="Background">
        <SolidColorBrush Color="{DynamicResource Color.Accent}" />
      </Setter>
    </Style>

    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <!-- The page, with the picture of whatever is being dragged laid over it. The canvas takes
       no clicks, so it changes nothing about what is under it. -->
  <Panel>

  <DockPanel Classes="tabRoot">

    <!-- Transport -->
    <Border DockPanel.Dock="Top" Classes="card stacked">
      <!-- The page buttons are pinned to the right rather than run on the end of the transport,
           so a narrow window clips a number field rather than the way out of the pattern. -->
      <Grid ColumnDefinitions="*,Auto">
      <!-- Wraps rather than runs off the edge. A stack panel does not shrink, so on a narrow
           window it kept its full width and the pinned buttons were drawn over the top of the
           last few fields. -->
      <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- The transport is at the top of the window, on the tab line, where it can be seen
             and reached from every page. What is left on this bar is what only means anything
             in front of a pattern. -->
        <ComboBox ItemsSource="{Binding PlayModes}"
                  SelectedItem="{Binding PlayMode}"
                  MinWidth="104"
                  ToolTip.Tip="Whether the transport plays this pattern or works through the order. Switchable while it is playing: it is answered at the end of the pattern, so nothing jumps." />

        <!-- Beside the picker, because the two are one question: the picker says what "the end"
             is and this says what happens when it is reached. A switch rather than a tick, since
             what it holds is a state the transport is in rather than an option on a form, and it
             reads as on or off from across the room the way the coloured buttons do. -->
        <ToggleSwitch Margin="12,0,0,0" VerticalAlignment="Center"
                      IsChecked="{Binding LoopPlayback}"
                      OnContent="Loop" OffContent="Loop"
                      ToolTip.Tip="On, it comes round again at the end: the end of this pattern in Pattern mode, the end of the order in Song mode, or the end of the loop range when the order has one. Off, it plays to the end and stops, which is what a jingle wants. Switchable while it is playing, and part of the song rather than a setting, so it is how you left it when you open the song again." />

        <!-- Every label the same distance from the field before it and from its own, so the
             row reads as five settings rather than as one run of digits. -->
        <TextBlock Classes="field" Text="BPM" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding Bpm}"
                           Minimum="20" Maximum="400" SmallStep="1" LargeStep="10" Width="76"
                           ToolTip.Tip="Scroll or use the arrow keys. Hold Shift for larger steps." />

        <!-- This pattern's own length. A song's patterns need not be the same length and never
             had to be: the number is per pattern in the model and in the file, and the
             sequencer reads whichever one the slot plays. There was nowhere to type it. -->
        <TextBlock Classes="field" Text="Lines" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding PatternLines}"
                           Minimum="1" Maximum="256" SmallStep="1" LargeStep="16" Width="70"
                           ToolTip.Tip="How long the pattern you are on is. Each pattern has its own length, so a song can be a 64 line verse and a 32 line chorus. Shortening one loses the lines off the end, and undoes." />

        <TextBlock Classes="field" Text="LPB" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding LinesPerBeat}"
                           Minimum="1" Maximum="16" Width="62" />

        <TextBlock Classes="field" Text="Step" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding EditStep}"
                           Minimum="0" Maximum="16" Width="62" />

        <TextBlock Classes="field" Text="Oct" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding Octave}"
                           Minimum="0" Maximum="9" Width="62" />

        <TextBlock Classes="field" Text="Tracks" Margin="16,0,6,0" />
        <ui:NumberField Value="{Binding TrackCount}"
                           Minimum="{Binding MinTrackCount}" Maximum="{Binding MaxTrackCount}"
                           Width="62" />

      </WrapPanel>

      <!-- Where the instruments and the mixer live now. They are the tracker's own, so they are
           pages of it rather than tabs beside it: the mixer mixes its tracks and the rack is
           where a song takes its instruments from. Lit while you are on one, and pressing the
           lit one is the way back to the pattern. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                  VerticalAlignment="Top" Margin="12,0,0,0">
        <Button Content="RACK" Classes="page"
                Classes.active="{Binding ShowsMachines}"
                Command="{Binding ShowCommand}" CommandParameter="Machines"
                ToolTip.Tip="What is installed: the machines this song can take an instrument off." />

        <Button Content="MIXER" Classes="page"
                Classes.active="{Binding ShowsMixer}"
                Command="{Binding ShowCommand}" CommandParameter="Mixer"
                ToolTip.Tip="The levels, the panning and the inserts of this song's tracks." />

        <!-- Here rather than only in the settings, because what a song has its controller
             pointed at is a thing the song holds, like its patterns: it comes and goes with the
             song, and the settings are where the desk's layout lives. -->
        <Button Content="MIDI CC" Classes="page"
                Classes.active="{Binding ShowsControls}"
                Command="{Binding ShowCommand}" CommandParameter="Controls"
                ToolTip.Tip="What this song has its controller pointed at, and which travels in its file." />
      </StackPanel>
      </Grid>
    </Border>

    <!-- The song: which one is open, and what can be done with it. The list of saved songs
         and the name box were along here, taking a hand's depth of the window for the whole of
         the time nobody was opening or renaming anything. Both are dialogs now. -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8">
        <TextBlock Grid.Column="0" Classes="field" Text="Song:" />
        <!-- The name, and what the song says about itself beside it. The note is what tells
             two songs apart months later, and reading it should not need the picker opening. -->
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
          <TextBlock Grid.Column="0" VerticalAlignment="Center"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"
                     Text="{Binding SongName}" />

          <TextBlock Grid.Column="1" VerticalAlignment="Center"
                     Opacity="0.7" FontSize="12"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding SongDescription, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                     Text="{Binding SongDescription}"
                     ToolTip.Tip="{Binding SongDescription}" />
        </Grid>

        <Button Grid.Column="2" Content="Open..." Command="{Binding OpenSongCommand}" />
        <!-- Coloured rather than starred. A star is a character somebody has to know the
             meaning of, and it moves the button's width as it comes and goes. Green here and
             warm on Cancel changes below, both on the same fact: see Button.save in App.axaml. -->
        <Button Grid.Column="3" Content="Save song" Command="{Binding SaveCommand}"
                Classes.save="{Binding NeedsSaving}"
                ToolTip.Tip="Writes the song to disc. The button goes green while there are changes that are not on disc yet." />
        <Button Grid.Column="4" Content="Save as..." Command="{Binding SaveAsCommand}" />

        <!-- The other half of saving, and the one nothing offered until now: putting it back.
             Dead unless there is both a saved copy to return to and something to return from. -->
        <Button Grid.Column="5" Content="Cancel changes"
                IsEnabled="{Binding CanRevertSong}"
                Classes.discard="{Binding CanRevertSong}"
                Command="{Binding RevertSongCommand}"
                ToolTip.Tip="Throws away everything done since the last save and reads the song back as it was. Asked first, because it cannot be undone." />

        <!-- A copy with the recordings inside it, for somebody who has none of your takes.
             Saving does not do this: a song built on a long take is tens of megabytes, and the
             open song is written out every twenty seconds whether anybody asked or not. -->
        <Button Grid.Column="6" Content="Pack..." Click="Pack_Click"
                ToolTip.Tip="Writes a copy with the recordings it plays inside it, for handing to somebody else. Presets that ship with the program are named rather than carried, since every installation already has them." />

        <Button Grid.Column="7" Content="New" Command="{Binding NewSongCommand}" />

        <!-- The song this bar is about, since that is the one you are looking at. What is on
             the screen stays there afterwards, unsaved. -->
        <Button Grid.Column="8" Content="Delete" Classes="danger"
                IsEnabled="{Binding CanDeleteSong}"
                Command="{Binding DeleteSongCommand}"
                ToolTip.Tip="Deletes this song from disc. What is open stays open, and the machines it used are untouched." />
      </Grid>
    </Border>

    <Grid>

    <!-- Three columns you can move the edges of. The pattern in the middle takes whatever the
         other two leave, so widening the order list or the instruments narrows the pattern
         rather than pushing anything off the end. -->
    <Grid ColumnDefinitions="180,12,*,12,220"
          IsVisible="{Binding ShowsPattern}">

      <!-- Order list -->
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Order" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Button Content="+ Pattern" HorizontalAlignment="Stretch"
                    Command="{Binding AddPatternCommand}"
                    ToolTip.Tip="A new empty pattern, and a slot at the end of the order playing it." />
            <Button Content="Remove slot" HorizontalAlignment="Stretch" Classes="danger"
                    Command="{Binding RemoveOrderEntryCommand}"
                    ToolTip.Tip="Takes this slot out of the order. The pattern stays in the song, since it may be in the order somewhere else." />
          </StackPanel>
          <!-- What a slot can do is on the slot, by right clicking it, rather than as a row of
               buttons under the list: these are all about the one you are pointing at, and a
               button at the foot of the panel is about none of them until you have remembered
               which row is picked. -->
          <ListBox x:Name="OrderList"
                   ItemsSource="{Binding OrderEntries}"
                   SelectedIndex="{Binding OrderIndex}"
                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                   ToolTip.Tip="The order the patterns play in. Drag a row to move it, wheel to step through them, right click for what a slot can do. Drag down the strip on the left to loop a range of slots.">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vmr:OrderSlot">
                <!-- The loop strip down the left, then the row. A column of its own rather than
                     a mark on the row, because a range is drawn by dragging down it and a drag
                     needs somewhere to start that is not the row itself, which is already how a
                     slot is moved. Renoise puts it in the same place for the same reason. -->
                <Grid ColumnDefinitions="10,Auto,Auto" ColumnSpacing="6">
                  <Border Grid.Column="0" Classes="loopbar"
                          Classes.looped="{Binding Loops}"
                          CornerRadius="2" />

                  <!-- Where you are in the song, and which pattern is there. Two different
                       things, so two cells rather than one run of digits: the place is a
                       label and the pattern is the thing you change. -->
                  <TextBlock Grid.Column="1" Classes="place" Text="{Binding Place}"
                             VerticalAlignment="Center" />

                  <Border Grid.Column="2" Classes="slotpattern">
                    <TextBlock Text="{Binding Pattern}" />
                  </Border>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
              <ContextMenu>
                <MenuItem Header="Copy pattern"
                          Command="{Binding CopyPatternCommand}"
                          ToolTip.Tip="A pattern of its own holding the same notes and the same automation, in the order just after this one. Editing either afterwards leaves the other alone." />

                <!-- With a count, because repeating a part is almost never once: a phrase is
                     four or eight bars, and asking for it a slot at a time is the same gesture
                     four times over. Real slots rather than a number saying how often one goes
                     round, so a run reads down the list as a run and the loop range can be
                     drawn across part of it. -->
                <MenuItem Header="Play it again" ItemsSource="{Binding RepeatCounts}"
                          ToolTip.Tip="The same pattern once more, in slots of its own after this one. Nothing is copied, so editing it changes every place it plays.">
                  <MenuItem.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem"
                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                  x:DataType="system:Int32">
                      <Setter Property="Header" Value="{Binding Converter={StaticResource TimesMore}}" />
                      <Setter Property="Command"
                              Value="{Binding $parent[ContextMenu].((vm:TrackerViewModel)DataContext).RepeatPatternCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding}" />
                    </ControlTheme>
                  </MenuItem.ItemContainerTheme>
                </MenuItem>

                <Separator />

                <!-- Which pattern this slot plays, which is what makes an order a list of what
                     plays rather than a list of what exists. Every pattern the song holds is
                     offered, including one that has fallen out of the order, since pointing a
                     slot back at it is how that is recovered. -->
                <MenuItem Header="Plays pattern" ItemsSource="{Binding PatternChoices}">
                  <MenuItem.ItemContainerTheme>
                    <ControlTheme TargetType="MenuItem"
                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                  x:DataType="vmr:PatternChoice">
                      <Setter Property="Header" Value="{Binding Name}" />
                      <Setter Property="Command"
                              Value="{Binding $parent[ContextMenu].((vm:TrackerViewModel)DataContext).PlayPatternCommand}" />
                      <Setter Property="CommandParameter" Value="{Binding Index}" />
                    </ControlTheme>
                  </MenuItem.ItemContainerTheme>
                </MenuItem>

                <Separator />

                <MenuItem Header="Clear the loop range"
                          IsEnabled="{Binding HasLoop}"
                          Command="{Binding ClearLoopCommand}"
                          ToolTip.Tip="Takes the range off, so the order plays straight through. Pressing the strip beside a slot that is looped on its own does the same." />

                <Separator />

                <MenuItem Header="Remove slot" Command="{Binding RemoveOrderEntryCommand}"
                          ToolTip.Tip="Takes this slot out of the order. The pattern stays in the song, since it may be in the order somewhere else." />
              </ContextMenu>
            </ListBox.ContextMenu>
          </ListBox>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Classes="handle" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to give the order list more or less room." />

      <!-- Pattern -->
      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <!-- The header, and the one corner of it that names nothing: the square above the
               line numbers belongs to no track, so the help sits there rather than taking a
               place in a row where every other place is a thing you can touch. -->
          <Grid DockPanel.Dock="Top" Margin="0,0,0,4">
            <views:PatternHeader x:Name="Header"
                                 TrackCount="{Binding TrackCount}"
                                 SelectedTrack="{Binding SelectedTrack}" />

            <views:HelpBadge Topic="tracker.effects"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="6,0,0,0" />
          </Grid>

          <!-- The pattern, and under it what the track the cursor is on has: the chain it
               plays through, then what moves over the pattern. Both change when the cursor
               moves between tracks.

               Rows rather than things docked at the foot, so the handle between them has two
               sides to share out. Everything below the handle is one row, and inside it the
               chain takes what it needs and the automation takes the rest: dragging the handle
               therefore trades pattern for curve, which is the only trade on this page worth
               offering. -->
          <Grid RowDefinitions="*,Auto,Auto">

            <ScrollViewer x:Name="GridScroll" Grid.Row="0"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
              <views:PatternGrid x:Name="Grid"
                                 Pattern="{Binding CurrentPattern}"
                                 Before="{Binding PatternBefore}"
                                 After="{Binding PatternAfter}"
                                 EditCursor="{Binding Cursor, Mode=TwoWay}"
                                 PlayingLine="{Binding PlayingLine}"
                                 LinesPerBeat="{Binding LinesPerBeat}"
                                 Selection="{Binding Selection, Mode=TwoWay}">

                <!-- Everything here acts on the track the cursor is on, and a right click puts
                     the cursor where it was clicked first, so the menu always means the column
                     under the pointer. -->
                <views:PatternGrid.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="{Binding SelectionLabel}" IsEnabled="False" />
                    <Separator />

                    <MenuItem Header="Copy" InputGesture="Ctrl+C" Command="{Binding CopySelectionCommand}" />
                    <MenuItem Header="Cut" InputGesture="Ctrl+X" Command="{Binding CutSelectionCommand}" />
                    <MenuItem Header="Paste" InputGesture="Ctrl+V"
                              IsEnabled="{Binding HasClipboard}"
                              Command="{Binding PasteCommand}"
                              ToolTip.Tip="{Binding ClipboardLabel, StringFormat='Puts down what was copied: {0}. The cursor is its top left corner.'}" />

                    <Separator />

                    <MenuItem Header="Delete selection"
                              InputGesture="Delete"
                              IsEnabled="{Binding HasSelection}"
                              Command="{Binding ClearSelectionCommand}" />
                    <MenuItem Header="Select whole pattern"
                              InputGesture="Ctrl+A"
                              Command="{Binding SelectAllCommand}" />

                    <Separator />

                    <!-- How many notes this track can play at once. A note column is a whole
                         cell again with its own note, instrument, volume and effect, so the
                         track grows wider with every one of them. -->
                    <MenuItem Header="{Binding ColumnsHere, StringFormat='Note columns: {0}'}"
                              ToolTip.Tip="How many notes this track plays at once. Each one is a voice of its own, with its own instrument and volume.">
                      <MenuItem Header="Add one"
                                IsEnabled="{Binding CanAddColumn}"
                                Command="{Binding AddColumnCommand}" />
                      <MenuItem Header="Take the last one away"
                                IsEnabled="{Binding CanRemoveColumn}"
                                Command="{Binding RemoveColumnCommand}"
                                ToolTip.Tip="Whatever is written in it goes with it, in every pattern." />
                    </MenuItem>

                    <Separator />

                    <!-- The values are worked out from the song's lines per beat rather than
                         listed here, since 4 lines is a beat at one setting and half of one at
                         another. See IQuantizeGrid. -->
                    <MenuItem Header="Quantize to" ItemsSource="{Binding QuantizeChoices}">
                      <MenuItem.ItemContainerTheme>
                        <ControlTheme TargetType="MenuItem"
                                      BasedOn="{StaticResource {x:Type MenuItem}}"
                                      x:DataType="rec:QuantizeChoice">
                          <Setter Property="Header" Value="{Binding Label}" />
                          <Setter Property="Command"
                                  Value="{Binding $parent[ContextMenu].((vm:TrackerViewModel)DataContext).QuantizeTrackCommand}" />
                          <Setter Property="CommandParameter" Value="{Binding Lines}" />
                        </ControlTheme>
                      </MenuItem.ItemContainerTheme>
                    </MenuItem>

                    <MenuItem Header="Transpose">
                      <MenuItem Header="Up a semitone" Command="{Binding TransposeTrackCommand}" CommandParameter="1" />
                      <MenuItem Header="Down a semitone" Command="{Binding TransposeTrackCommand}" CommandParameter="-1" />
                      <MenuItem Header="Up an octave" Command="{Binding TransposeTrackCommand}" CommandParameter="12" />
                      <MenuItem Header="Down an octave" Command="{Binding TransposeTrackCommand}" CommandParameter="-12" />
                    </MenuItem>

                    <MenuItem Header="Note volume">
                      <MenuItem Header="Same for every note (use the instrument's level)"
                                Command="{Binding SetTrackVolumeCommand}" CommandParameter="-1" />
                      <Separator />
                      <MenuItem Header="All at full (80)" Command="{Binding SetTrackVolumeCommand}" CommandParameter="128" />
                      <MenuItem Header="All at three quarters (60)" Command="{Binding SetTrackVolumeCommand}" CommandParameter="96" />
                      <MenuItem Header="All at half (40)" Command="{Binding SetTrackVolumeCommand}" CommandParameter="64" />
                      <MenuItem Header="All at a quarter (20)" Command="{Binding SetTrackVolumeCommand}" CommandParameter="32" />
                    </MenuItem>

                    <!-- And the same thing for what comes next: a velocity sensitive keyboard
                         writes a different level for every hit unless it is told not to. -->
                    <MenuItem Header="Ignore key velocity"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IgnoreVelocity}"
                              ToolTip.Tip="How hard you play stops being written into the pattern. Remembered between runs." />

                    <!-- And what the other half of a key press does. Off by default: at a step
                         of one, every release writing a note-off fills a pattern quickly. -->
                    <MenuItem Header="Record note-offs"
                              ToggleType="CheckBox"
                              IsChecked="{Binding RecordNoteOffs}"
                              ToolTip.Tip="Letting a key up on a MIDI keyboard writes OFF where the cursor is, the way Renoise does. Remembered between runs." />

                    <!-- The third hand a pattern can be written by, and the one nobody is holding
                         on purpose: a knob leant on while a song loops would edit it. So it is
                         armed deliberately, like the two above, and off unless somebody said. -->
                    <MenuItem Header="Record knob movements"
                              ToggleType="CheckBox"
                              IsChecked="{Binding IsAutomating}"
                              ToolTip.Tip="While the song plays, a controller knob pointed at a parameter writes its movement into the pattern." />

                    <Separator />

                    <MenuItem Header="Clear track" Command="{Binding ClearTrackCommand}" />
                    <MenuItem Header="Clear pattern" Command="{Binding ClearPatternCommand}" />

                    <Separator />

                    <MenuItem Header="Take the instrument off this track"
                              Command="{Binding ClearTrackInstrumentCommand}" />
                  </ContextMenu>
                </views:PatternGrid.ContextMenu>
              </views:PatternGrid>
            </ScrollViewer>

            <!-- Each strip asks for what it wants and the pattern is measured in what is
                 left, so a grip on one of them moves that one and nothing else. Both rows are
                 Auto for the same reason: a strip that was given a share of a row would be
                 taking its room off its neighbour rather than off the music. -->
            <views:FoldStrip Grid.Row="1" Title="chain"
                             IsOpen="{Binding ShowsChain, Mode=TwoWay}"
                             StripHeight="{Binding ChainHeight, Mode=TwoWay}">
              <views:PluginStrip DataContext="{Binding TrackEffect}" />
            </views:FoldStrip>

            <views:FoldStrip Grid.Row="2" Title="automation"
                             IsOpen="{Binding ShowsLanes, Mode=TwoWay}"
                             StripHeight="{Binding LanesHeight, Mode=TwoWay}">
              <views:AutomationStrip DataContext="{Binding Lanes}" />
            </views:FoldStrip>
          </Grid>

        </DockPanel>
      </Border>

      <!-- Instruments -->
      <GridSplitter Grid.Column="3" Classes="handle" ResizeDirection="Columns"
                    ToolTip.Tip="Drag to give the song's instruments more or less room." />

      <Border Grid.Column="4" Classes="card">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="cardTitle" Text="Song instruments" />

            <views:HelpBadge Topic="tracker.song-instruments" />
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <!-- The explanation is on the list itself. A paragraph that is read once cost
                 five lines of a narrow sidebar every time it was not being read. -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <!-- Named and coloured: the colour is how the machine is known on the rack and
                   on the list below, so it belongs on the thing you pick it from too. -->
              <ComboBox Grid.Column="0"
                        ItemsSource="{Binding $parent[views:TrackerView].Instruments.Offered}"
                        SelectedItem="{Binding PickedMachine}"
                        HorizontalAlignment="Stretch"
                        PlaceholderText="Pick an instrument">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vmr:InstrumentChoice">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                              Background="{Binding Colour, Converter={StaticResource HexBrush}}" />
                      <TextBlock Text="{Binding Said}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Content="+ Add" Command="{Binding AddInstrumentCommand}" />
            </Grid>

            <Button Content="Rename..." HorizontalAlignment="Stretch"
                    IsEnabled="{Binding HasInstruments}"
                    Command="{Binding RenameInstrumentCommand}"
                    ToolTip.Tip="What this instrument is called in this song. The machine it came off keeps its own name." />

            <Button Content="Remove from song" HorizontalAlignment="Stretch" Classes="danger"
                    IsEnabled="{Binding HasInstruments}"
                    Command="{Binding RemoveInstrumentCommand}"
                    ToolTip.Tip="Takes the instrument out of this song. The machine it came off is untouched." />
          </StackPanel>

          <ListBox x:Name="InstrumentList"
                   ItemsSource="{Binding Instruments}"
                   SelectedIndex="{Binding SelectedInstrument}"
                   ItemTemplate="{StaticResource InstrumentRow}">
            <!-- The rows are two short lines; the list's own padding was making each one
                 twice the height it needs. -->
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,2" />
                <Setter Property="MinHeight" Value="0" />
              </Style>

              <!-- In the machine's colour, as on the rack: these are the same machines seen
                   from inside a song. -->
              <Style Selector="ListBoxItem" x:DataType="vm:InstrumentSlot">
                <Setter Property="Background"
                        Value="{Binding Row}" />
              </Style>
              <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter" x:DataType="vm:InstrumentSlot">
                <Setter Property="Background"
                        Value="{Binding RowOver}" />
              </Style>
              <Style Selector="ListBoxItem:selected /template/ ContentPresenter" x:DataType="vm:InstrumentSlot">
                <Setter Property="Background"
                        Value="{Binding RowPicked}" />
              </Style>
            </ListBox.Styles>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>

    <!-- Held in a ContentControl so the visibility is asked of the tracker while the page
         itself is given the rack: a DataContext set on the same element would take the
         binding beside it with it. -->
    <ContentControl IsVisible="{Binding ShowsMachines}"
                    Content="{Binding $parent[views:TrackerView].Instruments}">
      <ContentControl.ContentTemplate>
        <DataTemplate>
          <views:RackView />
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>

    <!-- Held in a border of its own so the page can be taken out of it and put back. A page in
         a window of its own is the page itself rather than a second copy: two mixers would each
         poll their meters while anything is sounding, for one set of levels, and could disagree
         about which strip is picked. -->
    <Panel x:Name="MixerHost" IsVisible="{Binding ShowsMixer}">
      <views:MixerView x:Name="Mixer" />

      <!-- What stands where the mixer stood while the mixer is elsewhere, and only ever one of
           the two is in here. Whether this page is up at all is the one binding above, so
           being on the pattern with the mixer detached shows neither. The rack's empty tab is
           the same shape and for the same reason: a page that falls back to nothing reads as a
           page that is broken rather than as a page that has moved. -->
      <StackPanel x:Name="MixerGone" IsVisible="False"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="The mixer is in a window of its own."
                   HorizontalAlignment="Center" Opacity="0.8" />
        <Button Content="Bring it back" Classes="page" HorizontalAlignment="Center"
                Click="DockMixer_Click"
                ToolTip.Tip="Closes the window and puts the mixer back on this page." />
      </StackPanel>
    </Panel>

    <!-- The templates, one card for each controller against each thing it is pointed at. Here
         because this is where you make one: pointing at a machine on the rack is one button
         away, and until now the only place to read the result was SETTINGS, which is a
         different page in a different part of the application from the gesture that wrote it.
         It is still in SETTINGS, since that is where the hardware is looked after, and it is
         the same list rather than a copy of it: forgetting a link on either page is the same
         act and both pages show it at once.

         There were two lists here, this one and the song's own. A song no longer holds links:
         what a knob does to a machine is true of every song that plays it, so a copy per song
         was the same work done again and could be handed to nobody. -->
    <!-- Each card as tall as what it holds, and the page scrolls when they are together taller
         than the window. A list wants the room its contents want. -->
    <ScrollViewer IsVisible="{Binding ShowsControls}" VerticalScrollBarVisibility="Auto">
      <views:ControlLinksView DataContext="{Binding DeskControls}" />
    </ScrollViewer>

    </Grid>
  </DockPanel>

  <Canvas x:Name="GhostLayer" IsHitTestVisible="False" />

  </Panel>
</UserControl>
