<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JingleBox2.ViewModels"
             xmlns:views="clr-namespace:JingleBox2.Views"
             xmlns:tracker="clr-namespace:JingleBox2.Tracker"
             x:Class="JingleBox2.Views.TrackerView"
             x:DataType="vm:TrackerViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.field">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.8" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="16">

    <!-- Transport -->
    <Border DockPanel.Dock="Top" Classes="card stacked">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="●" ToolTip.Tip="Record: typing writes into the pattern"
                Classes="transport record"
                Classes.armed="{Binding IsRecording}"
                Command="{Binding ToggleRecordCommand}" />
        <Button Content="▶" ToolTip.Tip="Play"
                Classes="transport"
                Classes.active="{Binding IsPlaying}"
                Command="{Binding PlayCommand}" />
        <Button Content="❚❚" ToolTip.Tip="Pause"
                Classes="transport"
                Classes.active="{Binding IsPaused}"
                Command="{Binding PauseCommand}" IsEnabled="{Binding CanPause}" />
        <Button Content="■" ToolTip.Tip="Stop"
                Classes="transport"
                Command="{Binding StopCommand}" />

        <ComboBox ItemsSource="{Binding PlayModes}"
                  SelectedItem="{Binding PlayMode}"
                  MinWidth="104"
                  Margin="6,0,0,0" />

        <TextBlock Classes="field" Text="BPM" Margin="12,0,0,0" />
        <NumericUpDown Classes="tracker" Value="{Binding Bpm}"
                       Minimum="20" Maximum="400" FormatString="0" Width="136" />

        <TextBlock Classes="field" Text="LPB" />
        <NumericUpDown Classes="tracker" Value="{Binding LinesPerBeat}"
                       Minimum="1" Maximum="16" FormatString="0" Width="112" />

        <TextBlock Classes="field" Text="Step" />
        <NumericUpDown Classes="tracker" Value="{Binding EditStep}"
                       Minimum="0" Maximum="16" FormatString="0" Width="112" />

        <TextBlock Classes="field" Text="Oct" />
        <NumericUpDown Classes="tracker" Value="{Binding Octave}"
                       Minimum="0" Maximum="9" FormatString="0" Width="104" />

        <TextBlock Classes="field" Text="Tracks" Margin="12,0,0,0" />
        <Button Content="-" Command="{Binding RemoveTrackCommand}" />
        <TextBlock Classes="field" Text="{Binding TrackCount}" />
        <Button Content="+" Command="{Binding AddTrackCommand}" />
      </StackPanel>
    </Border>

    <!-- Status -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="field" Text="Open:" />
          <ComboBox Grid.Column="1"
                    ItemsSource="{Binding SavedSongs}"
                    SelectedItem="{Binding SelectedSongFile}"
                    HorizontalAlignment="Stretch"
                    PlaceholderText="No saved songs" />
          <Button Grid.Column="2" Content="Open" Command="{Binding LoadCommand}" />
          <Button Grid.Column="3" Content="Refresh" Command="{Binding RefreshSongsCommand}" />
          <Button Grid.Column="4" Content="New" Command="{Binding NewSongCommand}" />
        </Grid>

        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
          <TextBlock Grid.Column="0" Classes="field" Text="Save as:" />
          <TextBox Grid.Column="1" Text="{Binding SongName}" />
          <Button Grid.Column="2" Content="Save" Command="{Binding SaveCommand}" />
        </Grid>

        <TextBlock Classes="cardHint" Text="{Binding Status}" />
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="180,*,220" ColumnSpacing="12">

      <!-- Order list -->
      <Border Grid.Column="0" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Order" />
          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <Button Content="+ Pattern" HorizontalAlignment="Stretch"
                    Command="{Binding AddPatternCommand}" />
            <Button Content="Remove slot" HorizontalAlignment="Stretch" Classes="danger"
                    Command="{Binding RemoveOrderEntryCommand}" />
          </StackPanel>
          <ListBox ItemsSource="{Binding OrderEntries}"
                   SelectedIndex="{Binding OrderIndex}"
                   FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
        </DockPanel>
      </Border>

      <!-- Pattern -->
      <Border Grid.Column="1" Classes="card">
        <DockPanel>
          <views:PatternHeader x:Name="Header"
                               DockPanel.Dock="Top"
                               TrackCount="{Binding TrackCount}"
                               SelectedTrack="{Binding SelectedTrack}"
                               TrackLabels="{Binding TrackLabels}"
                               Margin="0,0,0,4" />

          <ScrollViewer x:Name="GridScroll"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Auto">
            <views:PatternGrid x:Name="Grid"
                               Pattern="{Binding CurrentPattern}"
                               EditCursor="{Binding Cursor, Mode=TwoWay}"
                               PlayingLine="{Binding PlayingLine}"
                               LinesPerBeat="{Binding LinesPerBeat}" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Instruments -->
      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Classes="cardTitle" Text="Instruments" />

          <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
            <TextBlock Classes="cardHint"
                       Text="Drag an instrument onto a track, anywhere in its column, to put it there. An instrument sits on one track only: to use the same sample twice, add the recording again." />

            <Button Content="Remove instrument" HorizontalAlignment="Stretch"
                    Classes="danger"
                    IsEnabled="{Binding HasInstruments}"
                    Command="{Binding RemoveInstrumentCommand}" />

            <TextBlock Classes="cardHint" Text="Add a recording as an instrument:" Margin="0,6,0,0" />
            <ComboBox x:Name="RecordingPicker"
                      ItemsSource="{Binding AvailableRecordings}"
                      DisplayMemberBinding="{Binding Name}"
                      HorizontalAlignment="Stretch" />
            <Button Content="Add instrument" HorizontalAlignment="Stretch"
                    Click="AddInstrument_Click" />
          </StackPanel>

          <ListBox x:Name="InstrumentList"
                   ItemsSource="{Binding Instruments}"
                   SelectedIndex="{Binding SelectedInstrument}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:InstrumentSlot">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Number}"
                             FontFamily="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace"
                             VerticalAlignment="Center"
                             Opacity="0.7" />
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="cardHint" Text="{Binding TrackText}"
                                 FontWeight="{Binding HasTrack, Converter={x:Static views:TrackWeight.Instance}}" />
                      <TextBlock Classes="cardHint" Text="{Binding BaseNoteText}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
