{
  "Id": "effect.sweeper",
  "Name": "Sweeper",
  "Summary": "Filter. Four poles, a drive into them, and a cutoff that glides.",
  "Author": "Peter van de Pas",
  "Version": "1.1",
  "Engine": "Filter",
  "Theme": {
    "Accent": "#7A6CE0",
    "Face": 0.68,
    "Panel": 0.52,
    "Edge": 0.1,
    "Mark": 0.35,
    "Row": 0.18,
    "RowOver": 0.3,
    "RowPicked": 0.58
  },
  "Parameters": [
    {
      "Key": "cutoff",
      "Name": "Cutoff",
      "Unit": "Hz",
      "Min": 20,
      "Max": 20000,
      "Default": 12000,
      "Step": 1
    },
    {
      "Key": "resonance",
      "Name": "Reso",
      "Unit": "",
      "Min": 0,
      "Max": 0.98,
      "Default": 0.2,
      "Step": 0.01
    },
    {
      "Key": "drive",
      "Name": "Drive",
      "Unit": "",
      "Min": 1,
      "Max": 8,
      "Default": 1,
      "Step": 0.01
    },
    {
      "Key": "even",
      "Name": "Drive keeps",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0,
      "Step": 1
    },
    {
      "Key": "filter_first",
      "Name": "Order",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0,
      "Step": 1
    },
    {
      "Key": "mode",
      "Name": "Mode",
      "Unit": "",
      "Min": 0,
      "Max": 2,
      "Default": 0,
      "Step": 1
    },
    {
      "Key": "mix",
      "Name": "Mix",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 1,
      "Step": 0.01
    },
    {
      "Key": "swing",
      "Name": "Swing",
      "Unit": "oct",
      "Min": 0,
      "Max": 4,
      "Default": 0,
      "Step": 0.01
    },
    {
      "Key": "swing_rate",
      "Name": "Speed",
      "Unit": "Hz",
      "Min": 0.05,
      "Max": 10,
      "Default": 1,
      "Step": 0.01
    },
    {
      "Key": "swing_sync",
      "Name": "Sync",
      "Unit": "",
      "Min": 0,
      "Max": 8,
      "Default": 0,
      "Step": 1
    },
    {
      "Key": "follow",
      "Name": "Follow",
      "Unit": "oct",
      "Min": -4,
      "Max": 4,
      "Default": 0,
      "Step": 0.01
    },
    {
      "Key": "level",
      "Name": "Level",
      "Unit": "dB",
      "Min": -24,
      "Max": 12,
      "Default": 0,
      "Step": 0.1
    }
  ],
  "Panel": {
    "Root": {
      "Element": "Column",
      "Parameter": "",
      "Label": "",
      "Properties": {
        "gap": "10",
        "align": "stretch"
      },
      "Children": [
        {
          "Element": "Menu",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "corner": "topRight"
          },
          "Children": []
        },
        {
          "Element": "Label",
          "Parameter": "",
          "Label": "Sweeper",
          "Properties": {
            "style": "section"
          },
          "Children": []
        },
        {
          "Element": "Preset",
          "Parameter": "",
          "Label": "",
          "Properties": {},
          "Children": []
        },
        {
          "Element": "Group",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "caption": "Filter"
          },
          "Children": [
            {
              "Element": "Strip",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "cell": "26",
                "gap": "6",
                "columns": "3 3 3 4 5 3"
              },
              "Children": [
                {
                  "Element": "Knob",
                  "Parameter": "cutoff",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "Where the filter turns over. It glides rather than jumps, so a sweep sounds like a sweep and not like a click a message."
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "resonance",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "How hard it rings at the cutoff. Near the top it is nearly singing, which is what the drive is there to lean on."
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "drive",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "How hard the signal is pushed into the filter, in front of it rather than after. This is what makes a resonant sweep sound like an instrument instead of a whistle."
                  },
                  "Children": []
                },
                {
                  "Element": "Choice",
                  "Parameter": "even",
                  "Label": "",
                  "Properties": {
                    "span": "4",
                    "options": "Peak,Loudness",
                    "width": "100",
                    "tip": "What the drive is levelled out by. Peak holds the height of the wave, which is what this effect has always done and lets the knob add several decibels on the way up. Loudness measures what actually went past and gives that back instead, so the knob changes the tone and not the level. Peak is what every chain written before this was made against.",
                    "align": "middle"
                  },
                  "Children": []
                },
                {
                  "Element": "Choice",
                  "Parameter": "filter_first",
                  "Label": "",
                  "Properties": {
                    "span": "5",
                    "options": "Drive first,Filter first",
                    "width": "120",
                    "tip": "Which comes first. Drive first squares the signal up and the poles take the top off what it made, which is the screaming filter this effect was written as; Filter first shapes the signal and the curve rounds off what is left, so the resonance is not ringing on something that is already square.",
                    "align": "middle"
                  },
                  "Children": []
                },
                {
                  "Element": "Choice",
                  "Parameter": "mode",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "options": "Low,Band,High",
                    "width": "78",
                    "tip": "Low keeps the weight, high keeps the air, band keeps only what is around the cutoff.",
                    "align": "middle"
                  },
                  "Children": []
                }
              ]
            }
          ]
        },
        {
          "Element": "Row",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "gap": "12"
          },
          "Children": [
            {
              "Element": "Group",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "caption": "Movement"
              },
              "Children": [
                {
                  "Element": "Strip",
                  "Parameter": "",
                  "Label": "",
                  "Properties": {
                    "cell": "26",
                    "gap": "6",
                    "columns": "3 3 5 3"
                  },
                  "Children": [
                    {
                      "Element": "Knob",
                      "Parameter": "swing",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "44",
                        "lines": "1",
                        "tip": "How many octaves a slow wave moves the cutoff up and down by, either side of where the cutoff knob has put it. Nought holds it still."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "swing_rate",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "44",
                        "lines": "1",
                        "tip": "How fast the swing goes, in turns a second. Under one is a slow sweep; a few a second is a wobble."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Choice",
                      "Parameter": "swing_sync",
                      "Label": "",
                      "Properties": {
                        "options": "Free,1/1,1/2,1/4,1/8,1/8T,1/16,1/16T,1/32",
                        "tip": "Free runs at the rate beside it. Anything else runs in time with the song, at that note length, and the rate is ignored.",
                        "align": "middle"
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "follow",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "44",
                        "lines": "1",
                        "tip": "How far the track's own loudness moves the cutoff, in octaves. Up, a note hit hard opens the filter and it closes as the note falls away, which is an auto-wah. Below nought, a loud note closes it instead."
                      },
                      "Children": []
                    }
                  ]
                }
              ]
            },
            {
              "Element": "Group",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "caption": "Output"
              },
              "Children": [
                {
                  "Element": "Strip",
                  "Parameter": "",
                  "Label": "",
                  "Properties": {
                    "cell": "26",
                    "gap": "6",
                    "columns": "3 3"
                  },
                  "Children": [
                    {
                      "Element": "Knob",
                      "Parameter": "mix",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "44",
                        "lines": "1",
                        "tip": "How much of what you hear has been through it."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "level",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "44",
                        "lines": "1",
                        "tip": "How loud the effect hands the track back. It is the last thing the sound goes through, so it evens out what the effect did to the level without moving the track's fader."
                      },
                      "Children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
