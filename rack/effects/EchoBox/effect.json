{
  "Id": "effect.echobox",
  "Name": "EchoBox",
  "Summary": "Delay. What went past comes back later, darker each time.",
  "Author": "Peter van de Pas",
  "Version": "1.0",
  "Engine": "Delay",
  "Theme": {
    "Accent": "#4FB07A",
    "Face": 0.68,
    "Panel": 0.52,
    "Edge": 0.1,
    "Mark": 0.35,
    "Row": 0.18,
    "RowOver": 0.3,
    "RowPicked": 0.58
  },
  "Parameters": [
    {
      "Key": "time",
      "Name": "Time",
      "Unit": "ms",
      "Min": 10,
      "Max": 2000,
      "Default": 375,
      "Step": 1
    },
    {
      "Key": "feedback",
      "Name": "Feedback",
      "Unit": "",
      "Min": 0,
      "Max": 0.95,
      "Default": 0.35,
      "Step": 0.01
    },
    {
      "Key": "damp",
      "Name": "Damp",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0.3,
      "Step": 0.01
    },
    {
      "Key": "mix",
      "Name": "Mix",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0.3,
      "Step": 0.01
    },
    {
      "Key": "ping",
      "Name": "Repeats",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0,
      "Step": 1
    },
    {
      "Key": "wow",
      "Name": "Wow",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0,
      "Step": 0.01
    },
    {
      "Key": "grit",
      "Name": "Grit",
      "Unit": "",
      "Min": 0,
      "Max": 1,
      "Default": 0,
      "Step": 0.01
    },
    {
      "Key": "level",
      "Name": "Level",
      "Unit": "dB",
      "Min": -24,
      "Max": 12,
      "Default": 0,
      "Step": 0.1
    }
  ],
  "Panel": {
    "Root": {
      "Element": "Column",
      "Parameter": "",
      "Label": "",
      "Properties": {
        "gap": "10",
        "align": "stretch"
      },
      "Children": [
        {
          "Element": "Menu",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "corner": "topRight"
          },
          "Children": []
        },
        {
          "Element": "Label",
          "Parameter": "",
          "Label": "EchoBox",
          "Properties": {
            "style": "section"
          },
          "Children": []
        },
        {
          "Element": "Preset",
          "Parameter": "",
          "Label": "",
          "Properties": {},
          "Children": []
        },
        {
          "Element": "Group",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "caption": "Delay"
          },
          "Children": [
            {
              "Element": "Strip",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "cell": "26",
                "gap": "6",
                "columns": "3 3 3 3 3"
              },
              "Children": [
                {
                  "Element": "Knob",
                  "Parameter": "time",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1"
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "feedback",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1"
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "damp",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1"
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "mix",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1"
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "level",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "How loud the effect hands the track back. It is the last thing the sound goes through, so it evens out what the effect did to the level without moving the track's fader."
                  },
                  "Children": []
                }
              ]
            }
          ]
        },
        {
          "Element": "Group",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "caption": "Tape"
          },
          "Children": [
            {
              "Element": "Strip",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "cell": "26",
                "gap": "6",
                "columns": "5 3 3"
              },
              "Children": [
                {
                  "Element": "Choice",
                  "Parameter": "ping",
                  "Label": "",
                  "Properties": {
                    "span": "5",
                    "options": "Straight,Ping-pong",
                    "width": "110",
                    "tip": "Straight keeps each side's repeats on that side. Ping-pong sends the first repeat to the left and the next to the right, so the echoes bounce across the room."
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "wow",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "How much the tape wanders. A slow drift and a quick flutter on top, so each repeat comes back a few cents out and moving, like a machine that does not quite hold speed."
                  },
                  "Children": []
                },
                {
                  "Element": "Knob",
                  "Parameter": "grit",
                  "Label": "",
                  "Properties": {
                    "span": "3",
                    "dial": "44",
                    "lines": "1",
                    "tip": "How hard what goes back in is bent. Quiet repeats are left alone and loud ones are squashed a little more on every pass, which keeps a long feedback from running away and gives it the sound of a worn head."
                  },
                  "Children": []
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
