                      "Properties": {
                        "tip": "How long a note takes to reach full."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Fader",
                      "Parameter": "decay",
                      "Label": "",
                      "Properties": {
                        "tip": "How long it takes to fall from full to the sustain."
                      },
                      "Children": []
