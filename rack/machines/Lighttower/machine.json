        },
        {
          "Element": "Row",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "gap": "10",
            "heights": "own"
          },
          "Children": [
            {
              "Element": "Group",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "caption": "Waves"
              },
              "Children": [
                {
                  "Element": "Segments",
                  "Parameter": "",
                  "Label": "",
                  "Properties": {
                    "begin": "begin",
                    "end": "end",
                    "picture": "140",
                    "tip": "Draw a wave on the pad with the pointer. Begin is where the note starts and End is where it arrives; the thirty waves between are worked out, and the stack beside the pad shows all thirty two, the first at the front."
                  },
                  "Children": []
                }
              ]
            }
          ]
        },
        {
          "Element": "Row",
          "Parameter": "",
          "Label": "",
          "Properties": {
            "gap": "10",
            "heights": "own"
          },
          "Children": [
            {
              "Element": "Group",
              "Parameter": "",
              "Label": "",
              "Properties": {
                "caption": "Voice"
              },
              "Children": [
                {
                  "Element": "Strip",
                  "Parameter": "",
                  "Label": "",
                  "Properties": {
                    "cell": "26",
                    "gap": "4",
                    "columns": "3 4 4 3 3 3 3"
                  },
                  "Children": [
                    {
                      "Element": "Knob",
                      "Parameter": "sweep",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How long a note takes to get from the first wave to the last. Short is a sound with a bite at the front; long is one that changes slowly while it is held."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Switch",
                      "Parameter": "motion",
                      "Label": "",
                      "Properties": {
                        "span": "4",
                        "options": "Once,Loop,Bounce",
                        "tip": "What happens once the note reaches the last wave. Once stays there. Loop goes straight back to the first and round again. Bounce comes back the way it went, over and over."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Switch",
                      "Parameter": "grit",
                      "Label": "",
                      "Properties": {
                        "span": "4",
                        "options": "Smooth,Grit",
                        "tip": "Grit is the Fairlight: eight bit points read without smoothing, and a note that only moves on to the next wave when the wave comes round, so it steps through the thirty two. Smooth glides between the waves and between the points."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "tune",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "Whole semitones added to every note, two octaves either way."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "fine",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "The last hundredth of a semitone."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "volume",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How loud the machine comes out, before the track's own level."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Switch",
                      "Parameter": "new_note",
                      "Label": "",
                      "Properties": {
                        "options": "Cut,Release,Sustain",
                        "tip": "What happens to the note this track is still sounding when the next one lands on it. Cut stops it; Release lets it play its own release under the new note; Sustain leaves it holding until an OFF."
                      },
                      "Children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
