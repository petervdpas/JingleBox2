                    {
                      "Element": "Fader",
                      "Parameter": "sustain",
                      "Label": "",
                      "Properties": {
                        "tip": "Where it holds while the key is down. Nought falls away to silence however long the key is held."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Fader",
                      "Parameter": "release",
                      "Label": "",
