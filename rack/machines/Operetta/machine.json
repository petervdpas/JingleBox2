                  "Children": [
                    {
                      "Element": "Choice",
                      "Parameter": "algorithm",
                      "Label": "",
                      "Properties": {
                        "span": "5",
                        "options": "4→3→2→1,3+4→2→1,2+(4→3)→1,2→1 & 4→3,4→1+2+3,2→1 & 3 & 4,2+3+4→1,1+2+3+4",
                        "width": "130",
                        "tip": "How the four operators are wired. An arrow is one operator bending the next; a plus is two heard or two bending together. Only what reaches the end of a line is heard. One long line is the brightest and most complex; all four side by side is an organ.",
                        "align": "middle"
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "feedback",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How much of the fourth operator is fed back into itself. A little turns its sine towards a saw; the top of the knob starts to hiss."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "tune",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "Whole semitones added to every note, two octaves either way."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "fine",
                      "Label": "",
                      "Properties": {
                        "span": "3",
