                  "Properties": {
                    "cell": "26",
                    "gap": "4",
                    "columns": "3 3 3 3 3 3 3"
                  },
                  "Children": [
                    {
                      "Element": "Knob",
                      "Parameter": "op1_ratio",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How many times the note's frequency the first operator runs at. Whole numbers are harmonic; anything between them is a bell or metal."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_fine",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "A few cents off the ratio. Two carriers a little apart beat slowly against each other, which is chorus without an effect."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_level",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How loud this operator is where it is heard, or how hard it bends another where it is a modulator. On a modulator this is brightness."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_attack",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How long this operator takes to reach its level. A slow attack on a modulator is a sound that starts dull and opens."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_decay",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How long it takes to fall from its level to its sustain. A short decay on a modulator is the bright strike at the start of a piano or a bell."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_sustain",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "Where it holds while the key is down, as a share of its level. Nought falls away to silence however long the key is held."
                      },
                      "Children": []
                    },
                    {
                      "Element": "Knob",
                      "Parameter": "op1_release",
                      "Label": "",
                      "Properties": {
                        "span": "3",
                        "dial": "40",
                        "lines": "1",
                        "tip": "How long it takes to fall away once the key comes up."
                      },
                      "Children": []
                    }
                  ]
                }
              ]
