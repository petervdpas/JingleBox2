<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parts a machine's front panel is made of.

    The second half of the contract: the first says what a machine is, this says what it is
    drawn with. A knob, a fader, a switch, a group frame, a keyboard, and the palette they all
    read their colours from. A machine written by somebody else builds its panel out of these,
    which is why they live here rather than in the application.

    Avalonia, and nothing else. No BASS, no view models, no tracker: a panel is a picture of a
    machine's settings and has no business knowing what a song is.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>JingleBox2.Machines.Ui</RootNamespace>
    <AssemblyName>JingleBox2.Machines.Ui</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Machines.Abstractions\JingleBox2.Machines.Abstractions.csproj" />
  </ItemGroup>

</Project>
