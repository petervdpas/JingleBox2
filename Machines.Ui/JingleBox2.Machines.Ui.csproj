<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The parts a machine's front panel is made of.

    The second half of the contract: the first says what a machine is, this says what it is
    drawn with. A knob, a fader, a switch, a group frame, a keyboard, a recording's picture, and
    the palette they all read their colours from. A machine written by somebody else builds its
    panel out of these, which is why they live here rather than in the application.

    Avalonia, and nothing else. No BASS, no view models, no tracker: a panel is a picture of a
    machine's settings and has no business knowing what a song is. That is where the line was
    drawn through the waveform: the viewport maths and the outline building came here because a
    panel has to draw a recording, and the player that sounds one stayed behind because it is
    BASS.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>JingleBox2.Machines.Ui</RootNamespace>
    <AssemblyName>JingleBox2.Machines.Ui</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <!--
      A drawing reader, for the one element that shows a file: a machine's badge. Avalonia knows
      how to decode a png and a jpg and nothing about an svg, and a logo is exactly the picture
      that wants to be drawn rather than sampled, since a panel is laid out at whatever size the
      person laying it out says. It belongs here and not in the abstractions: the abstractions
      say a picture is a file with a name, and which of them can be read is a question about
      whoever is doing the drawing.
    -->
    <PackageReference Include="Svg.Controls.Avalonia" Version="12.0.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Machines.Abstractions\JingleBox2.Machines.Abstractions.csproj" />
  </ItemGroup>

</Project>
