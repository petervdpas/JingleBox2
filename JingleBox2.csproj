<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- The CLAP plugin ABI is C function pointers: hosting one means unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.0.0-local</Version>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>

    <!-- The documentation is an artefact of the build, not a comment nobody reads. Every seam
         in this application is an interface and the prose lives on it; this is what turns that
         into a file, and what makes the compiler say which public thing is still undocumented.
         CS1591 is left switched on deliberately: it is the list of what is left to write. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- What a machine is written against. The host knows machines only through this. -->
    <ProjectReference Include="Rack.SoundDevices\JingleBox2.Rack.SoundDevices.csproj" />
    <!-- And what a machine's panel is drawn with. -->
    <ProjectReference Include="Rack.Controls\JingleBox2.Rack.Controls.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The machines that ship. A machine is a project on disc, so the ones we supply are
         copied out beside the program and read at startup like any other. -->
    <None Include="rack\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The controller profiles and codecs that ship. A codec is a Lua file read at startup, and
         adding a controller is adding one of these rather than changing any of this.

         They live under Controllers\Profiles and land in the output as plain "controllers",
         which is what ControllerFolder.Shipped looks for. The source folder cannot itself be
         called "controllers": that differs from the Controllers\ source folder only in case, so
         Windows and macOS see one folder, git checks both into it, and this glob then sweeps the
         C# sources into the output as content. -->
    <None Include="Controllers\Profiles\**\*" CopyToOutputDirectory="PreserveNewest" Link="controllers\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract compiles itself. Without this the host's own globs would swallow its
         sources and its build folder, and compile both twice. -->
    <Compile Remove="Rack.SoundDevices\**" />
    <Compile Remove="Rack.Controls\**" />
    <EmbeddedResource Remove="Rack.SoundDevices\**" />
    <EmbeddedResource Remove="Rack.Controls\**" />
    <None Remove="Rack.SoundDevices\**" />
    <None Remove="Rack.Controls\**" />
    <AvaloniaResource Remove="Rack.SoundDevices\**" />
    <AvaloniaResource Remove="Rack.Controls\**" />
    <AvaloniaXaml Remove="Rack.SoundDevices\**" />
    <AvaloniaXaml Remove="Rack.Controls\**" />

    <!-- And the tests, for the same reason: a project inside this one's folder is swallowed by
         this one's own globs, which compiles its sources here as well and duplicates everything
         the build generates. -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <AvaloniaResource Remove="Tests\**" />
    <AvaloniaXaml Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ManagedBass.Asio" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Mix" Version="4.0.2" />
    <PackageReference Include="ManagedBass.Wasapi" Version="4.0.2" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="managed-midi" Version="1.10.1" />
    <PackageReference Include="ManagedBass.Aac" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
    <AvaloniaResource Include="Assets\splash.svg" />
  </ItemGroup>
  <ItemGroup>
    <None Include="native\win-x64\bass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
    <None Include="native\win-x64\bass_aac.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
    <!-- Recording what an output is playing. Optional: without it the RECORD page simply has no
         monitor entries, so a build with no basswasapi.dll is a smaller feature set, not a break. -->
    <None Include="native\win-x64\basswasapi.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="Exists('native\win-x64\basswasapi.dll') And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'))" />
    <!--
      ASIO is Steinberg's low-latency driver standard, and bassasio is un4seen's add-on for it.
      It is not in the ManagedBass.Asio package, which is the managed wrapper alone, so the file
      has to be put here by hand the way bass.dll was. Conditioned on existing, deliberately: a
      checkout without it builds and runs, lists no ASIO drivers, and says why when asked.
    -->
    <None Include="native\win-x64\bassasio.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="Exists('native\win-x64\bassasio.dll') And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'))" />
    <!--
      Summing what this application plays into one stream, which is un4seen's bassmix. Not in the
      ManagedBass.Mix package either, so it is carried here like the rest of them. Not conditioned
      on existing, unlike bassasio: ASIO absent is a shorter list of outputs, and this absent is
      every source playing on its own again, which is the thing it exists to stop.
    -->
    <None Include="native\win-x64\bassmix.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
    <None Include="native/linux-x64/libbass.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbass.so')">
      <TargetPath>runtimes/linux-x64/native/libbass.so</TargetPath>
    </None>
    <None Include="native/linux-x64/libbass_aac.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbass_aac.so')">
      <TargetPath>runtimes/linux-x64/native/libbass_aac.so</TargetPath>
    </None>
    <None Include="native/linux-x64/libbassmix.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbassmix.so')">
      <TargetPath>runtimes/linux-x64/native/libbassmix.so</TargetPath>
    </None>
    <None Include="native/linux-arm64/libbass.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbass.so')">
      <TargetPath>runtimes/linux-arm64/native/libbass.so</TargetPath>
    </None>
    <None Include="native/linux-arm64/libbass_aac.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbass_aac.so')">
      <TargetPath>runtimes/linux-arm64/native/libbass_aac.so</TargetPath>
    </None>
    <None Include="native/linux-arm64/libbassmix.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbassmix.so')">
      <TargetPath>runtimes/linux-arm64/native/libbassmix.so</TargetPath>
    </None>
  </ItemGroup>
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion;GenerateNuspec;BeforeCompile" Condition="'$(Version)' == '0.0.0-local'">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMsBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitTagRaw" />
    </Exec>
    <PropertyGroup>
      <_GitTag>$([System.String]::Copy('$(_GitTagRaw)').Trim())</_GitTag>
      <Version Condition="'$(_GitTag)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitTag)', '^v?\d+\.\d+\.\d+([-.][0-9A-Za-z]+)*$'))">$(_GitTag.TrimStart('v'))</Version>
      <Version Condition="'$(Version)' == '0.0.0-local'">0.0.0-local</Version>
    </PropertyGroup>
  </Target>
  <Target Name="CopyBassToOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native\win-x64\bass_aac.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bass_aac.dll')" />
    <Copy SourceFiles="native\win-x64\basswasapi.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\basswasapi.dll')" />
    <Copy SourceFiles="native\win-x64\bassasio.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bassasio.dll')" />
    <Copy SourceFiles="native\win-x64\bassmix.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bassmix.dll')" />
  </Target>
  <Target Name="CopyBassToLinuxOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' != 'Windows_NT' And Exists('native/linux-x64/libbass.so')">
    <Copy SourceFiles="native/linux-x64/libbass.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native/linux-x64/libbass_aac.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native/linux-x64/libbass_aac.so')" />
    <Copy SourceFiles="native/linux-x64/libbassmix.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native/linux-x64/libbassmix.so')" />
  </Target>
  <Target Name="EnsureBassDllInPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native\win-x64\bass_aac.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bass_aac.dll')" />
    <Copy SourceFiles="native\win-x64\basswasapi.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\basswasapi.dll')" />
    <Copy SourceFiles="native\win-x64\bassasio.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bassasio.dll')" />
    <Copy SourceFiles="native\win-x64\bassmix.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bassmix.dll')" />
  </Target>
</Project>