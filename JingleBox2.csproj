<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>

    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <!-- Publish targets -->
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.10" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />

    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>

    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="Melanchall.DryWetMidi" Version="8.0.3" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>

  <!-- =========================
       Native BASS binaries (per RID)
       ========================= -->
  <ItemGroup>
    <!-- Windows -->
    <None Include="native\win-x64\bass.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />

    <!-- Linux x64 -->
    <None Include="native/linux-x64/libbass.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbass.so')">
      <TargetPath>runtimes/linux-x64/native/libbass.so</TargetPath>
    </None>

    <!-- Linux ARM64 -->
    <None Include="native/linux-arm64/libbass.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbass.so')">
      <TargetPath>runtimes/linux-arm64/native/libbass.so</TargetPath>
    </None>
  </ItemGroup>

  <!-- =========================
       Native DryWetMIDI binaries (per RID)
       Notes:
       - linux-x64 .so is REQUIRED for Fedora x64
       - linux-arm64 .so is OPTIONAL until you provide it
       ========================= -->
  <ItemGroup>
    <!-- Linux x64 -->
    <None Include="native/linux-x64/Melanchall_DryWetMidi_Native64.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/Melanchall_DryWetMidi_Native64.so')">
      <TargetPath>Melanchall_DryWetMidi_Native64.so</TargetPath>
    </None>

    <!-- Linux ARM64 (only copied if present; prevents CI failure) -->
    <None Include="native/linux-arm64/Melanchall_DryWetMidi_Native64.so"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false"
          Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/Melanchall_DryWetMidi_Native64.so')">
      <TargetPath>Melanchall_DryWetMidi_Native64.so</TargetPath>
    </None>
  </ItemGroup>

  <!-- =========================
       Safety targets
       ========================= -->

  <Target Name="CopyBassToOutput"
          AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="EnsureBassDllInPublish"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'win-x64' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <!-- Fail fast for linux-x64 publish if DryWetMIDI .so is missing (because Fedora needs it) -->
  <Target Name="EnsureDryWetMidiSoInPublish_LinuxX64"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <Error Condition="!Exists('$(PublishDir)Melanchall_DryWetMidi_Native64.so')"
           Text="Missing Melanchall_DryWetMidi_Native64.so for linux-x64 publish. Add it at native/linux-x64/ or adjust packaging." />
  </Target>

  <!-- For linux-arm64 we do NOT fail (until you actually supply the ARM64 .so) -->
  <Target Name="WarnDryWetMidiSoMissing_LinuxArm64"
          AfterTargets="Publish"
          Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And !Exists('$(PublishDir)Melanchall_DryWetMidi_Native64.so')">
    <Message Importance="high"
             Text="WARNING: DryWetMIDI native .so not present for linux-arm64. MIDI will not work on ARM64 until native/linux-arm64/Melanchall_DryWetMidi_Native64.so is provided." />
  </Target>

</Project>
