<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- The CLAP plugin ABI is C function pointers: hosting one means unmanaged pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.0.0-local</Version>
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- What a machine is written against. The host knows machines only through this. -->
    <ProjectReference Include="Machines.Abstractions\JingleBox2.Machines.Abstractions.csproj" />
    <!-- And what a machine's panel is drawn with. -->
    <ProjectReference Include="Machines.Ui\JingleBox2.Machines.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The machines that ship. A machine is a project on disc, so the ones we supply are
         copied out beside the program and read at startup like any other. -->
    <None Include="machines\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The contract compiles itself. Without this the host's own globs would swallow its
         sources and its build folder, and compile both twice. -->
    <Compile Remove="Machines.Abstractions\**" />
    <Compile Remove="Machines.Ui\**" />
    <EmbeddedResource Remove="Machines.Abstractions\**" />
    <EmbeddedResource Remove="Machines.Ui\**" />
    <None Remove="Machines.Abstractions\**" />
    <None Remove="Machines.Ui\**" />
    <AvaloniaResource Remove="Machines.Abstractions\**" />
    <AvaloniaResource Remove="Machines.Ui\**" />
    <AvaloniaXaml Remove="Machines.Abstractions\**" />
    <AvaloniaXaml Remove="Machines.Ui\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.1" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.20">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ManagedBass.Wasapi" Version="4.0.2" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ManagedBass" Version="4.0.2" />
    <PackageReference Include="managed-midi" Version="1.10.1" />
    <PackageReference Include="ManagedBass.Aac" Version="4.0.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <None Include="native\win-x64\bass.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
    <None Include="native\win-x64\bass_aac.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT')" />
    <!-- Recording what an output is playing. Optional: without it the RECORD page simply has no
         monitor entries, so a build with no basswasapi.dll is a smaller feature set, not a break. -->
    <None Include="native\win-x64\basswasapi.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="Exists('native\win-x64\basswasapi.dll') And ('$(RuntimeIdentifier)' == 'win-x64' Or ('$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT'))" />
    <None Include="native/linux-x64/libbass.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbass.so')">
      <TargetPath>runtimes/linux-x64/native/libbass.so</TargetPath>
    </None>
    <None Include="native/linux-x64/libbass_aac.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-x64' And Exists('native/linux-x64/libbass_aac.so')">
      <TargetPath>runtimes/linux-x64/native/libbass_aac.so</TargetPath>
    </None>
    <None Include="native/linux-arm64/libbass.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbass.so')">
      <TargetPath>runtimes/linux-arm64/native/libbass.so</TargetPath>
    </None>
    <None Include="native/linux-arm64/libbass_aac.so" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" Condition="'$(RuntimeIdentifier)' == 'linux-arm64' And Exists('native/linux-arm64/libbass_aac.so')">
      <TargetPath>runtimes/linux-arm64/native/libbass_aac.so</TargetPath>
    </None>
  </ItemGroup>
  <Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion;GenerateNuspec;BeforeCompile" Condition="'$(Version)' == '0.0.0-local'">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMsBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitTagRaw" />
    </Exec>
    <PropertyGroup>
      <_GitTag>$([System.String]::Copy('$(_GitTagRaw)').Trim())</_GitTag>
      <Version Condition="'$(_GitTag)' != '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_GitTag)', '^v?\d+\.\d+\.\d+([-.][0-9A-Za-z]+)*$'))">$(_GitTag.TrimStart('v'))</Version>
      <Version Condition="'$(Version)' == '0.0.0-local'">0.0.0-local</Version>
    </PropertyGroup>
  </Target>
  <Target Name="CopyBassToOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' == 'Windows_NT' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native\win-x64\bass_aac.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bass_aac.dll')" />
    <Copy SourceFiles="native\win-x64\basswasapi.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\basswasapi.dll')" />
  </Target>
  <Target Name="CopyBassToLinuxOutput" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == '' And '$(OS)' != 'Windows_NT' And Exists('native/linux-x64/libbass.so')">
    <Copy SourceFiles="native/linux-x64/libbass.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native/linux-x64/libbass_aac.so" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('native/linux-x64/libbass_aac.so')" />
  </Target>
  <Target Name="EnsureBassDllInPublish" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64' And Exists('native\win-x64\bass.dll')">
    <Copy SourceFiles="native\win-x64\bass.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="native\win-x64\bass_aac.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\bass_aac.dll')" />
    <Copy SourceFiles="native\win-x64\basswasapi.dll" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" Condition="Exists('native\win-x64\basswasapi.dll')" />
  </Target>
  <!-- The machines' presets: a folder to a machine, a file to a preset, and whatever
       recordings a preset carries beside it. They go with the program rather than into your
       data, because they are part of it, and a kit that carries its own recordings is a kit
       that still works after the folder it was built from has moved. -->
  <ItemGroup>
    <None Include="Presets\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Presets" />
    <None Include="Presets\**\*.wav" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="Presets" />
  </ItemGroup>

</Project>