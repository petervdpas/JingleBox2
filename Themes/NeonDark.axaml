<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Color.Background">#05000A</Color>
  <Color x:Key="Color.Surface">#0E0018</Color>

  <Color x:Key="Color.Border">#2A0052</Color>
  <Color x:Key="Color.BorderMuted">#1A0030</Color>

  <Color x:Key="Color.Pad">#16002A</Color>
  <Color x:Key="Color.PadHover">#220040</Color>
  <Color x:Key="Color.PadChecked">#00FFCC</Color>

  <Color x:Key="Color.TextPrimary">#EFFFFF</Color>
  <Color x:Key="Color.TextMuted">#7FFFD4</Color>

  <Color x:Key="Color.Accent">#FF00FF</Color>
  <Color x:Key="Color.Danger">#FF3B7A</Color>
  <!-- Work that is not on disc yet. Warm rather than alarming: it is a reminder
       and not a fault, which is why it is not the danger colour. -->
  <Color x:Key="Color.Unsaved">#E08A3C</Color>

  <Color x:Key="SystemAccentColor">#FF00FF</Color>
  <Color x:Key="SystemAccentColorLight1">#FF66FF</Color>
  <Color x:Key="SystemAccentColorDark1">#B300B3</Color>

</ResourceDictionary>
