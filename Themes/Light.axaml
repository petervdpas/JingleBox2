<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="Color.Background">#F6F7F8</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>

  <Color x:Key="Color.Border">#D2D6DB</Color>
  <Color x:Key="Color.BorderMuted">#E1E4E8</Color>

  <Color x:Key="Color.Pad">#E0E0E0</Color>
  <Color x:Key="Color.PadHover">#D4D4D4</Color>
  <Color x:Key="Color.PadChecked">#BFE8D8</Color>

  <Color x:Key="Color.TextPrimary">#0E0E0E</Color>
  <Color x:Key="Color.TextMuted">#4A5560</Color>

  <!-- Blue, and Dark is the same blue lifted to where it reads on black. These two are the
       plain pair, the ones somebody picks when they want no colour in particular, so they are
       one theme in two lightnesses rather than two. They were blue against green for no reason
       anybody wrote down, which the plain pair least of all can afford: the coloured themes
       are each meant to be their own thing. -->
  <Color x:Key="Color.Accent">#0B6BFF</Color>
  <Color x:Key="Color.Danger">#B63E3E</Color>
  <!-- The button that puts your work on disc, while there is work to put there. Green
       because it is the safe half of the pair and reads as go without being decoded. -->
  <Color x:Key="Color.Save">#43A047</Color>
  <!-- And the button that throws that same work away. Warm rather than alarming: it is
       a caution and not a fault, which is why it is not the danger colour. -->
  <Color x:Key="Color.Discard">#E08A3C</Color>

  <Color x:Key="SystemAccentColor">#0B6BFF</Color>
  <Color x:Key="SystemAccentColorLight1">#4A93FF</Color>
  <Color x:Key="SystemAccentColorDark1">#0850BF</Color>

</ResourceDictionary>
