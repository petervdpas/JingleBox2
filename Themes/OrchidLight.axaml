<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Blossom on paper. Same pair as the dark one: purple for the trim, pink for a pad that
       is firing. -->
  <Color x:Key="Color.Background">#FBF4FA</Color>
  <Color x:Key="Color.Surface">#FFFFFF</Color>

  <Color x:Key="Color.Border">#E0C7E4</Color>
  <Color x:Key="Color.BorderMuted">#F0E2F2</Color>

  <Color x:Key="Color.Pad">#F4DEEF</Color>
  <Color x:Key="Color.PadHover">#E9CBE2</Color>
  <Color x:Key="Color.PadChecked">#FF9ED2</Color>

  <Color x:Key="Color.TextPrimary">#23111F</Color>
  <Color x:Key="Color.TextMuted">#6B4A66</Color>

  <Color x:Key="Color.Accent">#8E2FB5</Color>
  <Color x:Key="Color.Danger">#C0304E</Color>

  <Color x:Key="SystemAccentColor">#8E2FB5</Color>
  <Color x:Key="SystemAccentColorLight1">#B85FDB</Color>
  <Color x:Key="SystemAccentColorDark1">#661E85</Color>

</ResourceDictionary>
