<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:JingleBox2.ViewModels"
  xmlns:views="clr-namespace:JingleBox2.Views"
  x:Class="JingleBox2.MainWindow"
  x:DataType="vm:MainViewModel"
  MinWidth="520" MinHeight="480"
  WindowStartupLocation="CenterScreen"
  Title="JingleBox2"
  Icon="/Assets/icon.ico"
  Background="{DynamicResource BgBrush}">

  <DockPanel Margin="12">

    <!-- Nothing across the top any more: the theme and the output device are settings, and
         they live in SETTINGS with the rest of them. What is left is the page you are on. -->

    <!-- One bar for the whole window. Where you are when nothing is happening, what just
         happened when something is, and the main input and output beside it. -->
    <views:StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0"
                     ShowLevels="True"
                     Text="{Binding StatusLine.Text}"
                     Kind="{Binding StatusLine.Kind}"
                     InputLevel="{Binding StatusLine.InputLevel}"
                     OutputLevel="{Binding StatusLine.OutputLevel}"
                     ToolTip.Tip="{Binding StatusLine.History}" />

    <!-- The tabs, and the transport sitting on the same line at the other end of it.
         The transport belongs to the whole window rather than to the tracker page: what it is
         doing is worth seeing from the pads, and worth stopping from wherever you are. -->
    <Grid>

      <views:Transport HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       IsVisible="{Binding ShowsTransport}"
                       Margin="0,1,25,0"
                       ZIndex="1"
                       CapWidth="34" CapHeight="26" Gap="4" Quiet="True"
                       IsRecording="{Binding Transport.IsRecording}"
                       IsPlaying="{Binding Transport.IsPlaying}"
                       IsPaused="{Binding Transport.IsPaused}"
                       CanRecord="{Binding Transport.CanRecord}"
                       CanPlay="{Binding Transport.CanPlay}"
                       CanPause="{Binding Transport.CanPause}"
                       RecordCommand="{Binding Transport.RecordCommand}"
                       PlayCommand="{Binding Transport.PlayCommand}"
                       PauseCommand="{Binding Transport.PauseCommand}"
                       StopCommand="{Binding Transport.StopCommand}"
                       ToolTip.Tip="Works whatever this page plays: a take on RECORD, the pads on FIRE, the song on TRACKER. A cap that is faint has nothing to do here." />

    <!-- No padding of its own. A page runs to the same left and right edges as the tab
         names above it and the status bar below it, and the only inset is the one each page
         keeps at its top and foot. -->
    <TabControl Classes="pages" Padding="0" SelectedIndex="{Binding SelectedTab}">
      <TabControl.Styles>
        <!-- The pages' names, cut down to the height of the transport standing at the end of
             the same line. Fluent draws a tab at a size meant to be the loudest thing on a
             page, and these are a menu rather than a headline. Scoped by class so the sections
             rail inside SETTINGS keeps its own size. -->
        <Style Selector="TabControl.pages > TabItem">
          <Setter Property="FontSize" Value="16" />
          <Setter Property="MinHeight" Value="0" />
          <Setter Property="Padding" Value="2,0,2,2" />
          <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
      </TabControl.Styles>

      <!-- Room kept on the tab line for the transport standing at the end of it. Narrow the
           window and the tabs wrap; without this they wrap underneath the buttons and the two
           are drawn over each other. Only the strip is held back, so what the page has to draw
           in is untouched. -->
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel Margin="{Binding TabStripRoom}" />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <TabItem Header="RECORD">
        <views:RecordView DataContext="{Binding Record}" />
      </TabItem>

      <TabItem Header="PADS">
        <views:PadsView />
      </TabItem>

      <TabItem Header="FIRE">
        <views:UseView />
      </TabItem>

      <!-- The instruments and the mixer are pages of the tracker rather than tabs beside it:
           the mixer mixes its tracks and the rack is where a song takes its instruments from,
           and nothing outside the tracker uses either. -->
      <TabItem Header="TRACKER">
        <views:TrackerView DataContext="{Binding Tracker}"
                           Instruments="{Binding $parent[TabItem].DataContext.Machines}" />
      </TabItem>

      <!-- Where machines are built, as opposed to the rack in the tracker, which is what is
           installed. Switched on under Looks, since somebody firing jingles has no use for it. -->
      <TabItem Header="DESIGNER" IsVisible="{Binding ShowMachineEditor}">
        <views:MachineEditorView />
      </TabItem>

      <TabItem Header="SETTINGS">
        <views:SettingsView />
      </TabItem>

    </TabControl>

    </Grid>

  </DockPanel>
</Window>