<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JingleBox2.ViewModels"
        xmlns:views="clr-namespace:JingleBox2.Views"
        x:Class="JingleBox2.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="520" Height="920"
        MinWidth="520" MinHeight="520"
        Title="JingleBox2"
        Background="{DynamicResource BgBrush}">

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top"
          ColumnDefinitions="Auto,*"
          RowDefinitions="Auto,Auto"
          ColumnSpacing="12"
          RowSpacing="10">

      <!-- THEME FIRST -->
      <TextBlock Grid.Row="0" Grid.Column="0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="Theme:"/>

      <ComboBox Grid.Row="0" Grid.Column="1"
                HorizontalAlignment="Left"
                MinWidth="220"
                ItemsSource="{Binding ThemeNames}"
                SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

      <!-- OUTPUT DEVICE SECOND -->
      <TextBlock Grid.Row="1" Grid.Column="0"
                 VerticalAlignment="Center"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 Text="Output device:"/>

      <ComboBox Grid.Row="1" Grid.Column="1"
                HorizontalAlignment="Stretch"
                MinWidth="260"
                ItemsSource="{Binding OutputDevices}"
                SelectedItem="{Binding SelectedOutputDevice}"
                DisplayMemberBinding="{Binding Name}" />

    </Grid>

    <TabControl Margin="0,12,0,0">
      <TabItem Header="USE">
        <views:UseView/>
      </TabItem>

      <TabItem Header="CONFIG">
        <views:ConfigView/>
      </TabItem>
    </TabControl>

  </DockPanel>
</Window>
