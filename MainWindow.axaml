<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:vm="clr-namespace:JingleBox2.ViewModels"
  xmlns:views="clr-namespace:JingleBox2.Views"
  x:Class="JingleBox2.MainWindow"
  x:DataType="vm:MainViewModel"
  MinWidth="520" MinHeight="480"
  WindowStartupLocation="CenterScreen"
  Title="JingleBox2"
  Icon="/Assets/icon.ico"
  Background="{DynamicResource BgBrush}">

  <DockPanel Margin="16">

    <Grid DockPanel.Dock="Top"
      ColumnDefinitions="Auto,*"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="12"
      RowSpacing="10">

      <!-- THEME FIRST -->
      <TextBlock Grid.Row="0" Grid.Column="0"
        VerticalAlignment="Center"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="Theme:" />

      <ComboBox Grid.Row="0" Grid.Column="1"
        HorizontalAlignment="Left"
        MinWidth="220"
        ItemsSource="{Binding ThemeNames}"
        SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />

      <!-- OUTPUT DEVICE SECOND -->
      <TextBlock Grid.Row="1" Grid.Column="0"
        VerticalAlignment="Center"
        FontWeight="SemiBold"
        Foreground="{DynamicResource TextPrimaryBrush}"
        Text="Output device:" />

      <ComboBox Grid.Row="1" Grid.Column="1"
        HorizontalAlignment="Stretch"
        MinWidth="260"
        ItemsSource="{Binding OutputDevices}"
        SelectedItem="{Binding SelectedOutputDevice}"
        DisplayMemberBinding="{Binding Name}" />

    </Grid>

    <!-- One bar for the whole window. Where you are when nothing is happening, what just
         happened when something is, and the main input and output beside it. -->
    <views:StatusBar DockPanel.Dock="Bottom" Margin="0,10,0,0"
                     ShowLevels="True"
                     Text="{Binding StatusLine.Text}"
                     Kind="{Binding StatusLine.Kind}"
                     InputLevel="{Binding StatusLine.InputLevel}"
                     OutputLevel="{Binding StatusLine.OutputLevel}"
                     ToolTip.Tip="{Binding StatusLine.History}" />

    <TabControl Margin="0,12,0,0" SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="USE">
        <views:UseView />
      </TabItem>

      <TabItem Header="PADS">
        <views:PadsView />
      </TabItem>

      <TabItem Header="RECORD">
        <views:RecordView DataContext="{Binding Record}" />
      </TabItem>

      <!-- The instruments and the mixer are pages of the tracker rather than tabs beside it:
           the mixer mixes its tracks and the library exists so a song has something to play,
           and nothing outside the tracker uses either. -->
      <TabItem Header="TRACKER">
        <views:TrackerView DataContext="{Binding Tracker}"
                           Instruments="{Binding $parent[TabItem].DataContext.Instruments}" />
      </TabItem>

      <TabItem Header="SETTINGS">
        <views:SettingsView />
      </TabItem>

    </TabControl>

  </DockPanel>
</Window>